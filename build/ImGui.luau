-- FIXME-TABLE: This prevents us from using ImGuiListClipper _inside_ a table cell.
-- The problem we have is that without a Begin/End scheme for rows using the clipper is ambiguous.
local function GetSkipItemForListClipping()
    local g = GImGui
    if g.CurrentTable then return g.CurrentTable.HostSkipItems end
    return g.CurrentWindow.SkipItems
end


-- [Port] `offset` is a 0-based count of leading ranges to leave alone
local function ImGuiListClipper_SortAndFuseRanges(ranges, offset)
    if offset == nil then offset = 0 end
    if ranges.Size - offset <= 1 then return end
    local d = ranges.Data
    -- Helper to order ranges and fuse them together if possible (bubble sort is fine as we are only sorting 2-3 entries)
    for sort_end = ranges.Size - offset - 1, 1, -1 do
        for i = offset + 1, sort_end + offset do
            if d[i].Min > d[i + 1].Min then d[i], d[i + 1] = d[i + 1], d[i] end
        end
    end
    -- Now fuse ranges together as much as possible.
    local i = 2 + offset
    while i <= ranges.Size do
        assert(not d[i].PosToIndexConvert and not d[i - 1].PosToIndexConvert)
        if d[i - 1].Max < d[i].Min then
            i = i + 1
        else
            d[i - 1].Min = ImMin(d[i - 1].Min, d[i].Min)
            d[i - 1].Max = ImMax(d[i - 1].Max, d[i].Max)
            ranges:erase(i)
        end
    end
end

local function ImGuiListClipper_SeekCursorAndSetupPrevLine(clipper, pos_y, line_height)
    -- Set cursor position and a few other things so that SetScrollHereY() and Columns() can work when seeking cursor.
    -- FIXME: It is problematic that we have to do that here, because custom/equivalent end-user code would stumble on the same issue.
    -- The clipper should probably have a final step to display the last item in a regular manner, maybe with an opt-out flag for data sets which may have costly seek?
    local g = GImGui
    local window = g.CurrentWindow
    local off_y = pos_y - window.DC.CursorPos.y
    window.DC.CursorPos.y = pos_y
    window.DC.CursorMaxPos.y = ImMax(window.DC.CursorMaxPos.y, pos_y - g.Style.ItemSpacing.y)
    window.DC.CursorPosPrevLine.y = window.DC.CursorPos.y - line_height  -- Setting those fields so that SetScrollHereY() can properly function after the end of our clipper usage.
    window.DC.PrevLineSize.y = (line_height - g.Style.ItemSpacing.y)      -- If we end up needing more accurate data (to e.g. use SameLine) we may as well make the clipper have a fourth step to let user process and display the last item in their list.
    local columns = window.DC.CurrentColumns
    if columns then
        columns.LineMinY = window.DC.CursorPos.y -- Setting this so that cell Y position are set properly
    end
    local tbl = g.CurrentTable
    if tbl then
        if tbl.IsInsideRow then
            ImGui.TableEndRow(tbl)
        end
        local row_increase = math.floor((off_y / line_height) + 0.5)
        if row_increase > 0 and bit32.band(clipper.Flags, 1 --[[ImGuiListClipperFlags.NoSetTableRowCounters]]) == 0 then -- If your clipper item height is ~= from actual table row height, consider using ImGuiListClipperFlags.NoSetTableRowCounters. See #8886.
            tbl.CurrentRow = tbl.CurrentRow + row_increase
            tbl.RowBgColorCounter = tbl.RowBgColorCounter + row_increase
        end
        tbl.RowPosY2 = window.DC.CursorPos.y
    end
end

--- @class ImGuiListClipper
MT.ImGuiListClipper = {}
MT.ImGuiListClipper.__index = MT.ImGuiListClipper

function ImGuiListClipper()
    return setmetatable({ DisplayStart = 0, DisplayEnd = 0, UserIndex = 0, ItemsCount = 0, ItemsHeight = 0.0, Flags = 0,
        StartPosY = 0.0, StartSeekOffsetY = 0.0, Ctx = nil, TempData = nil }, MT.ImGuiListClipper)
end

--- @param items_count   int
--- @param items_height? float
function MT.ImGuiListClipper:Begin(items_count, items_height)
    if items_height == nil then items_height = -1.0 end
    self.Ctx = ImGui.GetCurrentContext()
    local g = self.Ctx
    local window = g.CurrentWindow

    local tbl = g.CurrentTable
    if tbl and tbl.IsInsideRow then
        ImGui.TableEndRow(tbl)
    end

    self.StartPosY = window.DC.CursorPos.y
    self.ItemsHeight = items_height
    self.ItemsCount = items_count
    self.DisplayStart = -1
    self.DisplayEnd = 0

    -- Acquire temporary buffer
    g.ClipperTempDataStacked = g.ClipperTempDataStacked + 1
    while g.ClipperTempDataStacked > g.ClipperTempData.Size do
        g.ClipperTempData:push_back(ImGuiListClipperData())
    end
    local data = g.ClipperTempData.Data[g.ClipperTempDataStacked]
    data:Reset(self)
    data.LossynessOffset = window.DC.CursorStartPosLossyness.y
    self.TempData = data
    self.StartSeekOffsetY = data.LossynessOffset
end

function MT.ImGuiListClipper:End()
    local data = self.TempData
    if data then
        -- In theory here we should assert that we are already at the right position, but it seems saner to just seek at the end and not assert/crash the user.
        local g = self.Ctx
        if self.ItemsCount >= 0 and self.ItemsCount < 2147483647 --[[INT_MAX]] and self.DisplayStart >= 0 then
            self:SeekCursorForItem(self.ItemsCount)
        end

        -- Restore temporary buffer and fix back pointers which may be invalidated when nesting
        assert(data.ListClipper == self)
        data.StepNo = data.Ranges.Size
        g.ClipperTempDataStacked = g.ClipperTempDataStacked - 1
        if g.ClipperTempDataStacked > 0 then
            data = g.ClipperTempData.Data[g.ClipperTempDataStacked]
            data.ListClipper.TempData = data
        end
        self.TempData = nil
    end
    self.DisplayStart = self.ItemsCount -- Clear this so code which may be reused past last Step() won't trip on a non-empty range.
    self.DisplayEnd = self.ItemsCount
    self.ItemsCount = -1
end

function MT.ImGuiListClipper:IncludeItemByIndex(item_index) self:IncludeItemsByIndex(item_index, item_index + 1) end

function MT.ImGuiListClipper:IncludeItemsByIndex(item_begin, item_end)
    local data = self.TempData
    assert(self.DisplayStart < 0) -- Only allowed after Begin() and if there has not been a specified range yet.
    assert(item_begin <= item_end)
    if item_begin < item_end then
        data.Ranges:push_back(MT.ImGuiListClipperRange.FromIndices(item_begin, item_end))
    end
end

-- This is already called while stepping.
-- The ONLY reason you may want to call this is if you passed INT_MAX to ImGuiListClipper:Begin() because you couldn't step item count beforehand.
function MT.ImGuiListClipper:SeekCursorForItem(item_n)
    -- - StartPosY starts from ItemsFrozen, by adding SeekOffsetY we generally cancel that out (SeekOffsetY == LossynessOffset - ItemsFrozen * ItemsHeight).
    -- - The reason we store SeekOffsetY instead of inferring it, is because we want to allow user to perform Seek after the last step, where ImGuiListClipperData is already done.
    local pos_y = self.StartPosY + self.StartSeekOffsetY + item_n * self.ItemsHeight
    ImGuiListClipper_SeekCursorAndSetupPrevLine(self, pos_y, self.ItemsHeight)
end

local function ImGuiListClipper_StepInternal(clipper)
    local g = clipper.Ctx
    local window = g.CurrentWindow
    local data = clipper.TempData
    assert(data ~= nil, "Called ImGuiListClipper::Step() too many times, or before ImGuiListClipper::Begin() ?")

    local tbl = g.CurrentTable
    if tbl and tbl.IsInsideRow then
        ImGui.TableEndRow(tbl)
    end

    -- No items
    if clipper.ItemsCount == 0 or GetSkipItemForListClipping() then
        return false
    end

    -- While we are in frozen row state, keep displaying items one by one, unclipped
    -- FIXME: Could be stored as a table-agnostic state.
    if data.StepNo == 0 and tbl ~= nil and not tbl.IsUnfrozenRows then
        clipper.DisplayStart = data.ItemsFrozen
        clipper.DisplayEnd = ImMin(data.ItemsFrozen + 1, clipper.ItemsCount)
        if clipper.DisplayStart < clipper.DisplayEnd then
            data.ItemsFrozen = data.ItemsFrozen + 1
        end
        return true
    end

    -- Step 0: Let you process the first element (regardless of it being visible or not, so we can measure the element height)
    local calc_clipping = false
    if data.StepNo == 0 then
        clipper.StartPosY = window.DC.CursorPos.y
        if clipper.ItemsHeight <= 0.0 then
            -- Submit the first item (or range) so we can measure its height (generally the first range is 0..1)
            data.Ranges:push_front(MT.ImGuiListClipperRange.FromIndices(data.ItemsFrozen, data.ItemsFrozen + 1))
            clipper.DisplayStart = ImMax(data.Ranges.Data[1].Min, data.ItemsFrozen)
            clipper.DisplayEnd = ImMin(data.Ranges.Data[1].Max, clipper.ItemsCount)
            data.StepNo = 1
            return true
        end
        calc_clipping = true -- If on the first step with known item height, calculate clipping.
    end

    -- Step 1: Let the clipper infer height from first range
    if clipper.ItemsHeight <= 0.0 then
        assert(data.StepNo == 1)
        -- [Port] (no float precision mitigation needed: Luau numbers are doubles)
        clipper.ItemsHeight = (window.DC.CursorPos.y - clipper.StartPosY) / (clipper.DisplayEnd - clipper.DisplayStart)
        if clipper.ItemsHeight == 0.0 and clipper.ItemsCount == 2147483647 --[[INT_MAX]] then -- Accept that no item have been submitted if in indeterminate mode.
            return false
        end
        if clipper.ItemsHeight <= 0.0 then
            IM_ASSERT_USER_ERROR(clipper.ItemsHeight > 0.0, "ImGuiListClipper: Failed to calculate item height! First item hasn't been submitted by user code, or has not moved the cursor vertically!")
            return false
        end
        calc_clipping = true -- If item height had to be calculated, calculate clipping afterwards.
    end

    -- Step 0 or 1: Calculate the actual ranges of visible elements.
    local already_submitted = clipper.DisplayEnd
    if calc_clipping then
        -- Record seek offset, this is so ImGuiListClipper:Seek() can be called after ImGuiListClipperData is done
        clipper.StartSeekOffsetY = data.LossynessOffset - data.ItemsFrozen * clipper.ItemsHeight

        if g.LogEnabled then
            -- If logging is active, do not perform any clipping
            data.Ranges:push_back(MT.ImGuiListClipperRange.FromIndices(0, clipper.ItemsCount))
        else
            -- Add range selected to be included for navigation
            local is_nav_request = (g.NavMoveScoringItems and g.NavWindow and g.NavWindow.RootWindowForNav == window.RootWindowForNav) and true or false
            local nav_off_min = (is_nav_request and g.NavMoveClipDir == 2 --[[ImGuiDir.Up]]) and -1 or 0
            local nav_off_max = (is_nav_request and g.NavMoveClipDir == 3 --[[ImGuiDir.Down]]) and 1 or 0
            if is_nav_request then
                data.Ranges:push_back(MT.ImGuiListClipperRange.FromPositions(g.NavScoringRect.Min.y, g.NavScoringRect.Max.y, nav_off_min, nav_off_max))
                if not g.NavScoringNoClipRect:IsInverted() then
                    data.Ranges:push_back(MT.ImGuiListClipperRange.FromPositions(g.NavScoringNoClipRect.Min.y, g.NavScoringNoClipRect.Max.y, nav_off_min, nav_off_max))
                end
            end
            if is_nav_request and bit32.band(g.NavMoveFlags, 1024 --[[ImGuiNavMoveFlags.IsTabbing]]) ~= 0 and g.NavTabbingDir == -1 then
                data.Ranges:push_back(MT.ImGuiListClipperRange.FromIndices(clipper.ItemsCount - 1, clipper.ItemsCount))
            end

            -- Add focused/active item
            local nav_rect_abs = ImGui.WindowRectRelToAbs(window, window.NavRectRel[0])
            if g.NavId ~= 0 and window.NavLastIds[0] == g.NavId then
                data.Ranges:push_back(MT.ImGuiListClipperRange.FromPositions(nav_rect_abs.Min.y, nav_rect_abs.Max.y, 0, 0))
            end

            local min_y = window.ClipRect.Min.y
            local max_y = window.ClipRect.Max.y

            -- Add box selection range
            local bs = g.BoxSelectState
            if bs.IsActive and bs.Window == window then
                -- FIXME: Selectable() use of half-ItemSpacing isn't consistent in matter of layout, as ItemAdd(bb) stray above ItemSize()'s CursorPos.
                -- RangeSelect's BoxSelect relies on comparing overlap of previous and current rectangle and is sensitive to that.
                -- As a workaround we currently half ItemSpacing worth on each side.
                local pad_y = g.Style.ItemSpacing.y
                min_y = min_y - pad_y
                max_y = max_y + pad_y

                -- Box-select on 2D area requires different clipping.
                -- (best adding pad_y here than in BeginBoxSelect() as we are closer to current state)
                if bs.UnclipMode then
                    data.Ranges:push_back(MT.ImGuiListClipperRange.FromPositions(bs.UnclipRect.Min.y - pad_y, bs.UnclipRect.Max.y + pad_y, 0, 0))
                end
            end

            -- Add main visible range
            data.Ranges:push_back(MT.ImGuiListClipperRange.FromPositions(min_y, max_y, nav_off_min, nav_off_max))
        end

        -- Convert position ranges to item index ranges
        -- - Very important: when a starting position is after our maximum item, we set Min to (ItemsCount - 1). This allows us to handle most forms of wrapping.
        -- - Due to how Selectable extra padding they tend to be "unaligned" with exact unit in the item list,
        --   which with the flooring/ceiling tend to lead to 2 items instead of one being submitted.
        for _, range in data.Ranges:iter() do
            if range.PosToIndexConvert then
                local m1 = ImTrunc((range.Min - window.DC.CursorPos.y - data.LossynessOffset) / clipper.ItemsHeight)
                local m2 = ImTrunc(((range.Max - window.DC.CursorPos.y - data.LossynessOffset) / clipper.ItemsHeight) + 0.999999)
                range.Min = ImClamp(already_submitted + m1 + range.PosToIndexOffsetMin, already_submitted, clipper.ItemsCount - 1)
                range.Max = ImClamp(already_submitted + m2 + range.PosToIndexOffsetMax, range.Min + 1, clipper.ItemsCount)
                range.PosToIndexConvert = false
            end
        end
        ImGuiListClipper_SortAndFuseRanges(data.Ranges, data.StepNo)
    end

    -- Step 0+ (if item height is given in advance) or 1+: Display the next range in line.
    while data.StepNo < data.Ranges.Size do
        local r = data.Ranges.Data[data.StepNo + 1]
        clipper.DisplayStart = ImMax(r.Min, already_submitted)
        clipper.DisplayEnd = ImMin(r.Max, clipper.ItemsCount)
        data.StepNo = data.StepNo + 1
        if clipper.DisplayStart < clipper.DisplayEnd then
            if clipper.DisplayStart > already_submitted then
                clipper:SeekCursorForItem(clipper.DisplayStart)
            end
            return true
        end
    end

    -- After the last step: Let the clipper validate that we have reached the expected Y position (corresponding to element DisplayEnd),
    -- Advance the cursor to the end of the list and then returns 'false' to end the loop.
    if clipper.ItemsCount < 2147483647 --[[INT_MAX]] then
        clipper:SeekCursorForItem(clipper.ItemsCount)
    end
    return false
end

function MT.ImGuiListClipper:Step()
    local ret = ImGuiListClipper_StepInternal(self)
    if ret and (self.DisplayStart >= self.DisplayEnd) then
        ret = false
    end
    if not ret then
        self:End()
    end
    return ret
end

-------------------------------------------------------------------------------
-- [SECTION] ERROR CHECKING, STATE RECOVERY
-------------------------------------------------------------------------------
-- - ErrorRecoveryStoreState()
-- - ErrorRecoveryTryToRecoverState()
-- - ErrorRecoveryTryToRecoverWindowState()
-- - ErrorLog()
-------------------------------------------------------------------------------

function ImGuiErrorRecoveryState()
    return { SizeOfWindowStack = 0, SizeOfIDStack = 0, SizeOfTreeStack = 0, SizeOfColorStack = 0, SizeOfStyleVarStack = 0,
             SizeOfFontStack = 0, SizeOfFocusScopeStack = 0, SizeOfGroupStack = 0, SizeOfItemFlagsStack = 0,
             SizeOfBeginPopupStack = 0, SizeOfDisabledStack = 0 }
end

function ImGui.ErrorCheckNewFrameSanityChecks()
    local g = GImGui

    -- [Luau] C++-only check of the user's IM_ASSERT macro definition dropped.

    -- Check user data
    -- (We pass an error message in the assert expression to make it visible to programmers who are not using a debugger, as most assert handlers display their argument)
    assert(g.Initialized)
    assert(g.IO.DeltaTime > 0.0 or g.FrameCount == 0, "Need a positive DeltaTime!")
    assert(g.FrameCount == 0 or g.FrameCountEnded == g.FrameCount, "Forgot to call Render() or EndFrame() at the end of the previous frame?")
    assert(g.IO.DisplaySize.x >= 0.0 and g.IO.DisplaySize.y >= 0.0, "Invalid DisplaySize value!")
    assert(g.Style.CurveTessellationMaxError > 0.0, "Invalid style setting!")
    assert(g.Style.CircleTessellationMaxError > 0.0, "Invalid style setting!")
    assert(g.Style.Alpha >= 0.0 and g.Style.Alpha <= 1.0, "Invalid style setting!") -- Allows us to avoid a few clamps in color computations
    assert(g.Style.WindowMinSize.x >= 1.0 and g.Style.WindowMinSize.y >= 1.0, "Invalid style setting!")
    assert(g.Style.WindowBorderHoverPadding > 0.0, "Invalid style setting!") -- Required otherwise cannot resize from borders.
    assert(g.Style.WindowMenuButtonPosition == (-1) --[[ImGuiDir.None]] or g.Style.WindowMenuButtonPosition == 0 --[[ImGuiDir.Left]] or g.Style.WindowMenuButtonPosition == 1 --[[ImGuiDir.Right]])
    assert(g.Style.ColorButtonPosition == 0 --[[ImGuiDir.Left]] or g.Style.ColorButtonPosition == 1 --[[ImGuiDir.Right]])
    assert(ImIsPowerOfTwo(bit32.band(g.IO.ConfigColorEditFlags, 7340032 --[[ImGuiColorEditFlags.DisplayMask_]]))) -- Check only 1 option is selected
    assert(ImIsPowerOfTwo(bit32.band(g.IO.ConfigColorEditFlags, 25165824 --[[ImGuiColorEditFlags.DataTypeMask_]]))) -- "
    assert(ImIsPowerOfTwo(bit32.band(g.IO.ConfigColorEditFlags, 100663296 --[[ImGuiColorEditFlags.PickerMask_]]))) -- "
    assert(ImIsPowerOfTwo(bit32.band(g.IO.ConfigColorEditFlags, 805306368 --[[ImGuiColorEditFlags.InputMask_]]))) -- "

    assert(g.Style.TreeLinesFlags == 262144 --[[ImGuiTreeNodeFlags.DrawLinesNone]] or g.Style.TreeLinesFlags == 524288 --[[ImGuiTreeNodeFlags.DrawLinesFull]] or g.Style.TreeLinesFlags == 1048576 --[[ImGuiTreeNodeFlags.DrawLinesToNodes]])
    assert(g.IO.MouseSingleClickDelay > g.IO.MouseDoubleClickTime)

    -- Error handling: we do not accept 100% silent recovery! Please contact me if you feel this is getting in your way.
    if g.IO.ConfigErrorRecovery then
        assert(g.IO.ConfigErrorRecoveryEnableAssert or g.IO.ConfigErrorRecoveryEnableDebugLog or g.IO.ConfigErrorRecoveryEnableTooltip or g.ErrorCallback ~= nil)
    end

    -- [Luau] Obsolete io.FontGlobalScale, ImGuiConfigFlags_NavEnableSetMousePos/NavNoCaptureKeyboard/DpiEnableScaleXXX and
    -- io.Get/SetClipboardTextFn don't exist in this port: their remaps are dropped.

    -- Remap legacy CurveTessellationTol into CurveTessellationMaxError (OBSOLETED in 1.93.0, August 2026)
    if g.Style.CurveTessellationTol ~= 0.0 then
        g.Style.CurveTessellationMaxError = ImSqrt(g.Style.CurveTessellationTol)
    end
    g.Style.CurveTessellationTol = 0.0

    -- Perform simple check: error if Docking or Viewport are enabled _exactly_ on frame 1 (instead of frame 0 or later), which is a common error leading to loss of .ini data.
    if g.FrameCount == 1 and bit32.band(g.IO.ConfigFlags, 128 --[[ImGuiConfigFlags.DockingEnable]]) ~= 0 and bit32.band(g.ConfigFlagsLastFrame, 128 --[[ImGuiConfigFlags.DockingEnable]]) == 0 then
        assert(false, "Please set DockingEnable before the first call to NewFrame()! Otherwise you will lose your .ini settings!")
    end
    if g.FrameCount == 1 and bit32.band(g.IO.ConfigFlags, 1024 --[[ImGuiConfigFlags.ViewportsEnable]]) ~= 0 and bit32.band(g.ConfigFlagsLastFrame, 1024 --[[ImGuiConfigFlags.ViewportsEnable]]) == 0 then
        assert(false, "Please set ViewportsEnable before the first call to NewFrame()! Otherwise you will lose your .ini settings!")
    end

    -- Perform simple checks: multi-viewport and platform windows support
    if bit32.band(g.IO.ConfigFlags, 1024 --[[ImGuiConfigFlags.ViewportsEnable]]) ~= 0 then
        if bit32.band(g.IO.BackendFlags, 2048 --[[ImGuiBackendFlags.PlatformHasViewports]]) ~= 0 and bit32.band(g.IO.BackendFlags, 1024 --[[ImGuiBackendFlags.RendererHasViewports]]) ~= 0 then
            local pio = g.PlatformIO
            assert(g.FrameCount == 0 or g.FrameCount == g.FrameCountPlatformEnded, "Forgot to call UpdatePlatformWindows() in main loop after EndFrame()? Check examples/ applications for reference.")
            assert(pio.Platform_CreateWindow  ~= nil, "Platform init didn't install handlers?")
            assert(pio.Platform_DestroyWindow ~= nil, "Platform init didn't install handlers?")
            assert(pio.Platform_GetWindowPos  ~= nil, "Platform init didn't install handlers?")
            assert(pio.Platform_SetWindowPos  ~= nil, "Platform init didn't install handlers?")
            assert(pio.Platform_GetWindowSize ~= nil, "Platform init didn't install handlers?")
            assert(pio.Platform_SetWindowSize ~= nil, "Platform init didn't install handlers?")
            assert(pio.Monitors.Size > 0, "Platform init didn't setup Monitors list?")
            assert(g.Viewports.Data[1].PlatformUserData ~= nil or g.Viewports.Data[1].PlatformHandle ~= nil, "Platform init didn't setup main viewport.")
            if g.IO.ConfigDockingTransparentPayload and bit32.band(g.IO.ConfigFlags, 128 --[[ImGuiConfigFlags.DockingEnable]]) ~= 0 then
                assert(pio.Platform_SetWindowAlpha ~= nil, "Platform_SetWindowAlpha handler is required to use io.ConfigDockingTransparent!")
            end
        else
            -- Disable feature, our backends do not support it
            g.IO.ConfigFlags = bit32.band(g.IO.ConfigFlags, bit32.bnot(1024 --[[ImGuiConfigFlags.ViewportsEnable]]))
        end

        -- Perform simple checks on platform monitor data + compute a total bounding box for quick early outs
        for _, mon in g.PlatformIO.Monitors:iter() do
            assert(mon.MainSize.x > 0.0 and mon.MainSize.y > 0.0, "Monitor main bounds not setup properly.")
            assert(ImRect(mon.MainPos, mon.MainPos + mon.MainSize):Contains(ImRect(mon.WorkPos, mon.WorkPos + mon.WorkSize)), "Monitor work bounds not setup properly. If you don't have work area information, just copy MainPos/MainSize into them.")
            assert(mon.DpiScale > 0.0 and mon.DpiScale < 99.0, "Monitor DpiScale is invalid.") -- Typical correct values would be between 1.0f and 4.0f
        end
    end
end

function ImGui.ErrorCheckEndFrameSanityChecks()
    -- Verify that io.KeyXXX fields haven't been tampered with. Key mods should not be modified between NewFrame() and EndFrame()
    -- One possible reason leading to this assert is that your backends update inputs _AFTER_ NewFrame().
    -- It is known that when some modal native windows called mid-frame takes focus away, some backends such as GLFW will
    -- send key release events mid-frame. This would normally trigger this assertion and lead to sheared inputs.
    -- We silently accommodate for this case by ignoring the case where all io.KeyXXX modifiers were released (aka key_mod_flags == 0),
    -- while still correctly asserting on mid-frame key press events.
    local g = GImGui
    local key_mods = ImGui.GetMergedModsFromKeys()
    assert(key_mods == 0 or g.IO.KeyMods == key_mods, "Mismatching io.KeyCtrl/io.KeyShift/io.KeyAlt/io.KeySuper vs io.KeyMods")

    assert(g.CurrentWindowStack.Size == 1)
    assert(g.CurrentWindowStack.Data[1].Window.IsFallbackWindow)
end

-- Save current stack sizes. Called e.g. by NewFrame() and by Begin() but may be called for manual recovery.
function ImGui.ErrorRecoveryStoreState(state_out)
    local g = GImGui
    state_out.SizeOfWindowStack = g.CurrentWindowStack.Size
    state_out.SizeOfIDStack = g.CurrentWindow.IDStack.Size
    state_out.SizeOfTreeStack = g.CurrentWindow.DC.TreeDepth -- NOT g.TreeNodeStack.Size which is a partial stack!
    state_out.SizeOfColorStack = g.ColorStack.Size
    state_out.SizeOfStyleVarStack = g.StyleVarStack.Size
    state_out.SizeOfFontStack = g.FontStack.Size
    state_out.SizeOfFocusScopeStack = g.FocusScopeStack.Size
    state_out.SizeOfGroupStack = g.GroupStack.Size
    state_out.SizeOfItemFlagsStack = g.ItemFlagsStack.Size
    state_out.SizeOfBeginPopupStack = g.BeginPopupStack.Size
    state_out.SizeOfDisabledStack = g.DisabledStackSize
end

-- Chosen name "Try to recover" over e.g. "Restore" to suggest this is not a 100% guaranteed recovery.
-- Called by e.g. EndFrame() but may be called for manual recovery.
-- Attempt to recover full window stack.
function ImGui.ErrorRecoveryTryToRecoverState(state_in)
    local g = GImGui
    while g.CurrentWindowStack.Size > state_in.SizeOfWindowStack do
        -- Recap:
        -- - Begin()/BeginChild() return false to indicate the window is collapsed or fully clipped.
        -- - Always call a matching End() for each Begin() call, regardless of its return value!
        -- - Begin/End and BeginChild/EndChild logic is KNOWN TO BE INCONSISTENT WITH ALL OTHER BEGIN/END FUNCTIONS.
        -- - We will fix that in a future major update.
        local window = g.CurrentWindow
        if bit32.band(window.Flags, 16777216 --[[ImGuiWindowFlags.ChildWindow]]) ~= 0 then
            if g.CurrentTable ~= nil and g.CurrentTable.InnerWindow == g.CurrentWindow then
                IM_ASSERT_USER_ERROR(false, "Missing EndTable()")
                ImGui.EndTable()
            else
                IM_ASSERT_USER_ERROR(false, "Missing EndChild()")
                ImGui.EndChild()
            end
        else
            IM_ASSERT_USER_ERROR(false, "Missing End()")
            ImGui.End()
        end
    end
    if g.CurrentWindowStack.Size == state_in.SizeOfWindowStack then
        ImGui.ErrorRecoveryTryToRecoverWindowState(state_in)
    end
end

-- Called by e.g. End() but may be called for manual recovery.
-- Attempt to recover from incorrect usage of BeginXXX/EndXXX/PushXXX/PopXXX calls.
function ImGui.ErrorRecoveryTryToRecoverWindowState(state_in)
    local g = GImGui

    while g.CurrentTable ~= nil and g.CurrentTable.InnerWindow == g.CurrentWindow do
        IM_ASSERT_USER_ERROR(false, "Missing EndTable()")
        ImGui.EndTable()
    end

    local window = g.CurrentWindow

    -- FIXME: Can't recover from inside BeginTabItem/EndTabItem yet.
    while g.CurrentTabBar ~= nil and g.CurrentTabBar.Window == window do
        IM_ASSERT_USER_ERROR(false, "Missing EndTabBar()")
        ImGui.EndTabBar()
    end
    while g.CurrentMultiSelect ~= nil and g.CurrentMultiSelect.Storage.Window == window do --V1044
        IM_ASSERT_USER_ERROR(false, "Missing EndMultiSelect()")
        ImGui.EndMultiSelect()
    end
    if window.DC.MenuBarAppending then
        IM_ASSERT_USER_ERROR(false, "Missing EndMenuBar()")
        ImGui.EndMenuBar()
    end
    while window.DC.TreeDepth > state_in.SizeOfTreeStack do
        IM_ASSERT_USER_ERROR(false, "Missing TreePop()")
        ImGui.TreePop()
    end
    while g.GroupStack.Size > state_in.SizeOfGroupStack do
        IM_ASSERT_USER_ERROR(false, "Missing EndGroup()")
        ImGui.EndGroup()
    end
    assert(g.GroupStack.Size == state_in.SizeOfGroupStack)
    while window.IDStack.Size > state_in.SizeOfIDStack do
        IM_ASSERT_USER_ERROR(false, "Missing PopID()")
        ImGui.PopID()
    end
    while g.DisabledStackSize > state_in.SizeOfDisabledStack do
        IM_ASSERT_USER_ERROR(false, "Missing EndDisabled()")
        if bit32.band(g.CurrentItemFlags, 64 --[[ImGuiItemFlags.Disabled]]) ~= 0 then
            ImGui.EndDisabled()
        else
            ImGui.EndDisabledOverrideReenable()
            g.CurrentWindowStack:back().DisabledOverrideReenable = false
        end
    end
    assert(g.DisabledStackSize == state_in.SizeOfDisabledStack)
    while g.ColorStack.Size > state_in.SizeOfColorStack do
        IM_ASSERT_USER_ERROR(false, "Missing PopStyleColor()")
        ImGui.PopStyleColor()
    end
    while g.ItemFlagsStack.Size > state_in.SizeOfItemFlagsStack do
        IM_ASSERT_USER_ERROR(false, "Missing PopItemFlag()")
        ImGui.PopItemFlag()
    end
    while g.StyleVarStack.Size > state_in.SizeOfStyleVarStack do
        IM_ASSERT_USER_ERROR(false, "Missing PopStyleVar()")
        ImGui.PopStyleVar()
    end
    while g.FontStack.Size > state_in.SizeOfFontStack do
        IM_ASSERT_USER_ERROR(false, "Missing PopFont()")
        ImGui.PopFont()
    end
    while g.FocusScopeStack.Size > state_in.SizeOfFocusScopeStack do
        IM_ASSERT_USER_ERROR(false, "Missing PopFocusScope()")
        ImGui.PopFocusScope()
    end
    -- IM_ASSERT(g.FocusScopeStack.Size == state_in.SizeOfFocusScopeStack)
end

-- [Port] Lines are stored in g.DebugLogBuf (one chunk per call)
function ImGui.DebugLog(fmt, ...)
    ImGui.DebugLogV(fmt, ...)
end

-- [Luau] va_list -> varargs (same convention as TextV()). Without arguments `fmt` is used verbatim.
function ImGui.DebugLogV(fmt, ...)
    local g = GImGui
    local prefix
    if g.ContextName ~= nil and g.ContextName ~= "" then
        prefix = string.format("[%s] [%05d] ", g.ContextName, g.FrameCount)
    else
        prefix = string.format("[%05d] ", g.FrameCount)
    end
    local str = prefix .. ((select("#", ...) > 0) and string.format(fmt, ...) or fmt)
    g.DebugLogBuf:append(str)
    -- [Port] Line index (upstream: g.DebugLogIndex). Lines are complete strings without '\n'.
    local lines = g.DebugLogLines
    for part, nl in string.gmatch(str, "([^\n]*)(\n?)") do
        lines[#lines] = lines[#lines] .. part
        if nl ~= "" then lines[#lines + 1] = "" end
        if part == "" and nl == "" then break end
    end
    if bit32.band(g.DebugLogFlags, 1048576 --[[ImGuiDebugLogFlags.OutputToTTY]]) ~= 0 then
        print((string.gsub(str, "\n$", "")))
    end
end

--- @return bool should_assert
function ImGui.ErrorLog(msg)
    local g = GImGui
    if g == nil then return true end
    -- Output to debug log
    local window = g.CurrentWindow

    if g.IO.ConfigErrorRecoveryEnableDebugLog then
        if g.ErrorFirst then
            ImGui.DebugLog(string.format("[imgui-error] (current settings: Assert=%d, Log=%d, Tooltip=%d)\n",
                g.IO.ConfigErrorRecoveryEnableAssert and 1 or 0, g.IO.ConfigErrorRecoveryEnableDebugLog and 1 or 0, g.IO.ConfigErrorRecoveryEnableTooltip and 1 or 0))
        end
        ImGui.DebugLog(string.format("[imgui-error] In window '%s': %s\n", window and window.Name or "NULL", tostring(msg)))
    end
    g.ErrorFirst = false

    -- Output to tooltip
    if g.IO.ConfigErrorRecoveryEnableTooltip then
        if g.WithinFrameScope and ImGui.BeginErrorTooltip() then
            if g.ErrorCountCurrentFrame < 20 then
                ImGui.Text("In window '%s': %s", window and window.Name or "NULL", tostring(msg))
                if window and (not window.IsFallbackWindow or window.WasActive) then
                    ImGui.GetForegroundDrawList(window.Viewport):AddRect(window.Pos, window.Pos + window.Size, IM_COL32(255, 0, 0, 255))
                end
            end
            if g.ErrorCountCurrentFrame == 20 then
                ImGui.Text("(and more errors)")
            end
            -- EndFrame() will amend debug buttons to this window, after all errors have been submitted.
            ImGui.EndErrorTooltip()
        end
        g.ErrorCountCurrentFrame = g.ErrorCountCurrentFrame + 1
    end

    -- Output to callback
    if g.ErrorCallback ~= nil then
        g.ErrorCallback(g, g.ErrorCallbackUserData, msg)
    end

    -- Return whether we should assert
    return g.IO.ConfigErrorRecoveryEnableAssert
end

-- Display an error tooltip when same ID as HoveredId was submitted multiple times.
-- See code in ItemHoverable() for an explanation of why we associate this error to HoveredId + code drawing of rectangles over individual items instances.
function ImGui.ErrorCheckEndFrameFinalizeErrorTooltip()
    local g = GImGui
    if g.DebugDrawIdConflictsId ~= 0 and g.IO.KeyCtrl == false then
        g.DebugDrawIdConflictsCount = g.HoveredIdPreviousFrameItemCount
    end
    if g.DebugDrawIdConflictsId ~= 0 and not g.DebugItemPickerActive and ImGui.BeginErrorTooltip() then
        ImGui.Text("Programmer error: %d visible items with conflicting ID!", g.DebugDrawIdConflictsCount)
        ImGui.BulletText("Code should use PushID()/PopID() in loops, or append \"##xx\" to same-label identifiers!")
        ImGui.BulletText("Empty label e.g. Button(\"\") == same ID as parent widget/node. Use Button(\"##xx\") instead!")
        -- ImGui.BulletText("Code intending to use duplicate ID may use e.g. PushItemFlag(ImGuiItemFlags.AllowDuplicateId, true); ... PopItemFlag()") -- Not making this too visible for fear of it being abused.
        ImGui.BulletText("Set io.ConfigDebugHighlightIdConflicts=false to disable this warning in non-programmers builds.")
        ImGui.Separator()
        if g.IO.ConfigDebugHighlightIdConflictsShowItemPicker then
            ImGui.Text("(Hold Ctrl to: use ")
