    local _, is_visible = ImGui.Begin("##Tooltip_Error", nil, bit32.bor(33554432 --[[ImGuiWindowFlags.Tooltip]], 43 --[[ImGuiWindowFlags.NoDecoration]], 4 --[[ImGuiWindowFlags.NoMove]], 2 --[[ImGuiWindowFlags.NoResize]], 256 --[[ImGuiWindowFlags.NoSavedSettings]], 64 --[[ImGuiWindowFlags.AlwaysAutoResize]]))
