S.DemoWindowInputs.mouse_cursors_names = { "Arrow", "TextInput", "ResizeAll", "ResizeNS", "ResizeEW", "ResizeNESW", "ResizeNWSE", "Hand", "Wait", "Progress", "NotAllowed" }
function DemoWindowInputs()
    local s = S.DemoWindowInputs
    if ImGui.CollapsingHeader("Inputs & Focus") then
        local io = ImGui.GetIO()

        -- Display inputs submitted to ImGuiIO
        ImGui.SetNextItemOpen(true, 2 --[[ImGuiCond.Once]])
        local inputs_opened = ImGui.TreeNode("Inputs")
        ImGui.SameLine()
        HelpMarker(
            "This is a simplified view. See more detailed input state:\n" ..
            "- in 'Tools->Metrics/Debugger->Inputs'.\n" ..
            "- in 'Tools->Debug Log->IO'.")
        if inputs_opened then
            IMGUI_DEMO_MARKER("Inputs & Focus/Inputs")
            if ImGui.IsMousePosValid() then
                ImGui.Text("Mouse pos: (%g, %g)", io.MousePos.x, io.MousePos.y)
            else
                ImGui.Text("Mouse pos: <INVALID>")
            end
            ImGui.Text("Mouse delta: (%g, %g)", io.MouseDelta.x, io.MouseDelta.y)
            ImGui.Text("Mouse down:")
            for i = 0, 5 --[[ImGuiMouseButton.COUNT]] - 1 do if ImGui.IsMouseDown(i) then ImGui.SameLine(); ImGui.Text("b%d (%.02f secs)", i, io.MouseDownDuration[i]) end end -- [Port] IM_COUNTOF(io.MouseDown), 0-based
            ImGui.Text("Mouse wheel: %.1f", io.MouseWheel)
            ImGui.Text("Mouse clicked count:")
            for i = 0, 5 --[[ImGuiMouseButton.COUNT]] - 1 do if io.MouseClickedCount[i] > 0 then ImGui.SameLine(); ImGui.Text("b%d: %d", i, io.MouseClickedCount[i]) end end

            -- We iterate both legacy native range and named ImGuiKey ranges. This is a little unusual/odd but this allows
            -- displaying the data for old/new backends.
            -- User code should never have to go through such hoops!
            -- You can generally iterate between ImGuiKey.NamedKey_BEGIN and ImGuiKey.NamedKey_END.
            local funcs = s.funcs
            local start_key = 512 --[[ImGuiKey.NamedKey_BEGIN]]
            ImGui.Text("Keys down:")         for key = start_key, 667 --[[ImGuiKey.NamedKey_END]] - 1 do repeat if funcs.IsLegacyNativeDupe(key) or not ImGui.IsKeyDown(key) then break end ImGui.SameLine(); if key < 512 --[[ImGuiKey.NamedKey_BEGIN]] then ImGui.Text("\"%s\"", ImGui.GetKeyName(key)) else ImGui.Text("\"%s\" %d", ImGui.GetKeyName(key), key) end until true end
            ImGui.Text("Keys mods: %s%s%s%s", io.KeyCtrl and "CTRL " or "", io.KeyShift and "SHIFT " or "", io.KeyAlt and "ALT " or "", io.KeySuper and "SUPER " or "")
            ImGui.Text("Chars queue:")       for i = 0, io.InputQueueCharacters.Size - 1 do local c = io.InputQueueCharacters.Data[i + 1]; ImGui.SameLine();  ImGui.Text("\'%s\' (0x%04X)", (c > 32 and c <= 255) and string.char(c) or '?', c) end -- FIXME: We should convert 'c' to UTF-8 here but the functions are not public.

            ImGui.TreePop()
        end

        -- Display ImGuiIO output flags
        ImGui.SetNextItemOpen(true, 2 --[[ImGuiCond.Once]])
        local outputs_opened = ImGui.TreeNode("Outputs")
        ImGui.SameLine()
        HelpMarker(
            "The value of io.WantCaptureMouse and io.WantCaptureKeyboard are normally set by Dear ImGui " ..
            "to instruct your application of how to route inputs. Typically, when a value is true, it means " ..
            "Dear ImGui wants the corresponding inputs and we expect the underlying application to ignore them.\n\n" ..
            "The most typical case is: when hovering a window, Dear ImGui set io.WantCaptureMouse to true, " ..
            "and underlying application should ignore mouse inputs (in practice there are many and more subtle " ..
            "rules leading to how those flags are set).")
        if outputs_opened then
            IMGUI_DEMO_MARKER("Inputs & Focus/Outputs")
            ImGui.Text("io.WantCaptureMouse: %d", io.WantCaptureMouse and 1 or 0)
            ImGui.Text("io.WantCaptureMouseUnlessPopupClose: %d", io.WantCaptureMouseUnlessPopupClose and 1 or 0)
            ImGui.Text("io.WantCaptureKeyboard: %d", io.WantCaptureKeyboard and 1 or 0)
            ImGui.Text("io.WantTextInput: %d", io.WantTextInput and 1 or 0)
            ImGui.Text("io.WantSetMousePos: %d", io.WantSetMousePos and 1 or 0)
            ImGui.Text("io.NavActive: %d, io.NavVisible: %d", io.NavActive and 1 or 0, io.NavVisible and 1 or 0)

            IMGUI_DEMO_MARKER("Inputs & Focus/Outputs/WantCapture override")
            if ImGui.TreeNode("WantCapture override") then
                HelpMarker(
                    "Hovering the colored canvas will override io.WantCaptureXXX fields.\n" ..
                    "Notice how normally (when set to none), the value of io.WantCaptureKeyboard would be false when hovering " ..
                    "and true when clicking.")
                local capture_override_desc = { "None", "Set to false", "Set to true" }
                ImGui.SetNextItemWidth(ImGui.GetFontSize() * 15)
                s.capture_override_mouse = ImGui.SliderInt("SetNextFrameWantCaptureMouse() on hover", s.capture_override_mouse, -1, 1, capture_override_desc[s.capture_override_mouse + 2], 1536 --[[ImGuiSliderFlags.AlwaysClamp]])
                ImGui.SetNextItemWidth(ImGui.GetFontSize() * 15)
                s.capture_override_keyboard = ImGui.SliderInt("SetNextFrameWantCaptureKeyboard() on hover", s.capture_override_keyboard, -1, 1, capture_override_desc[s.capture_override_keyboard + 2], 1536 --[[ImGuiSliderFlags.AlwaysClamp]])

                ImGui.ColorButton("##panel", ImVec4(0.7, 0.1, 0.7, 1.0), bit32.bor(64 --[[ImGuiColorEditFlags.NoTooltip]], 512 --[[ImGuiColorEditFlags.NoDragDrop]]), ImVec2(128.0, 96.0)) -- Dummy item
                if ImGui.IsItemHovered() and s.capture_override_mouse ~= -1 then
                    ImGui.SetNextFrameWantCaptureMouse(s.capture_override_mouse == 1)
                end
                if ImGui.IsItemHovered() and s.capture_override_keyboard ~= -1 then
                    ImGui.SetNextFrameWantCaptureKeyboard(s.capture_override_keyboard == 1)
                end

                ImGui.TreePop()
            end
            ImGui.TreePop()
        end

        -- Demonstrate using Shortcut() and Routing Policies.
        -- The general flow is:
        -- - Code interested in a chord (e.g. "Ctrl+A") declares their intent.
        -- - Multiple locations may be interested in same chord! Routing helps find a winner.
        -- - Every frame, we resolve all claims and assign one owner if the modifiers are matching.
        -- - The lower-level function is 'bool SetShortcutRouting()', returns true when caller got the route.
        -- - Most of the times, SetShortcutRouting() is not called directly. User mostly calls Shortcut() with routing flags.
        -- - If you call Shortcut() WITHOUT any routing option, it uses ImGuiInputFlags.RouteFocused.
        -- TL;DR: Most uses will simply be:
        -- - Shortcut(ImGuiMod_Ctrl | ImGuiKey.A); -- Use ImGuiInputFlags.RouteFocused policy.
        if ImGui.TreeNode("Shortcuts") then
            IMGUI_DEMO_MARKER("Inputs & Focus/Shortcuts")
            _, s.route_options = ImGui.CheckboxFlags("ImGuiInputFlags_Repeat", s.route_options, 1 --[[ImGuiInputFlags.Repeat]])
            _, s.route_type = ImGui.RadioButton("ImGuiInputFlags_RouteActive", s.route_type, 1024 --[[ImGuiInputFlags.RouteActive]])
            _, s.route_type = ImGui.RadioButton("ImGuiInputFlags_RouteFocused (default)", s.route_type, 2048 --[[ImGuiInputFlags.RouteFocused]])
            ImGui.Indent()
            ImGui.BeginDisabled(s.route_type ~= 2048 --[[ImGuiInputFlags.RouteFocused]])
            _, s.route_options = ImGui.CheckboxFlags("ImGuiInputFlags_RouteOverActive##0", s.route_options, 32768 --[[ImGuiInputFlags.RouteOverActive]])
            ImGui.EndDisabled()
            ImGui.Unindent()
            _, s.route_type = ImGui.RadioButton("ImGuiInputFlags_RouteGlobal", s.route_type, 4096 --[[ImGuiInputFlags.RouteGlobal]])
            ImGui.Indent()
            ImGui.BeginDisabled(s.route_type ~= 4096 --[[ImGuiInputFlags.RouteGlobal]])
            _, s.route_options = ImGui.CheckboxFlags("ImGuiInputFlags_RouteOverFocused", s.route_options, 16384 --[[ImGuiInputFlags.RouteOverFocused]])
            _, s.route_options = ImGui.CheckboxFlags("ImGuiInputFlags_RouteOverActive", s.route_options, 32768 --[[ImGuiInputFlags.RouteOverActive]])
            _, s.route_options = ImGui.CheckboxFlags("ImGuiInputFlags_RouteUnlessBgFocused", s.route_options, 65536 --[[ImGuiInputFlags.RouteUnlessBgFocused]])
            ImGui.EndDisabled()
            ImGui.Unindent()
            _, s.route_type = ImGui.RadioButton("ImGuiInputFlags_RouteAlways", s.route_type, 8192 --[[ImGuiInputFlags.RouteAlways]])
            local flags = bit32.bor(s.route_type, s.route_options) -- Merged flags
            if s.route_type ~= 4096 --[[ImGuiInputFlags.RouteGlobal]] then
                flags = bit32.band(flags, bit32.bnot(bit32.bor(16384 --[[ImGuiInputFlags.RouteOverFocused]], 32768 --[[ImGuiInputFlags.RouteOverActive]], 65536 --[[ImGuiInputFlags.RouteUnlessBgFocused]])))
            end

            ImGui.SeparatorText("Using SetNextItemShortcut()")
            ImGui.Text("Ctrl+S")
            ImGui.SetNextItemShortcut(bit32.bor(4096 --[[ImGuiMod_Ctrl]], 564 --[[ImGuiKey.S]]), bit32.bor(flags, 262144 --[[ImGuiInputFlags.Tooltip]]))
            ImGui.Button("Save")
            ImGui.Text("Alt+F")
            ImGui.SetNextItemShortcut(bit32.bor(16384 --[[ImGuiMod_Alt]], 551 --[[ImGuiKey.F]]), bit32.bor(flags, 262144 --[[ImGuiInputFlags.Tooltip]]))
            s.f = ImGui.SliderFloat("Factor", s.f, 0.0, 1.0)

            ImGui.SeparatorText("Using Shortcut()")
            local line_height = ImGui.GetTextLineHeightWithSpacing()
            local key_chord = bit32.bor(4096 --[[ImGuiMod_Ctrl]], 546 --[[ImGuiKey.A]])

            ImGui.Text("Ctrl+A")
            ImGui.Text("IsWindowFocused: %d, Shortcut: %s", ImGui.IsWindowFocused() and 1 or 0, ImGui.Shortcut(key_chord, flags) and "PRESSED" or "...")

            ImGui.PushStyleColor(3 --[[ImGuiCol.ChildBg]], ImVec4(1.0, 0.0, 1.0, 0.1))

            ImGui.BeginChild("WindowA", ImVec2(-1.1754943508223e-38 --[[FLT_MIN]], line_height * 14), true)
            ImGui.Text("Press Ctrl+A and see who receives it!")
            ImGui.Separator()

            -- 1: Window polling for Ctrl+A
            ImGui.Text("(in WindowA)")
            ImGui.Text("IsWindowFocused: %d, Shortcut: %s", ImGui.IsWindowFocused() and 1 or 0, ImGui.Shortcut(key_chord, flags) and "PRESSED" or "...")

            -- 2: InputText also polling for Ctrl+A: it always uses _RouteFocused internally (gets priority when active)
            -- (Commented because the owner-aware version of Shortcut() is still in imgui_internal.h)
            --char str[16] = "Press Ctrl+A";
            --ImGui.Spacing();
            --ImGui.InputText("InputTextB", str, IM_COUNTOF(str), ImGuiInputTextFlags.ReadOnly);
            --ImGuiID item_id = ImGui.GetItemID();
            --ImGui.SameLine(); HelpMarker("Internal widgets always use _RouteFocused");
            --ImGui.Text("IsWindowFocused: %d, Shortcut: %s", ImGui.IsWindowFocused(), ImGui.Shortcut(key_chord, flags, item_id) ? "PRESSED" : "...");

            -- 3: Dummy child is not claiming the route: focusing them shouldn't steal route away from WindowA
            ImGui.BeginChild("ChildD", ImVec2(-1.1754943508223e-38 --[[FLT_MIN]], line_height * 4), true)
            ImGui.Text("(in ChildD: not using same Shortcut)")
            ImGui.Text("IsWindowFocused: %d", ImGui.IsWindowFocused() and 1 or 0)
            ImGui.EndChild()

            -- 4: Child window polling for Ctrl+A. It is deeper than WindowA and gets priority when focused.
            ImGui.BeginChild("ChildE", ImVec2(-1.1754943508223e-38 --[[FLT_MIN]], line_height * 4), true)
            ImGui.Text("(in ChildE: using same Shortcut)")
            ImGui.Text("IsWindowFocused: %d, Shortcut: %s", ImGui.IsWindowFocused() and 1 or 0, ImGui.Shortcut(key_chord, flags) and "PRESSED" or "...")
            ImGui.EndChild()

            -- 5: In a popup
            if ImGui.Button("Open Popup") then
                ImGui.OpenPopup("PopupF")
            end
            if ImGui.BeginPopup("PopupF") then
                ImGui.Text("(in PopupF)")
                ImGui.Text("IsWindowFocused: %d, Shortcut: %s", ImGui.IsWindowFocused() and 1 or 0, ImGui.Shortcut(key_chord, flags) and "PRESSED" or "...")
                -- (Commented because the owner-aware version of Shortcut() is still in imgui_internal.h)
                --ImGui.InputText("InputTextG", str, IM_COUNTOF(str), ImGuiInputTextFlags.ReadOnly);
                --ImGui.Text("IsWindowFocused: %d, Shortcut: %s", ImGui.IsWindowFocused(), ImGui.Shortcut(key_chord, flags, ImGui.GetItemID()) ? "PRESSED" : "...");
                ImGui.EndPopup()
            end
            ImGui.EndChild()
            ImGui.PopStyleColor()

            ImGui.TreePop()
        end

        -- Display mouse cursors
        if ImGui.TreeNode("Mouse Cursors") then
            IMGUI_DEMO_MARKER("Inputs & Focus/Mouse Cursors")
            local mouse_cursors_names = s.mouse_cursors_names -- 1-based
            assert(#mouse_cursors_names == 11 --[[ImGuiMouseCursor.COUNT]])

            local current = ImGui.GetMouseCursor()
            local cursor_name = "N/A"
            if (current >= 0 --[[ImGuiMouseCursor.Arrow]]) and (current < 11 --[[ImGuiMouseCursor.COUNT]]) then cursor_name = mouse_cursors_names[current + 1] end
            ImGui.Text("Current mouse cursor = %d: %s", current, cursor_name)
            ImGui.BeginDisabled(true)
            _, io.BackendFlags = ImGui.CheckboxFlags("io.BackendFlags: HasMouseCursors", io.BackendFlags, 2 --[[ImGuiBackendFlags.HasMouseCursors]])
            ImGui.EndDisabled()

            ImGui.Text("Hover to see mouse cursors:")
            ImGui.SameLine(); HelpMarker(
                "Your application can render a different mouse cursor based on what ImGui::GetMouseCursor() returns. " ..
                "If software cursor rendering (io.MouseDrawCursor) is set ImGui will draw the right cursor for you, " ..
                "otherwise your backend needs to handle it.")
            for i = 0, 11 --[[ImGuiMouseCursor.COUNT]] - 1 do
                local label = string.format("Mouse cursor %d: %s", i, mouse_cursors_names[i + 1])
                ImGui.Bullet(); ImGui.Selectable(label, false)
