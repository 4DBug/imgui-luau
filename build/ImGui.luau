function ExampleTree_CreateNode(name, uid, parent)
    local node = ExampleTreeNode()
    node.Name = string.sub(name, 1, 27)
    node.UID = uid
    node.Parent = parent
    node.IndexInParent = parent and #parent.Childs or 0
