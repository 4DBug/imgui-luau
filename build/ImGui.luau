        -- We reset Size/ContentSize for reappearing popups/tooltips early in this function, so further code won't be tempted to use the old size.
        if window_just_activated_by_user and bit32.band(flags, bit32.bor(67108864 --[[ImGuiWindowFlags.Popup]], 33554432 --[[ImGuiWindowFlags.Tooltip]])) ~= 0 then
