    elseif data_type == ImGuiDataType.S16 then
        str = ImFormatString(format, (ImS16)(data))
    elseif data_type == ImGuiDataType.U16 then
        str = ImFormatString(format, (ImU16)(data))
    else
        IM_ASSERT(false)
    end
