function ImGuiMultiSelectState()
    return { Window = nil, ID = 0, LastFrameActive = 0, LastSelectionSize = 0, RangeSelected = -1, NavIdSelected = -1, RangeSrcItem = (-1) --[[ImGuiSelectionUserData_Invalid]], NavIdItem = (-1) --[[ImGuiSelectionUserData_Invalid]] }
