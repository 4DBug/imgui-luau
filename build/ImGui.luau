--- @param constructor function
--- @param size        int
function ImGui.MemAlloc(constructor, size)
    local p = GImAllocatorAllocFunc(constructor, size, GImAllocatorUserData)
    local ctx = GImGui
    if ctx then
        ImGui.DebugAllocHook(ctx.DebugAllocInfo, ctx.FrameCount, p, size)
    end
    return p
