S.DemoWindowWidgetsTreeNodes = {
    base_flags = bit32.bor(ImGuiTreeNodeFlags.DrawLinesFull, ImGuiTreeNodeFlags.DefaultOpen), -- [Port] "Hierarchy Lines"
    selection_mask = 0x00,
    base_flags_2 = bit32.bor(ImGuiTreeNodeFlags.OpenOnArrow, ImGuiTreeNodeFlags.OpenOnDoubleClick, ImGuiTreeNodeFlags.SpanAvailWidth), -- "Advanced"
    align_label_with_current_x_position = false,
    use_drag_and_drop = false,
}
function DemoWindowWidgetsTreeNodes()
    local s = S.DemoWindowWidgetsTreeNodes
    if ImGui.TreeNode("Tree Nodes") then
        IMGUI_DEMO_MARKER("Widgets/Tree Nodes")
        -- See see "Examples -> Property Editor" (ShowExampleAppPropertyEditor() function) for a fancier, data-driven tree.
        if ImGui.TreeNode("Basic Trees") then
            IMGUI_DEMO_MARKER("Widgets/Tree Nodes/Basic Trees")
            for i = 0, 4 do
                -- Use SetNextItemOpen() so set the default state of a node to be open. We could
                -- also use TreeNodeEx() with the ImGuiTreeNodeFlags_DefaultOpen flag to achieve the same thing!
                if i == 0 then
                    ImGui.SetNextItemOpen(true, 2 --[[ImGuiCond.Once]])
                end

                -- Here we use PushID() to generate a unique base ID, and then the "" used as TreeNode id won't conflict.
                -- An alternative to using 'PushID() + TreeNode("", ...)' to generate a unique ID is to use 'TreeNode((void*)(intptr_t)i, ...)',
                -- aka generate a dummy pointer-sized value to be hashed. The demo below uses that technique. Both are fine.
                ImGui.PushID(i)
                if ImGui.TreeNode("", "Child %d", i) then
                    ImGui.Text("blah blah")
                    ImGui.SameLine()
                    if ImGui.SmallButton("button") then end
                    ImGui.TreePop()
                end
                ImGui.PopID()
            end
            ImGui.TreePop()
        end

        if ImGui.TreeNode("Hierarchy Lines") then
            IMGUI_DEMO_MARKER("Widgets/Tree Nodes/Hierarchy Lines")
            HelpMarker("Default option for DrawLinesXXX is stored in style.TreeLinesFlags")
            _, s.base_flags = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_DrawLinesNone", s.base_flags, 262144 --[[ImGuiTreeNodeFlags.DrawLinesNone]])
            _, s.base_flags = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_DrawLinesFull", s.base_flags, 524288 --[[ImGuiTreeNodeFlags.DrawLinesFull]])
            _, s.base_flags = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_DrawLinesToNodes", s.base_flags, 1048576 --[[ImGuiTreeNodeFlags.DrawLinesToNodes]])

            if ImGui.TreeNodeEx("Parent", s.base_flags) then
                if ImGui.TreeNodeEx("Child 1", s.base_flags) then
                    ImGui.Button("Button for Child 1")
                    ImGui.TreePop()
                end
                if ImGui.TreeNodeEx("Child 2", s.base_flags) then
                    ImGui.Button("Button for Child 2")
                    ImGui.TreePop()
                end
                ImGui.Text("Remaining contents")
                ImGui.Text("Remaining contents")
                ImGui.TreePop()
            end

            ImGui.TreePop()
        end

        if ImGui.TreeNode("Clipping Large Trees") then
            IMGUI_DEMO_MARKER("Widgets/Tree Nodes/Clipping Large Trees")
            ImGui.TextWrapped(
                "- Using ImGuiListClipper with trees is a less easy than on arrays or grids.\n" ..
                "- Refer to 'Demo->Examples->Property Editor' for an example of how to do that.\n" ..
                "- Discuss in #3823")
            ImGui.TreePop()
        end

        if ImGui.TreeNode("Selectable Nodes") then
            IMGUI_DEMO_MARKER("Widgets/Tree Nodes/Selectable Nodes")
            HelpMarker(
                "Manually implemented selectable nodes.\n" ..
                "Click to select, Ctrl+Click to toggle, click on arrows or double-click to open.\n\n" ..
                "You may also use the multi-select API (see 'Demo->Widgets->Selection State & Multi-Select') for more advanced multi-selection features.")

            -- Hold in 'selection_mask' a simple representation of what may be user-side selection state.
            -- - You may retain selection state inside or outside your objects in whatever format you see fit.
            --   You may use ImGuiSelectionBasicStorage which is conceptually close to a set<> of identifiers.
            -- - We record which node was clicked and then apply selection at the end of the loop.
            -- - This is a manual and simplified reimplementation of multi-selection, which the full
            --   BeginMultiSelect() API implements better, but which is not trivial to wire for trees.
            local node_clicked_idx = -1
            for node_n = 0, 5 do
                -- Disable the default "open on single-click behavior" + set Selected flag according to our selection.
                -- To alter selection we use if 'IsItemClicked() && !IsItemToggledOpen()', so clicking on an arrow doesn't alter selection.
                -- In a BeginMultiSelect()/EndMultiSelect() we could use IsItemToggledSelection() but here we reimplement and use our own logic.
                local flags = bit32.bor(128 --[[ImGuiTreeNodeFlags.OpenOnArrow]], 64 --[[ImGuiTreeNodeFlags.OpenOnDoubleClick]], 2048 --[[ImGuiTreeNodeFlags.SpanAvailWidth]])
                if bit32.band(s.selection_mask, bit32.lshift(1, node_n)) ~= 0 then
                    flags = bit32.bor(flags, 1 --[[ImGuiTreeNodeFlags.Selected]])
                end

                local is_open = ImGui.TreeNodeEx(node_n, flags, "Selectable Node %d", node_n) -- [Port] (void*)(intptr_t)node_n -> node_n
                if ImGui.IsItemClicked() and not ImGui.IsItemToggledOpen() then
                    node_clicked_idx = node_n
                end
                if is_open then
                    ImGui.BulletText("<Node contents here>")
                    ImGui.TreePop()
                end
            end
            if node_clicked_idx ~= -1 then
                -- Update selection state (process outside of tree loop to avoid visual inconsistencies during the clicking frame)
                if ImGui.GetIO().KeyCtrl then
                    s.selection_mask = bit32.bxor(s.selection_mask, bit32.lshift(1, node_clicked_idx)) -- Ctrl+Click to toggle
                else --if (!(selection_mask & (1 << node_clicked_idx))) -- Depending on selection behavior you want, may want to preserve selection when clicking on item that is part of the selection
                    s.selection_mask = bit32.lshift(1, node_clicked_idx)                               -- Click to single-select
                end
            end
            ImGui.TreePop()
        end

        if ImGui.TreeNode("Advanced") then
            IMGUI_DEMO_MARKER("Widgets/Tree Nodes/Advanced")
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_OpenOnArrow", s.base_flags_2, 128 --[[ImGuiTreeNodeFlags.OpenOnArrow]])
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_OpenOnDoubleClick", s.base_flags_2, 64 --[[ImGuiTreeNodeFlags.OpenOnDoubleClick]])
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_SpanAvailWidth", s.base_flags_2, 2048 --[[ImGuiTreeNodeFlags.SpanAvailWidth]]); ImGui.SameLine(); HelpMarker("Extend hit area to all available width instead of allowing more items to be laid out after the node.")
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_SpanFullWidth", s.base_flags_2, 4096 --[[ImGuiTreeNodeFlags.SpanFullWidth]])
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_SpanLabelWidth", s.base_flags_2, 8192 --[[ImGuiTreeNodeFlags.SpanLabelWidth]]); ImGui.SameLine(); HelpMarker("Reduce hit area to the text label and a bit of margin.")
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_SpanAllColumns", s.base_flags_2, 16384 --[[ImGuiTreeNodeFlags.SpanAllColumns]]); ImGui.SameLine(); HelpMarker("For use in Tables only.")
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_AllowOverlap", s.base_flags_2, 4 --[[ImGuiTreeNodeFlags.AllowOverlap]])
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_Framed", s.base_flags_2, 2 --[[ImGuiTreeNodeFlags.Framed]]); ImGui.SameLine(); HelpMarker("Draw frame with background (e.g. for CollapsingHeader)")
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_FramePadding", s.base_flags_2, 1024 --[[ImGuiTreeNodeFlags.FramePadding]])
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_NavLeftJumpsToParent", s.base_flags_2, 131072 --[[ImGuiTreeNodeFlags.NavLeftJumpsToParent]])

            HelpMarker("Default option for DrawLinesXXX is stored in style.TreeLinesFlags")
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_DrawLinesNone", s.base_flags_2, 262144 --[[ImGuiTreeNodeFlags.DrawLinesNone]])
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_DrawLinesFull", s.base_flags_2, 524288 --[[ImGuiTreeNodeFlags.DrawLinesFull]])
            _, s.base_flags_2 = ImGui.CheckboxFlags("ImGuiTreeNodeFlags_DrawLinesToNodes", s.base_flags_2, 1048576 --[[ImGuiTreeNodeFlags.DrawLinesToNodes]])

            _, s.align_label_with_current_x_position = ImGui.Checkbox("Align label with current X position", s.align_label_with_current_x_position)
            _, s.use_drag_and_drop = ImGui.Checkbox("Make Tree Nodes as drag & drop sources", s.use_drag_and_drop)
            if s.align_label_with_current_x_position then
                ImGui.Unindent(ImGui.GetTreeNodeToLabelSpacing())
            end

            for node_n = 0, 5 do
                local node_flags = s.base_flags_2
                if node_n < 3 then
                    -- Items 0..2 are Tree Node
                    local is_open = ImGui.TreeNodeEx(node_n, node_flags, "Selectable Node %d", node_n)
                    if s.use_drag_and_drop and ImGui.BeginDragDropSource() then
                        ImGui.SetDragDropPayload("MY_TREENODE_PAYLOAD_TYPE", nil, 0)
                        ImGui.Text("This is a drag and drop source")
                        ImGui.EndDragDropSource()
                    end
                    if node_n == 2 and bit32.band(s.base_flags_2, 8192 --[[ImGuiTreeNodeFlags.SpanLabelWidth]]) ~= 0 then
                        -- Item 2 has an additional inline button to help demonstrate SpanLabelWidth.
                        ImGui.SameLine()
                        if ImGui.SmallButton("button") then end
                    end
                    if is_open then
                        ImGui.BulletText("Blah blah\nBlah Blah")
                        ImGui.SameLine()
                        ImGui.SmallButton("Button")
                        ImGui.TreePop()
                    end
                else
                    -- Items 3..5 are Tree Leaves
                    -- The only reason we use TreeNode at all is to allow selection of the leaf. Otherwise we can
                    -- use BulletText() or advance the cursor by GetTreeNodeToLabelSpacing() and call Text().
                    node_flags = bit32.bor(node_flags, 256 --[[ImGuiTreeNodeFlags.Leaf]], 8 --[[ImGuiTreeNodeFlags.NoTreePushOnOpen]]) -- ImGuiTreeNodeFlags_Bullet
                    ImGui.TreeNodeEx(node_n, node_flags, "Selectable Leaf %d", node_n)
                    if s.use_drag_and_drop and ImGui.BeginDragDropSource() then
                        ImGui.SetDragDropPayload("MY_TREENODE_PAYLOAD_TYPE", nil, 0)
                        ImGui.Text("This is a drag and drop source")
                        ImGui.EndDragDropSource()
                    end
                end
            end
            if s.align_label_with_current_x_position then
                ImGui.Indent(ImGui.GetTreeNodeToLabelSpacing())
            end
            ImGui.TreePop()
        end
        ImGui.TreePop()
    end
end

