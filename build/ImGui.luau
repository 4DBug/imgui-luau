--- @param focus_change_dir int
function ImGui.NavUpdateWindowingTarget(focus_change_dir)
    local g = GImGui
    assert(g.NavWindowingTarget)
    if bit32.band(g.NavWindowingTarget.Flags, 134217728 --[[ImGuiWindowFlags.Modal]]) ~= 0 then
        return
    end

    local i_current = ImGui.FindWindowFocusIndex(g.NavWindowingTarget)
    local window_target = ImGui.FindWindowNavFocusable(i_current + focus_change_dir, 0, focus_change_dir)
    if window_target == nil then
        window_target = ImGui.FindWindowNavFocusable((focus_change_dir < 0) and g.WindowsFocusOrder.Size or 1, i_current, focus_change_dir)
    end
    if window_target then -- Don't reset windowing target if there's a single window in the list
        g.NavWindowingTarget = window_target
        g.NavWindowingTargetAnim = window_target
        ImVec2_CopyV(g.NavWindowingAccumDeltaPos, 0.0, 0.0)
        ImVec2_CopyV(g.NavWindowingAccumDeltaSize, 0.0, 0.0)
    end
    g.NavWindowingToggleLayer = false
end

-- Apply focus and close overlay
--- @param apply_focus_window ImGuiWindow
function ImGui.NavUpdateWindowingApplyFocus(apply_focus_window)
    -- FIXME: Many actions here could be part of a higher-level/reused function. Why aren't they in FocusWindow() ?
    -- Investigate for each of them: ClearActiveID(), NavRestoreHighlightAfterMove(), NavRestoreLastChildNavWindow(), ClosePopupsOverWindow(), NavInitWindow()
    local g = GImGui
    if g.NavWindow == nil or apply_focus_window ~= g.NavWindow.RootWindow then
        local previous_viewport = g.NavWindow and g.NavWindow.Viewport or nil
        ImGui.ClearActiveID()
        ImGui.SetNavCursorVisibleAfterMove()
        ImGui.ClosePopupsOverWindow(apply_focus_window, false)
        ImGui.FocusWindow(apply_focus_window, 1 --[[ImGuiFocusRequestFlags.RestoreFocusedChild]])
        assert(g.NavWindow ~= nil)
        apply_focus_window = g.NavWindow
        if apply_focus_window.NavLastIds[0 --[[ImGuiNavLayer.Main]]] == 0 then -- FIXME: This is the equivalent of the 'if (g.NavId == 0) { NavInitWindow() }' in DockNodeUpdateTabBar().
            ImGui.NavInitWindow(apply_focus_window, false)
        end

        -- If the window has ONLY a menu layer (no main layer), select it directly
        -- Use NavLayersActiveMaskNext since windows didn't have a chance to be Begin()-ed on this frame,
        -- so Ctrl+Tab where the keys are only held for 1 frame will be able to use correct layers mask since
        -- the target window as already been previewed once.
        -- FIXME-NAV: This should be done in NavInit.. or in FocusWindow... However in both of those cases,
        -- we won't have a guarantee that windows has been visible before and therefore NavLayersActiveMask*
        -- won't be valid.
        if apply_focus_window.DC.NavLayersActiveMaskNext == bit32.lshift(1, 1 --[[ImGuiNavLayer.Menu]]) then
            g.NavLayer = 1 --[[ImGuiNavLayer.Menu]]
        end

        -- Request OS level focus
        if apply_focus_window.Viewport ~= previous_viewport and g.PlatformIO.Platform_SetWindowFocus then
            g.PlatformIO.Platform_SetWindowFocus(apply_focus_window.Viewport)
        end
    end
    g.NavWindowingTarget = nil
end

-- Windowing management mode
-- Keyboard: Ctrl+Tab (change focus/move/resize), Alt (toggle menu layer)
-- Gamepad:  Hold Menu/Square (change focus/move/resize), Tap Menu/Square (toggle menu layer)
function ImGui.NavUpdateWindowing()
    local g = GImGui
    local io = g.IO

    local apply_focus_window = nil
    local apply_toggle_layer = false

    local modal_window = ImGui.GetTopMostPopupModal()
    local allow_windowing = (modal_window == nil) -- FIXME: This prevent Ctrl+Tab from being usable with windows that are inside the Begin-stack of that modal.
    if not allow_windowing then
        g.NavWindowingTarget = nil
    end

    -- Fade out
    if g.NavWindowingTargetAnim and g.NavWindowingTarget == nil then
        g.NavWindowingHighlightAlpha = ImMax(g.NavWindowingHighlightAlpha - io.DeltaTime * 10.0, 0.0)
        if g.DimBgRatio <= 0.0 and g.NavWindowingHighlightAlpha <= 0.0 then
            g.NavWindowingTargetAnim = nil
        end
    end

    -- Start Ctrl+Tab or Square+L/R window selection
    -- (g.ConfigNavWindowingKeyNext/g.ConfigNavWindowingKeyPrev defaults are ImGuiMod_Ctrl|ImGuiKey.Tab and ImGuiMod_Ctrl|ImGuiMod_Shift|ImGuiKey.Tab)
    local owner_id = ImHashStr("##NavUpdateWindowing")
    local nav_gamepad_active = bit32.band(io.ConfigFlags, 2 --[[ImGuiConfigFlags.NavEnableGamepad]]) ~= 0 and bit32.band(io.BackendFlags, 1 --[[ImGuiBackendFlags.HasGamepad]]) ~= 0
    local nav_keyboard_active = bit32.band(io.ConfigFlags, 1 --[[ImGuiConfigFlags.NavEnableKeyboard]]) ~= 0
    local keyboard_next_window = allow_windowing and g.ConfigNavWindowingKeyNext ~= 0 and ImGui.Shortcut(g.ConfigNavWindowingKeyNext, bit32.bor(1 --[[ImGuiInputFlags.Repeat]], 8192 --[[ImGuiInputFlags.RouteAlways]]), owner_id)
    local keyboard_prev_window = allow_windowing and g.ConfigNavWindowingKeyPrev ~= 0 and ImGui.Shortcut(g.ConfigNavWindowingKeyPrev, bit32.bor(1 --[[ImGuiInputFlags.Repeat]], 8192 --[[ImGuiInputFlags.RouteAlways]]), owner_id)
    local start_toggling_with_gamepad = nav_gamepad_active and g.NavWindowingTarget == nil and ImGui.Shortcut(634 --[[ImGuiKey.NavGamepadMenu]], 8192 --[[ImGuiInputFlags.RouteAlways]], owner_id)
    local start_windowing_with_gamepad = allow_windowing and start_toggling_with_gamepad
    local start_windowing_with_keyboard = allow_windowing and g.NavWindowingTarget == nil and (keyboard_next_window or keyboard_prev_window) -- Note: enabled even without NavEnableKeyboard!
    local just_started_windowing_from_null_focus = false
    if start_toggling_with_gamepad then
        g.NavWindowingToggleLayer = true -- Gamepad starts toggling layer
        g.NavWindowingToggleKey = 634 --[[ImGuiKey.NavGamepadMenu]]
        g.NavWindowingInputSource = 3 --[[ImGuiInputSource.Gamepad]]
        g.NavInputSource = 3 --[[ImGuiInputSource.Gamepad]]
    end
    if start_windowing_with_gamepad or start_windowing_with_keyboard then
        local window = (g.NavWindow and ImGui.IsWindowNavFocusable(g.NavWindow)) and g.NavWindow or ImGui.FindWindowNavFocusable(g.WindowsFocusOrder.Size, 0, -1)
        if window then
            if start_windowing_with_keyboard or g.ConfigNavWindowingWithGamepad then
                g.NavWindowingTarget = window.RootWindow
                g.NavWindowingTargetAnim = window.RootWindow -- Current location
            end
            g.NavWindowingTimer = 0.0
            g.NavWindowingHighlightAlpha = 0.0
            ImVec2_CopyV(g.NavWindowingAccumDeltaPos, 0.0, 0.0)
            ImVec2_CopyV(g.NavWindowingAccumDeltaSize, 0.0, 0.0)
            g.NavWindowingInputSource = start_windowing_with_keyboard and 2 --[[ImGuiInputSource.Keyboard]] or 3 --[[ImGuiInputSource.Gamepad]]
            g.NavInputSource = g.NavWindowingInputSource
            if g.NavWindow == nil then
                just_started_windowing_from_null_focus = true
            end

            -- Manually register ownership of our mods. Using a global route in the Shortcut() calls instead would probably be correct but may have more side-effects.
            if keyboard_next_window or keyboard_prev_window then
                ImGui.SetKeyOwnersForKeyChord(bit32.band(bit32.bor(g.ConfigNavWindowingKeyNext, g.ConfigNavWindowingKeyPrev), 61440 --[[ImGuiMod_Mask_]]), owner_id)
            end
        end
    end

    -- Gamepad update
    if (g.NavWindowingTarget or g.NavWindowingToggleLayer) and g.NavWindowingInputSource == 3 --[[ImGuiInputSource.Gamepad]] then
        if g.NavWindowingTarget ~= nil then
            -- Highlight only appears after a brief time holding the button, so that a fast tap on ImGuiKey.NavGamepadMenu (to toggle NavLayer) doesn't add visual noise
            -- However inputs are accepted immediately, so you press ImGuiKey.NavGamepadMenu + L1/R1 fast.
            g.NavWindowingTimer = g.NavWindowingTimer + io.DeltaTime
            g.NavWindowingHighlightAlpha = ImMax(g.NavWindowingHighlightAlpha, ImSaturate((g.NavWindowingTimer - 0.5 --[[NAV_WINDOWING_HIGHLIGHT_DELAY]]) / 0.05))

            -- Select window to focus
            local focus_change_dir = (ImGui.IsKeyPressedEx(642 --[[ImGuiKey.GamepadL1]], 0 --[[ImGuiInputFlags.None]], 0 --[[ImGuiKeyOwner_Any]]) and 1 or 0) - (ImGui.IsKeyPressedEx(643 --[[ImGuiKey.GamepadR1]], 0 --[[ImGuiInputFlags.None]], 0 --[[ImGuiKeyOwner_Any]]) and 1 or 0)
            if focus_change_dir ~= 0 and not just_started_windowing_from_null_focus then
                ImGui.NavUpdateWindowingTarget(focus_change_dir)
                g.NavWindowingHighlightAlpha = 1.0
            end
        end

        -- Single press toggles NavLayer, long press with L/R apply actual focus on release (until then the window was merely rendered top-most)
        if not ImGui.IsKeyDown(634 --[[ImGuiKey.NavGamepadMenu]]) then
            g.NavWindowingToggleLayer = g.NavWindowingToggleLayer and (g.NavWindowingHighlightAlpha < 1.0) -- Once button was held long enough we don't consider it a tap-to-toggle-layer press anymore.
            if g.NavWindowingToggleLayer and g.NavWindow then
                apply_toggle_layer = true
            elseif not g.NavWindowingToggleLayer then
                apply_focus_window = g.NavWindowingTarget
            end
            g.NavWindowingTarget = nil
            g.NavWindowingToggleLayer = false
        end
    end

    -- Keyboard: Focus
    if g.NavWindowingTarget and g.NavWindowingInputSource == 2 --[[ImGuiInputSource.Keyboard]] then
        -- Visuals only appears after a brief time after pressing TAB the first time, so that a fast Ctrl+Tab doesn't add visual noise
        local shared_mods = bit32.band(
            bit32.band((g.ConfigNavWindowingKeyNext ~= 0) and g.ConfigNavWindowingKeyNext or 61440 --[[ImGuiMod_Mask_]], (g.ConfigNavWindowingKeyPrev ~= 0) and g.ConfigNavWindowingKeyPrev or 61440 --[[ImGuiMod_Mask_]]),
            61440 --[[ImGuiMod_Mask_]])
        assert(shared_mods ~= 0) -- Next/Prev shortcut currently needs a shared modifier to "hold", otherwise Prev actions would keep cycling between two windows.
        g.NavWindowingTimer = g.NavWindowingTimer + io.DeltaTime
        g.NavWindowingHighlightAlpha = ImMax(g.NavWindowingHighlightAlpha, ImSaturate((g.NavWindowingTimer - 0.5 --[[NAV_WINDOWING_HIGHLIGHT_DELAY]]) / 0.05)) -- 1.0f
        if (keyboard_next_window or keyboard_prev_window) and not just_started_windowing_from_null_focus then
            ImGui.NavUpdateWindowingTarget(keyboard_next_window and -1 or 1)
        elseif bit32.band(io.KeyMods, shared_mods) ~= shared_mods then
            apply_focus_window = g.NavWindowingTarget
        end
    end

    -- Keyboard: Press and Release Alt to toggle menu layer
    local windowing_toggle_keys = { 529 --[[ImGuiKey.LeftAlt]], 533 --[[ImGuiKey.RightAlt]] }
    local windowing_toggle_layer_start = false
    if g.NavWindow and bit32.band(g.NavWindow.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) == 0 then
        for _, windowing_toggle_key in ipairs(windowing_toggle_keys) do
            if nav_keyboard_active and ImGui.IsKeyPressedEx(windowing_toggle_key, 0 --[[ImGuiInputFlags.None]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) then
                windowing_toggle_layer_start = true
                g.NavWindowingToggleLayer = true
                g.NavWindowingToggleKey = windowing_toggle_key
                g.NavWindowingInputSource = 2 --[[ImGuiInputSource.Keyboard]]
                g.NavInputSource = 2 --[[ImGuiInputSource.Keyboard]]
                break
            end
        end
    end
    if g.NavWindowingToggleLayer and g.NavWindowingInputSource == 2 --[[ImGuiInputSource.Keyboard]] then
        -- We cancel toggling nav layer when any text has been typed (generally while holding Alt). (See #370)
        -- We cancel toggling nav layer when other modifiers are pressed. (See #4439)
        -- - AltGR is Alt+Ctrl on some layout but we can't reliably detect it (not all backends/systems/layout emit it as Alt+Ctrl).
        -- We cancel toggling nav layer if an owner has claimed the key.
        if io.InputQueueCharacters.Size > 0 or io.KeyCtrl or io.KeyShift or io.KeySuper then
            g.NavWindowingToggleLayer = false
        elseif windowing_toggle_layer_start == false and g.LastKeyboardKeyPressTime == g.Time then
            g.NavWindowingToggleLayer = false
        elseif ImGui.TestKeyOwner(g.NavWindowingToggleKey, 4294967295 --[[ImGuiKeyOwner_NoOwner]]) == false or ImGui.TestKeyOwner(16384 --[[ImGuiMod_Alt]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) == false then
            g.NavWindowingToggleLayer = false
        end

        -- Apply layer toggle on Alt release
        -- Important: as before version <18314 we lacked an explicit IO event for focus gain/loss, we also compare mouse validity to detect old backends clearing mouse pos on focus loss.
        if ImGui.IsKeyReleased(g.NavWindowingToggleKey) and g.NavWindowingToggleLayer then
            if g.ActiveId == 0 or g.ActiveIdAllowOverlap then
                if ImGui.IsMousePosValid(io.MousePos) == ImGui.IsMousePosValid(io.MousePosPrev) then
                    apply_toggle_layer = true
                end
            end
        end
        if not ImGui.IsKeyDown(g.NavWindowingToggleKey) then
            g.NavWindowingToggleLayer = false
        end
    end

    -- Move window
    if g.NavWindowingTarget and bit32.band(g.NavWindowingTarget.Flags, 4 --[[ImGuiWindowFlags.NoMove]]) == 0 then
        local nav_move_dir
        if g.NavInputSource == 2 --[[ImGuiInputSource.Keyboard]] and not io.KeyShift then
            nav_move_dir = ImGui.GetKeyMagnitude2d(513 --[[ImGuiKey.LeftArrow]], 514 --[[ImGuiKey.RightArrow]], 515 --[[ImGuiKey.UpArrow]], 516 --[[ImGuiKey.DownArrow]])
        end
        if g.NavInputSource == 3 --[[ImGuiInputSource.Gamepad]] then
            nav_move_dir = ImGui.GetKeyMagnitude2d(648 --[[ImGuiKey.GamepadLStickLeft]], 649 --[[ImGuiKey.GamepadLStickRight]], 650 --[[ImGuiKey.GamepadLStickUp]], 651 --[[ImGuiKey.GamepadLStickDown]])
        end
        if nav_move_dir and (nav_move_dir.x ~= 0.0 or nav_move_dir.y ~= 0.0) then
            local NAV_MOVE_SPEED = 800.0
            local move_step = NAV_MOVE_SPEED * io.DeltaTime * ImGui.GetScale()
            ImVec2_Copy(g.NavWindowingAccumDeltaPos, g.NavWindowingAccumDeltaPos + nav_move_dir * move_step)
            g.NavHighlightItemUnderNav = true
            local accum_floored = ImTrunc(g.NavWindowingAccumDeltaPos)
            if accum_floored.x ~= 0.0 or accum_floored.y ~= 0.0 then
                local moving_window = g.NavWindowingTarget.RootWindowDockTree
                ImGui.SetWindowPos(moving_window, moving_window.Pos + accum_floored, 1 --[[ImGuiCond.Always]])
                ImVec2_Copy(g.NavWindowingAccumDeltaPos, g.NavWindowingAccumDeltaPos - accum_floored)
            end
        end
    end

    -- Apply final focus
    if apply_focus_window then
        ImGui.NavUpdateWindowingApplyFocus(apply_focus_window)
    end

    -- Apply menu/layer toggle
    if apply_toggle_layer and g.NavWindow then
        ImGui.ClearActiveID()

        -- Move to parent menu if necessary
        local new_nav_window = g.NavWindow
        while new_nav_window.ParentWindow
            and bit32.band(new_nav_window.DC.NavLayersActiveMask, bit32.lshift(1, 1 --[[ImGuiNavLayer.Menu]])) == 0
            and bit32.band(new_nav_window.Flags, 16777216 --[[ImGuiWindowFlags.ChildWindow]]) ~= 0
            and bit32.band(new_nav_window.Flags, bit32.bor(67108864 --[[ImGuiWindowFlags.Popup]], 268435456 --[[ImGuiWindowFlags.ChildMenu]])) == 0 do
            new_nav_window = new_nav_window.ParentWindow
        end
        if new_nav_window ~= g.NavWindow then
            local old_nav_window = g.NavWindow
            ImGui.FocusWindow(new_nav_window)
            new_nav_window.NavLastChildNavWindow = old_nav_window
        end

        -- Toggle layer
        local new_nav_layer = (bit32.band(g.NavWindow.DC.NavLayersActiveMask, bit32.lshift(1, 1 --[[ImGuiNavLayer.Menu]])) ~= 0) and bit32.bxor(g.NavLayer, 1) or 0 --[[ImGuiNavLayer.Main]]
        if new_nav_layer ~= g.NavLayer then
            -- Reinitialize navigation when entering menu bar with the Alt key (FIXME: could be a properly of the layer?)
            local preserve_layer_1_nav_id = (new_nav_window.DockNodeAsHost ~= nil)
            if new_nav_layer == 1 --[[ImGuiNavLayer.Menu]] and not preserve_layer_1_nav_id then
                g.NavWindow.NavLastIds[new_nav_layer] = 0
            end
            ImGui.NavRestoreLayer(new_nav_layer)
            ImGui.SetNavCursorVisibleAfterMove()
        end
    end
end

function ImGui.NavUpdateContextMenuRequest()
    local g = GImGui
    local io = g.IO
    g.NavOpenContextMenuItemId = 0
    g.NavOpenContextMenuWindowId = 0
    local nav_keyboard_active = bit32.band(io.ConfigFlags, 1 --[[ImGuiConfigFlags.NavEnableKeyboard]]) ~= 0
    local nav_gamepad_active = bit32.band(io.ConfigFlags, 2 --[[ImGuiConfigFlags.NavEnableGamepad]]) ~= 0
    if (not nav_keyboard_active and not nav_gamepad_active) or g.NavWindow == nil then
        return
    end

    local request = false
    request = request or (nav_keyboard_active and (ImGui.IsKeyReleased(535 --[[ImGuiKey.Menu]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) or (ImGui.IsKeyPressedEx(581 --[[ImGuiKey.F10]], 0 --[[ImGuiInputFlags.None]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) and io.KeyMods == 8192 --[[ImGuiMod_Shift]])))
    request = request or (nav_gamepad_active and ImGui.IsKeyPressedEx(636 --[[ImGuiKey.NavGamepadContextMenu]], 0 --[[ImGuiInputFlags.None]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]))
    if not request then
        return
    end

    g.NavOpenContextMenuItemId = g.NavId
    g.NavOpenContextMenuWindowId = g.NavWindow.ID

    -- Allow triggering for Begin()..BeginPopupContextItem(). A possible alternative would be to use g.NavLayer == ImGuiNavLayer.Menu.
    if g.NavId == g.NavWindow:GetID("#CLOSE") or g.NavId == g.NavWindow:GetID("#COLLAPSE") then
        g.NavOpenContextMenuItemId = g.NavWindow.MoveId
    end

    g.NavInputSource = 2 --[[ImGuiInputSource.Keyboard]]
    ImGui.SetNavCursorVisibleAfterMove()
end

