--- @param window_class ImGuiWindowClass
function ImGui.SetNextWindowClass(window_class)
    local g = GImGui
    g.NextWindowData.HasFlags = bit32.bor(g.NextWindowData.HasFlags, 8192 --[[ImGuiNextWindowDataFlags.HasWindowClass]])
