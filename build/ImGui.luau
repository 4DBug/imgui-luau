function ExampleImageViewer_DrawOptions(data)
    ImGui.SetNextItemShortcut(552 --[[ImGuiKey.G]], 262144 --[[ImGuiInputFlags.Tooltip]]) -- | ImGuiInputFlags.RouteGlobal
    _, data.GridEnabled = ImGui.Checkbox("Grid", data.GridEnabled)
    ImGui.SameLine()
    ImGui.SetNextItemWidth(ImGui.GetFontSize() * 10.0)
    local zoom_100 = data.Zoom * 100.0
    local changed
    zoom_100, changed = ImGui.DragFloat("##Zoom", zoom_100, 5.0, data.ZoomMin * 100.0, data.ZoomMax * 100.0, "%.0f%%", 1536 --[[ImGuiSliderFlags.AlwaysClamp]])
    if changed then
        data.Zoom = zoom_100 / 100.0
    end
