--- @param window ImGuiWindow
--- @param pos    ImVec2
--- @param cond?  ImGuiCond
function ImGui.SetWindowPos(window, pos, cond)
    -- [Port] Overloads: SetWindowPos(pos, cond) / SetWindowPos(name, pos, cond) / SetWindowPos(window, pos, cond)
    if type(window) == "string" then
        window = ImGui.FindWindowByName(window)
        if window == nil then return end
    elseif window.SetWindowPosAllowFlags == nil then
        window, pos, cond = ImGui.GetCurrentWindowRead(), window, pos
    end
    if cond == nil then cond = 0 end

    -- Test condition (NB: bit 0 is always true) and clear flags for next time
    if (cond ~= 0) and (bit32.band(window.SetWindowPosAllowFlags, cond) == 0) then
        return
    end

    assert(cond == 0 or ImIsPowerOfTwo(cond)) -- Make sure the user doesn't attempt to combine multiple condition flags.
    window.SetWindowPosAllowFlags = bit32.band(window.SetWindowPosAllowFlags, bit32.bnot(bit32.bor(2 --[[ImGuiCond.Once]], 4 --[[ImGuiCond.FirstUseEver]], 8 --[[ImGuiCond.Appearing]])))
    ImVec2_Copy(window.SetWindowPosVal, ImVec2(3.4028234663853e+38 --[[FLT_MAX]], 3.4028234663853e+38 --[[FLT_MAX]]))

    -- Set
    local old_pos = ImVec2()
    ImVec2_Copy(old_pos, window.Pos)

    window.Pos.x = ImTrunc(pos.x)
    window.Pos.y = ImTrunc(pos.y)

    local offset = window.Pos - old_pos

    if offset.x == 0 and offset.y == 0 then
        return
    end
    ImGui.MarkIniSettingsDirty(window)
    -- FIXME: share code with TranslateWindow(), need to confirm whether the 3 rect modified by TranslateWindow() are desirable here.
    ImVec2_Copy(window.DC.CursorPos, window.DC.CursorPos + offset)       -- As we happen to move the window while it is being appended to (which is a bad idea - will smear) let's at least offset the cursor
    ImVec2_Copy(window.DC.CursorMaxPos, window.DC.CursorMaxPos + offset) -- And more importantly we need to offset CursorMaxPos/CursorStartPos this so ContentSize calculation doesn't get affected.
    ImVec2_Copy(window.DC.IdealMaxPos, window.DC.IdealMaxPos + offset)
    ImVec2_Copy(window.DC.CursorStartPos, window.DC.CursorStartPos + offset)
end

--- @param window ImGuiWindow
--- @param size   ImVec2
--- @param cond?  ImGuiCond
function ImGui.SetWindowSize(window, size, cond)
    -- Overloads: SetWindowSize(size, cond) / SetWindowSize(name, size, cond) / SetWindowSize(window, size, cond)
    if type(window) == "string" then
        window = ImGui.FindWindowByName(window)
        if window == nil then return end
    elseif window.SetWindowSizeAllowFlags == nil then
        window, size, cond = GImGui.CurrentWindow, window, size
    end
    if cond == nil then cond = 0 end

    -- Test condition (NB: bit 0 is always true) and clear flags for next time
    if ((cond ~= 0) and bit32.band(window.SetWindowSizeAllowFlags, cond) == 0) then
        return
    end

    assert(cond == 0 or ImIsPowerOfTwo(cond)) -- Make sure the user doesn't attempt to combine multiple condition flags.
    window.SetWindowSizeAllowFlags = bit32.band(window.SetWindowSizeAllowFlags, bit32.bnot(bit32.bor(2 --[[ImGuiCond.Once]], 4 --[[ImGuiCond.FirstUseEver]], 8 --[[ImGuiCond.Appearing]])))

    -- Enable auto-fit (not done in BeginChild() path unless appearing or combined with ImGuiChildFlags.AlwaysAutoResize)
    if bit32.band(window.Flags, 16777216 --[[ImGuiWindowFlags.ChildWindow]]) == 0 or window.Appearing or bit32.band(window.ChildFlags, 64 --[[ImGuiChildFlags.AlwaysAutoResize]]) ~= 0 then
        window.AutoFitFramesX = (size.x <= 0.0) and 2 or 0
    end
    if bit32.band(window.Flags, 16777216 --[[ImGuiWindowFlags.ChildWindow]]) == 0 or window.Appearing or bit32.band(window.ChildFlags, 64 --[[ImGuiChildFlags.AlwaysAutoResize]]) ~= 0 then
        window.AutoFitFramesY = (size.y <= 0.0) and 2 or 0
    end

    -- Set
    local old_size_x, old_size_y = window.SizeFull.x, window.SizeFull.y

    if size.x <= 0.0 then
        window.AutoFitOnlyGrows = false
    else
        window.SizeFull.x = IM_TRUNC(size.x)
    end
    if size.y <= 0.0 then
        window.AutoFitOnlyGrows = false
    else
        window.SizeFull.y = IM_TRUNC(size.y)
    end
    if old_size_x ~= window.SizeFull.x or old_size_y ~= window.SizeFull.y then
        ImGui.MarkIniSettingsDirty(window)
    end
end

--- Overloads: SetWindowCollapsed(collapsed, cond) / SetWindowCollapsed(name, collapsed, cond) / SetWindowCollapsed(window, collapsed, cond)
function ImGui.SetWindowCollapsed(window, collapsed, cond)
    if type(window) == "string" then
        window = ImGui.FindWindowByName(window)
        if window == nil then return end
    elseif type(window) == "boolean" then
        window, collapsed, cond = GImGui.CurrentWindow, window, collapsed
    end
    if cond == nil then cond = 0 end
    -- Test condition (NB: bit 0 is always true) and clear flags for next time
    if cond ~= 0 and bit32.band(window.SetWindowCollapsedAllowFlags, cond) == 0 then
        return
    end
    window.SetWindowCollapsedAllowFlags = bit32.band(window.SetWindowCollapsedAllowFlags, bit32.bnot(bit32.bor(2 --[[ImGuiCond.Once]], 4 --[[ImGuiCond.FirstUseEver]], 8 --[[ImGuiCond.Appearing]])))

    -- Queue applying in Begin()
    if window.WantCollapseToggle then
        window.Collapsed = not window.Collapsed
    end
    window.WantCollapseToggle = (window.Collapsed ~= collapsed)
end

