        ImGui.SameLine()
        _, s.enable_track = ImGui.Checkbox("Track", s.enable_track)

        local scroll_to_off
        s.scroll_to_off_px, scroll_to_off = ImGui.DragFloat("##off", s.scroll_to_off_px, 1.00, 0, 3.4028234663853e+38 --[[FLT_MAX]], "+%.0f px")
        ImGui.SameLine()
        scroll_to_off = ImGui.Button("Scroll Offset") or scroll_to_off

        local scroll_to_pos
        s.scroll_to_pos_px, scroll_to_pos = ImGui.DragFloat("##pos", s.scroll_to_pos_px, 1.00, -10, 3.4028234663853e+38 --[[FLT_MAX]], "X/Y = %.0f px")
        ImGui.SameLine()
        scroll_to_pos = ImGui.Button("Scroll To Pos") or scroll_to_pos
        ImGui.PopItemWidth()

        if scroll_to_off or scroll_to_pos then
            s.enable_track = false
        end

        local style = ImGui.GetStyle()
        local child_w = (ImGui.GetContentRegionAvail().x - 4 * style.ItemSpacing.x) / 5
        if child_w < 1.0 then
            child_w = 1.0
        end
        ImGui.PushID("##VerticalScrolling")
        for i = 0, 4 do
