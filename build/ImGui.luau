-- Note: this will likely be called ActivateItem() once we rework our Focus/Activation system!
-- But ActivateItem() should function without altering scroll/focus?
function ImGui.SetKeyboardFocusHere(offset)
    if offset == nil then offset = 0 end
    local g = GImGui
    local window = g.CurrentWindow
    assert(offset >= -1) -- -1 is allowed but not below

    -- It makes sense in the vast majority of cases to never interrupt a drag and drop.
    -- When we refactor this function into ActivateItem() we may want to make this an option.
    -- MovingWindow is protected from most user inputs using SetActiveIdUsingNavAndKeys(), but
    -- is also automatically dropped in the event g.ActiveId is stolen.
    if g.DragDropActive or g.MovingWindow ~= nil then
        return
    end

    ImGui.SetNavWindow(window)

    local move_flags = bit32.bor(1024 --[[ImGuiNavMoveFlags.IsTabbing]], 4096 --[[ImGuiNavMoveFlags.Activate]], 512 --[[ImGuiNavMoveFlags.FocusApi]], 16384 --[[ImGuiNavMoveFlags.NoSetNavCursorVisible]])
    local scroll_flags = window.Appearing and bit32.bor(1 --[[ImGuiScrollFlags.KeepVisibleEdgeX]], 32 --[[ImGuiScrollFlags.AlwaysCenterY]]) or bit32.bor(1 --[[ImGuiScrollFlags.KeepVisibleEdgeX]], 2 --[[ImGuiScrollFlags.KeepVisibleEdgeY]])
    ImGui.NavMoveRequestSubmit((-1) --[[ImGuiDir.None]], (offset < 0) and 2 --[[ImGuiDir.Up]] or 3 --[[ImGuiDir.Down]], move_flags, scroll_flags) -- FIXME-NAV: Once we refactor tabbing, add LegacyApi flag to not activate non-inputable.
    if offset == -1 then
        ImGui.NavMoveRequestResolveWithLastItem(g.NavMoveResultLocal)
    else
        g.NavTabbingDir = 1
        g.NavTabbingCounter = offset + 1
    end
end

-- Focus = move navigation cursor, set scrolling, set focus window.
function ImGui.FocusItem()
    local g = GImGui
    local window = g.CurrentWindow
    if g.DragDropActive or g.MovingWindow ~= nil then -- FIXME: Opt-in flags for this?
        return
    end
    local move_flags = bit32.bor(1024 --[[ImGuiNavMoveFlags.IsTabbing]], 512 --[[ImGuiNavMoveFlags.FocusApi]], 16384 --[[ImGuiNavMoveFlags.NoSetNavCursorVisible]], 8192 --[[ImGuiNavMoveFlags.NoSelect]])
    local scroll_flags = window.Appearing and bit32.bor(1 --[[ImGuiScrollFlags.KeepVisibleEdgeX]], 32 --[[ImGuiScrollFlags.AlwaysCenterY]]) or bit32.bor(1 --[[ImGuiScrollFlags.KeepVisibleEdgeX]], 2 --[[ImGuiScrollFlags.KeepVisibleEdgeY]])
    ImGui.SetNavWindow(window)
    ImGui.NavMoveRequestSubmit((-1) --[[ImGuiDir.None]], 2 --[[ImGuiDir.Up]], move_flags, scroll_flags)
    ImGui.NavMoveRequestResolveWithLastItem(g.NavMoveResultLocal)
end

