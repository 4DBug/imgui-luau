    local g = GImGui
    local window = ImGui.FindWindowByName("##Tooltip_Error")
    local use_locked_pos = g.IO.KeyCtrl and window ~= nil and window.WasActive
    local c = g.Style.Colors[4 --[[ImGuiCol.PopupBg]]]
    ImGui.PushStyleColor(4 --[[ImGuiCol.PopupBg]], ImVec4(ImLerp(c.x, 1.0, 0.15), ImLerp(c.y, 0.0, 0.15), ImLerp(c.z, 0.0, 0.15), ImLerp(c.w, 1.0, 0.15)))
    if use_locked_pos then
