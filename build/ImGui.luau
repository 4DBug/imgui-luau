local NAV_WINDOWING_LIST_APPEAR_DELAY = 0.15

-- Window has already passed the IsWindowNavFocusable()
local function GetFallbackWindowNameForWindowingList(window)
    if bit32.band(window.Flags, 67108864 --[[ImGuiWindowFlags.Popup]]) ~= 0 then
        return "(Popup)"
    end
    if bit32.band(window.Flags, 1024 --[[ImGuiWindowFlags.MenuBar]]) ~= 0 and window.Name == "##MainMenuBar" then
        return "(Main menu bar)"
    end
    if window.DockNodeAsHost then
        return "(Dock node)" -- Not normally shown to user.
    end
    return "(Untitled)"
end

-- Overlay displayed when using Ctrl+Tab. Called by EndFrame().
function ImGui.NavUpdateWindowingOverlay()
    local g = GImGui
    assert(g.NavWindowingTarget ~= nil)

    if g.NavWindowingTimer < NAV_WINDOWING_LIST_APPEAR_DELAY then
        return
    end

    local viewport = ImGui.GetMainViewport()
    ImGui.SetNextWindowSizeConstraints(ImVec2(viewport.Size.x * 0.20, viewport.Size.y * 0.20), ImVec2(3.4028234663853e+38 --[[FLT_MAX]], 3.4028234663853e+38 --[[FLT_MAX]]))
    ImGui.SetNextWindowPos(viewport:GetCenter(), 1 --[[ImGuiCond.Always]], ImVec2(0.5, 0.5))
    ImGui.PushStyleVar(2 --[[ImGuiStyleVar.WindowPadding]], g.Style.WindowPadding * 2.0)
    ImGui.Begin("##NavWindowingOverlay", nil, bit32.bor(1 --[[ImGuiWindowFlags.NoTitleBar]], 4096 --[[ImGuiWindowFlags.NoFocusOnAppearing]], 2 --[[ImGuiWindowFlags.NoResize]], 4 --[[ImGuiWindowFlags.NoMove]], 197120 --[[ImGuiWindowFlags.NoInputs]], 64 --[[ImGuiWindowFlags.AlwaysAutoResize]], 256 --[[ImGuiWindowFlags.NoSavedSettings]]))
    g.NavWindowingListWindow = g.CurrentWindow
    for n = g.WindowsFocusOrder.Size, 1, -1 do
        local window = g.WindowsFocusOrder.Data[n]
        assert(window ~= nil) -- Fix static analyzers
        if ImGui.IsWindowNavFocusable(window) then
            local label = window.Name
            if ImGui.FindRenderedTextEnd(label) == 1 then
                label = GetFallbackWindowNameForWindowingList(window)
            end
            ImGui.Selectable(label, g.NavWindowingTarget == window)
        end
    end
    ImGui.End()
    ImGui.PopStyleVar()
end

local function NavUpdateCreateWrappingRequest()
    local g = GImGui
    local window = g.NavWindow

    local do_forward = false
    local src = window.NavRectRel[g.NavLayer]
    local bb_rel = ImRect(src.Min.x, src.Min.y, src.Max.x, src.Max.y)
    local clip_dir = g.NavMoveDir

    local move_flags = g.NavMoveFlags
    -- local move_axis = (g.NavMoveDir == ImGuiDir.Up or g.NavMoveDir == ImGuiDir.Down) and ImGuiAxis.Y or ImGuiAxis.X

    -- Menu layer does not maintain scrolling / content size (#9178)
    local wrap_size = (g.NavLayer == 1 --[[ImGuiNavLayer.Menu]]) and window.Size or (window.ContentSize + window.WindowPadding)

    if g.NavMoveDir == 0 --[[ImGuiDir.Left]] and bit32.band(move_flags, bit32.bor(4 --[[ImGuiNavMoveFlags.WrapX]], 1 --[[ImGuiNavMoveFlags.LoopX]])) ~= 0 then
        bb_rel.Min.x = wrap_size.x; bb_rel.Max.x = wrap_size.x
        if bit32.band(move_flags, 4 --[[ImGuiNavMoveFlags.WrapX]]) ~= 0 then
            bb_rel:TranslateY(-bb_rel:GetHeight()) -- Previous row
            clip_dir = 2 --[[ImGuiDir.Up]]
        end
        do_forward = true
    end
    if g.NavMoveDir == 1 --[[ImGuiDir.Right]] and bit32.band(move_flags, bit32.bor(4 --[[ImGuiNavMoveFlags.WrapX]], 1 --[[ImGuiNavMoveFlags.LoopX]])) ~= 0 then
        bb_rel.Min.x = -window.WindowPadding.x; bb_rel.Max.x = -window.WindowPadding.x
        if bit32.band(move_flags, 4 --[[ImGuiNavMoveFlags.WrapX]]) ~= 0 then
            bb_rel:TranslateY(bb_rel:GetHeight()) -- Next row
            clip_dir = 3 --[[ImGuiDir.Down]]
        end
        do_forward = true
    end
    if g.NavMoveDir == 2 --[[ImGuiDir.Up]] and bit32.band(move_flags, bit32.bor(8 --[[ImGuiNavMoveFlags.WrapY]], 2 --[[ImGuiNavMoveFlags.LoopY]])) ~= 0 then
        bb_rel.Min.y = wrap_size.y; bb_rel.Max.y = wrap_size.y
        if bit32.band(move_flags, 8 --[[ImGuiNavMoveFlags.WrapY]]) ~= 0 then
            bb_rel:TranslateX(-bb_rel:GetWidth()) -- Previous column
            clip_dir = 0 --[[ImGuiDir.Left]]
        end
        do_forward = true
    end
    if g.NavMoveDir == 3 --[[ImGuiDir.Down]] and bit32.band(move_flags, bit32.bor(8 --[[ImGuiNavMoveFlags.WrapY]], 2 --[[ImGuiNavMoveFlags.LoopY]])) ~= 0 then
        bb_rel.Min.y = -window.WindowPadding.y; bb_rel.Max.y = -window.WindowPadding.y
        if bit32.band(move_flags, 8 --[[ImGuiNavMoveFlags.WrapY]]) ~= 0 then
            bb_rel:TranslateX(bb_rel:GetWidth()) -- Next column
            clip_dir = 1 --[[ImGuiDir.Right]]
        end
        do_forward = true
    end
    if not do_forward then
        return
    end
    window.NavRectRel[g.NavLayer] = bb_rel
    ImGui.NavClearPreferredPosForAxis(1 --[[ImGuiAxis.X]])
    ImGui.NavClearPreferredPosForAxis(2 --[[ImGuiAxis.Y]])
    ImGui.NavMoveRequestForward(g.NavMoveDir, clip_dir, move_flags, g.NavMoveScrollFlags)
end

function ImGui.NavEndFrame()
    local g = GImGui

    -- Show Ctrl+Tab list window
    if g.NavWindowingTarget ~= nil then
        ImGui.NavUpdateWindowingOverlay()
    end

    -- Perform wrap-around in menus
    -- FIXME-NAV: Wrap may need to apply a weight bias on the other axis. e.g. 4x4 grid with 2 last items missing on last item won't handle LoopY/WrapY correctly.
    -- FIXME-NAV: Wrap (not Loop) support could be handled by the scoring function and then WrapX would function without an extra frame.
    if g.NavWindow and ImGui.NavMoveRequestButNoResultYet() and bit32.band(g.NavMoveFlags, 15 --[[ImGuiNavMoveFlags.WrapMask_]]) ~= 0 and bit32.band(g.NavMoveFlags, 128 --[[ImGuiNavMoveFlags.Forwarded]]) == 0 then
        NavUpdateCreateWrappingRequest()
    end
end

