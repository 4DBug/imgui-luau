    if ImGui.BeginChild("##tree", ImVec2(300, 0), bit32.bor(4 --[[ImGuiChildFlags.ResizeX]], 1 --[[ImGuiChildFlags.Borders]], 256 --[[ImGuiChildFlags.NavFlattened]])) then
        ImGui.PushItemFlag(4 --[[ImGuiItemFlags.NoNavDefaultFocus]], true)
