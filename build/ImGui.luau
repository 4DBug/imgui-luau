-- This function is merely here to free heap allocations.
function ImGui.Shutdown()
    local g = GImGui
    IM_ASSERT_USER_ERROR(g.IO.BackendPlatformUserData == nil, "Forgot to shutdown Platform backend?")
    IM_ASSERT_USER_ERROR(g.IO.BackendRendererUserData == nil, "Forgot to shutdown Renderer backend?")
    for _, viewport in g.Viewports:iter() do
        IM_ASSERT_USER_ERROR(viewport.RendererUserData == nil and viewport.PlatformUserData == nil and viewport.PlatformHandle == nil, "Backend or app forgot to call DestroyPlatformWindows()?")
    end

    -- The fonts atlas can be used prior to calling NewFrame(), so we clear it even if g.Initialized is FALSE (which would happen if we never called NewFrame)
    for _, atlas in g.FontAtlases:iter() do
        ImGui.UnregisterFontAtlas(atlas)
        if atlas.OwnerContext == g then
            assert(atlas.RefCount == 0, "Destroying context owning a ImFontAtlas which is still used elsewhere!")
            if atlas.RefCount == 0 then
                atlas.Locked = false
            end
        end
    end
    g.DrawListSharedData.TempBuffer:clear()

    -- Cleanup of other data are conditional on actually having initialized Dear ImGui.
    if not g.Initialized then
        return
    end

    -- Shutdown extensions
    ImGui.DockContextShutdown(g)

    ImGui.CallContextHooks(g, 6 --[[ImGuiContextHookType.Shutdown]])

    -- Clear everything else
    -- [Luau] clear_delete()/clear_destruct() are plain clear(): the GC frees the elements
    g.Windows:clear()
    g.WindowsFocusOrder:clear()
    g.WindowsTempSortBuffer:clear()
    g.CurrentWindow = nil
    g.CurrentWindowStack:clear()
    g.WindowsById = {}
    g.NavWindow = nil
    g.HoveredWindow = nil; g.HoveredWindowUnderMovingWindow = nil
    g.ActiveIdWindow = nil
    g.MovingWindow = nil

    g.KeysRoutingTable:Clear()

    g.ColorStack:clear()
    g.StyleVarStack:clear()
    g.FontStack:clear()
    g.OpenPopupStack:clear()
    g.BeginPopupStack:clear()
    g.TreeNodeStack:clear()

    g.CurrentViewport = nil; g.MouseViewport = nil; g.MouseLastHoveredViewport = nil
    g.Viewports:clear()

    g.TabBars:Clear()
    g.CurrentTabBarStack:clear()
    g.ShrinkWidthBuffer:clear()

    g.ClipperTempData:clear()

    g.Tables:Clear()
    g.TablesTempData:clear()
    g.DrawChannelsTempMergeBuffer:clear()

    g.MultiSelectStorage:Clear()
    g.MultiSelectTempData:clear()

    g.MenusIdSubmittedThisFrame:clear()
    g.InputTextState:ClearFreeMemory()
    g.InputTextLineIndex:clear()
    g.InputTextDeactivatedState:ClearFreeMemory()

    g.SettingsWindows:clear()
    g.SettingsHandlers:clear()

    if g.LogFile ~= nil then
        if g.LogFile ~= "stdout" and ImStd.ImFileClose ~= nil then ImStd.ImFileClose(g.LogFile) end
        g.LogFile = nil
    end
    g.LogBuffer:clear()
    g.DebugLogBuf:clear()
    g.DebugLogLines = { "" }

    g.Initialized = false
end

-- When using multiple context it can be helpful to give name a name.
-- (A) Will be visible in debugger, (B) Will be included in all IMGUI_DEBUG_LOG() calls, (C) Should be <= 15 characters long.
--- @param ctx  ImGuiContext
--- @param name string
function ImGui.SetContextName(ctx, name)
    ctx.ContextName = string.sub(name, 1, 15) -- [Luau] ImStrncpy() into char[16]
end

-- No specific ordering/dependency support, will see as needed
--- @param ctx  ImGuiContext
--- @param hook ImGuiContextHook
--- @return ImGuiID
function ImGui.AddContextHook(ctx, hook)
    local g = ctx
    assert(hook.Callback ~= nil and (hook.HookId or 0) == 0 and hook.Type ~= 7 --[[ImGuiContextHookType.PendingRemoval_]])
    local copy = ImGuiContextHook() -- [Luau] g.Hooks.push_back(*hook): store a copy
    copy.Type = hook.Type; copy.Owner = hook.Owner or 0; copy.Callback = hook.Callback; copy.UserData = hook.UserData
    g.Hooks:push_back(copy)
    g.HookIdNext = g.HookIdNext + 1
    g.Hooks:back().HookId = g.HookIdNext
    return g.HookIdNext
end

-- Deferred removal, avoiding issue with changing vector while iterating it
--- @param ctx     ImGuiContext
--- @param hook_id ImGuiID
function ImGui.RemoveContextHook(ctx, hook_id)
    local g = ctx
    assert(hook_id ~= 0)
    for _, hook in g.Hooks:iter() do
        if hook.HookId == hook_id then
            hook.Type = 7 --[[ImGuiContextHookType.PendingRemoval_]]
        end
    end
end

-- Call context hooks (used by e.g. test engine)
-- We assume a small number of hooks so all stored in same array
--- @param ctx       ImGuiContext
--- @param hook_type ImGuiContextHookType
function ImGui.CallContextHooks(ctx, hook_type)
    local g = ctx
    local hooks = g.Hooks
    if hooks.Size == 0 then return end -- [Luau] fast path
    for n = 1, hooks.Size do
        local hook = hooks.Data[n]
        if hook.Type == hook_type then
            hook.Callback(g, hook)
        end
    end
end

