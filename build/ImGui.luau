        for n = 0, settings.ColumnsCount - 1 do
            local c = settings.Columns[n]
            local dir = (c.SortOrder ~= -1) and c.SortDirection or 0 --[[ImGuiSortDirection.None]]
            ImGui.BulletText("Column %d Order %d SortOrder %2d %s Vis %d %s %7.3f ID 0x%08X", n, c.DisplayOrder, c.SortOrder,
                (dir == 1 --[[ImGuiSortDirection.Ascending]]) and "Asc" or ((dir == 2 --[[ImGuiSortDirection.Descending]]) and "Des" or "---"), c.IsEnabled, (c.IsStretch ~= 0) and "Weight" or "Width ", c.WidthOrWeight, c.ID)
