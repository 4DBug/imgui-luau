            _, s.scope_flags = ImGui.CheckboxFlags("AALines", s.scope_flags, 8192 --[[ImDrawFlags.AALines]]); ImGui.SameLine()
            _, s.scope_flags = ImGui.CheckboxFlags("AALineEnds", s.scope_flags, 16384 --[[ImDrawFlags.AALineEnds]]); ImGui.SameLine()
            _, s.scope_flags = ImGui.CheckboxFlags("StrokeLegacy", s.scope_flags, 917504 --[[ImDrawFlags.StrokeLegacy]])
            --ImGui.CheckboxFlags("UseTexForRoundCorners", &scope_flags, ImDrawFlags_UseTexForRoundCorners);
            ImGui.PopID()
            ImGui.Spacing()

            draw_list:PushDrawFlag(8286704 --[[ImDrawFlags.AllowInPushScope_]], false) -- Reset all existing (very unusual: done for this demo)
