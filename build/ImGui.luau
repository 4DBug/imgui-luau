--- @param collapsed bool
--- @param cond?     ImGuiCond
function ImGui.SetNextWindowCollapsed(collapsed, cond)
    if cond == nil then cond = 0 end
    local g = GImGui
    assert(cond == 0 or ImIsPowerOfTwo(cond)) -- Make sure the user doesn't attempt to combine multiple condition flags.
    g.NextWindowData.HasFlags = bit32.bor(g.NextWindowData.HasFlags, 8 --[[ImGuiNextWindowDataFlags.HasCollapsed]])
    g.NextWindowData.CollapsedVal = collapsed
    g.NextWindowData.CollapsedCond = (cond ~= 0) and cond or 1 --[[ImGuiCond.Always]]
