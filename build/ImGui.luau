-- [Port] ImGuiTabBarFlags* p_flags -> takes flags, returns the new flags
function EditTabBarFittingPolicyFlags(p_flags)
    if bit32.band(p_flags, 896 --[[ImGuiTabBarFlags.FittingPolicyMask_]]) == 0 then
        p_flags = bit32.bor(p_flags, 128 --[[ImGuiTabBarFlags.FittingPolicyDefault_]])
    end
    local pressed
    pressed, p_flags = ImGui.CheckboxFlags("ImGuiTabBarFlags_FittingPolicyMixed", p_flags, 128 --[[ImGuiTabBarFlags.FittingPolicyMixed]])
    if pressed then
        p_flags = bit32.band(p_flags, bit32.bnot(bit32.bxor(896 --[[ImGuiTabBarFlags.FittingPolicyMask_]], 128 --[[ImGuiTabBarFlags.FittingPolicyMixed]])))
    end
    pressed, p_flags = ImGui.CheckboxFlags("ImGuiTabBarFlags_FittingPolicyShrink", p_flags, 256 --[[ImGuiTabBarFlags.FittingPolicyShrink]])
    if pressed then
        p_flags = bit32.band(p_flags, bit32.bnot(bit32.bxor(896 --[[ImGuiTabBarFlags.FittingPolicyMask_]], 256 --[[ImGuiTabBarFlags.FittingPolicyShrink]])))
    end
    pressed, p_flags = ImGui.CheckboxFlags("ImGuiTabBarFlags_FittingPolicyScroll", p_flags, 512 --[[ImGuiTabBarFlags.FittingPolicyScroll]])
    if pressed then
        p_flags = bit32.band(p_flags, bit32.bnot(bit32.bxor(896 --[[ImGuiTabBarFlags.FittingPolicyMask_]], 512 --[[ImGuiTabBarFlags.FittingPolicyScroll]])))
    end
    return p_flags
end

