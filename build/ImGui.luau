                end
                return 1
            end

            ImGui.InputText("default", s.buf1, 32)
            ImGui.InputText("decimal", s.buf2, 32, 1 --[[ImGuiInputTextFlags.CharsDecimal]])
            ImGui.InputText("hexadecimal", s.buf3, 32, bit32.bor(2 --[[ImGuiInputTextFlags.CharsHexadecimal]], 8 --[[ImGuiInputTextFlags.CharsUppercase]]))
            ImGui.InputText("uppercase", s.buf4, 32, 8 --[[ImGuiInputTextFlags.CharsUppercase]])
            ImGui.InputText("no blank", s.buf5, 32, 16 --[[ImGuiInputTextFlags.CharsNoBlank]])
            ImGui.InputText("casing swap", s.buf6, 32, 2097152 --[[ImGuiInputTextFlags.CallbackCharFilter]], TextFilters.FilterCasingSwap) -- Use CharFilter callback to replace characters.
            ImGui.InputText("\"imgui\"", s.buf7, 32, 2097152 --[[ImGuiInputTextFlags.CallbackCharFilter]], TextFilters.FilterImGuiLetters) -- Use CharFilter callback to disable some characters.
            ImGui.TreePop()
        end

        if ImGui.TreeNode("Password Input") then
            IMGUI_DEMO_MARKER("Widgets/Text Input/Password input")
            local s = S_ti.password
            ImGui.InputText("password", s.password, 64, 1024 --[[ImGuiInputTextFlags.Password]])
            ImGui.SameLine(); HelpMarker("Display all characters as '*'.\nDisable clipboard cut and copy.\nDisable logging.\n")
            ImGui.InputTextWithHint("password (w/ hint)", "<password>", s.password, 64, 1024 --[[ImGuiInputTextFlags.Password]])
            ImGui.InputText("password (clear)", s.password, 64)
            ImGui.TreePop()
        end

        if ImGui.TreeNode("Completion, History, Edit Callbacks") then
            IMGUI_DEMO_MARKER("Widgets/Text Input/Completion, History, Edit Callbacks")
            local s = S_ti.callbacks
            local Funcs = {}
            function Funcs.MyCallback(data)
                if data.EventFlag == 262144 --[[ImGuiInputTextFlags.CallbackCompletion]] then
                    data:InsertChars(data.CursorPos, "..")
                elseif data.EventFlag == 524288 --[[ImGuiInputTextFlags.CallbackHistory]] then
                    if data.EventKey == 515 --[[ImGuiKey.UpArrow]] then
                        data:DeleteChars(0, data.BufTextLen)
                        data:InsertChars(0, "Pressed Up!")
                        data:SelectAll()
                    elseif data.EventKey == 516 --[[ImGuiKey.DownArrow]] then
                        data:DeleteChars(0, data.BufTextLen)
                        data:InsertChars(0, "Pressed Down!")
                        data:SelectAll()
                    end
                elseif data.EventFlag == 8388608 --[[ImGuiInputTextFlags.CallbackEdit]] then
                    -- Toggle casing of first character
                    local c = data.Buf[1]
                    if (c >= string.byte('a') and c <= string.byte('z')) or (c >= string.byte('A') and c <= string.byte('Z')) then data.Buf[1] = bit32.bxor(data.Buf[1], 32) end
                    data.BufDirty = true

                    -- Increment a counter
                    local p_int = data.UserData -- [Port] int* -> the statics table, counter in .edit_count
                    p_int.edit_count = p_int.edit_count + 1
                end
                return 0
            end
            ImGui.InputText("Completion", s.buf1, 64, 262144 --[[ImGuiInputTextFlags.CallbackCompletion]], Funcs.MyCallback)
            ImGui.SameLine(); HelpMarker(
                "Here we append \"..\" each time Tab is pressed. " ..
                "See 'Examples>Console' for a more meaningful demonstration of using this callback.")

            ImGui.InputText("History", s.buf2, 64, 524288 --[[ImGuiInputTextFlags.CallbackHistory]], Funcs.MyCallback)
            ImGui.SameLine(); HelpMarker(
                "Here we replace and select text each time Up/Down are pressed. " ..
                "See 'Examples>Console' for a more meaningful demonstration of using this callback.")

            ImGui.InputText("Edit", s.buf3, 64, 8388608 --[[ImGuiInputTextFlags.CallbackEdit]], Funcs.MyCallback, s) -- [Port] (void*)&edit_count -> s
            ImGui.SameLine(); HelpMarker(
                "Here we toggle the casing of the first character on every edit + count edits.")
            ImGui.SameLine(); ImGui.Text("(%d)", s.edit_count)

            ImGui.TreePop()
        end

        if ImGui.TreeNode("Resize Callback") then
            IMGUI_DEMO_MARKER("Widgets/Text Input/Resize Callback")
            local s = S_ti.resize
            -- To wire InputText() with std::string or any other custom string type,
            -- you can use the ImGuiInputTextFlags_CallbackResize flag + create a custom ImGui::InputText() wrapper
            -- using your preferred type. See misc/cpp/imgui_stdlib.h for an implementation of this using std::string.
            HelpMarker(
                "Using ImGuiInputTextFlags_CallbackResize to wire your custom string type to InputText().\n\n" ..
                "See misc/cpp/imgui_stdlib.h for an implementation of this for std::string.")
            local Funcs = {}
            function Funcs.MyResizeCallback(data)
                if data.EventFlag == 4194304 --[[ImGuiInputTextFlags.CallbackResize]] then
                    local my_str = data.UserData
                    assert(my_str.Data == data.Buf)
                    my_str:resize(data.BufSize, 0) -- NB: On resizing calls, generally data->BufSize == data->BufTextLen + 1 -- [Port] new bytes filled with 0
                    data.Buf = my_str.Data
                end
                return 0
            end

            -- Note: Because ImGui:: is a namespace you would typically add your own function into the namespace.
            -- For example, you code may declare a function 'ImGui::InputText(const char* label, MyString* my_str)'
            function Funcs.MyInputTextMultiline(label, my_str, size, flags)
                if size == nil then size = ImVec2(0, 0) end
                if flags == nil then flags = 0 end
                assert(bit32.band(flags, 4194304 --[[ImGuiInputTextFlags.CallbackResize]]) == 0)
                return ImGui.InputTextMultiline(label, my_str.Data, my_str.Size, size, bit32.bor(flags, 4194304 --[[ImGuiInputTextFlags.CallbackResize]]), Funcs.MyResizeCallback, my_str)
            end

            -- For this demo we are using ImVector as a string container.
            -- Note that because we need to store a terminating zero character, our size/capacity are 1 more
            -- than usually reported by a typical string class.
            _, s.flags = ImGui.CheckboxFlags("ImGuiInputTextFlags_WordWrap", s.flags, 16777216 --[[ImGuiInputTextFlags.WordWrap]])

            local my_str = s.my_str
            if my_str:empty() then
                my_str:push_back(0)
            end
            Funcs.MyInputTextMultiline("##MyStr", my_str, ImVec2(-1.1754943508223e-38 --[[FLT_MIN]], ImGui.GetTextLineHeight() * 16), s.flags)
            ImGui.Text("Data: %s\nSize: %d\nCapacity: %d", tostring(my_str.Data), my_str.Size, my_str.Capacity) -- [Port] %p -> %s + tostring
            ImGui.TreePop()
        end

        if ImGui.TreeNode("Eliding, Alignment") then
            IMGUI_DEMO_MARKER("Widgets/Text Input/Eliding, Alignment")
            local s = S_ti.eliding
            _, s.flags = ImGui.CheckboxFlags("ImGuiInputTextFlags_ElideLeft", s.flags, 131072 --[[ImGuiInputTextFlags.ElideLeft]])
            ImGui.InputText("Path", s.buf1, 128, s.flags)
            ImGui.TreePop()
        end

        if ImGui.TreeNode("Miscellaneous") then
            IMGUI_DEMO_MARKER("Widgets/Text Input/Miscellaneous")
            local s = S_ti.misc
            _, s.flags = ImGui.CheckboxFlags("ImGuiInputTextFlags_EscapeClearsAll", s.flags, 128 --[[ImGuiInputTextFlags.EscapeClearsAll]])
            _, s.flags = ImGui.CheckboxFlags("ImGuiInputTextFlags_ReadOnly", s.flags, 512 --[[ImGuiInputTextFlags.ReadOnly]])
            _, s.flags = ImGui.CheckboxFlags("ImGuiInputTextFlags_NoUndoRedo", s.flags, 65536 --[[ImGuiInputTextFlags.NoUndoRedo]])
            ImGui.InputText("Hello", s.buf1, 16, s.flags)
            ImGui.TreePop()
        end

        ImGui.TreePop()
    end

end

