        _, s.flags = ImGui.CheckboxFlags("ImGuiComboFlags_PopupAlignLeft", s.flags, 1 --[[ImGuiComboFlags.PopupAlignLeft]])
        ImGui.SameLine(); HelpMarker("Only makes a difference if the popup is larger than the combo")
        pressed, s.flags = ImGui.CheckboxFlags("ImGuiComboFlags_NoArrowButton", s.flags, 32 --[[ImGuiComboFlags.NoArrowButton]])
        if pressed then
            s.flags = bit32.band(s.flags, bit32.bnot(64 --[[ImGuiComboFlags.NoPreview]]))     -- Clear incompatible flags
        end
        pressed, s.flags = ImGui.CheckboxFlags("ImGuiComboFlags_NoPreview", s.flags, 64 --[[ImGuiComboFlags.NoPreview]])
        if pressed then
            s.flags = bit32.band(s.flags, bit32.bnot(bit32.bor(32 --[[ImGuiComboFlags.NoArrowButton]], 128 --[[ImGuiComboFlags.WidthFitPreview]]))) -- Clear incompatible flags
        end
        pressed, s.flags = ImGui.CheckboxFlags("ImGuiComboFlags_WidthFitPreview", s.flags, 128 --[[ImGuiComboFlags.WidthFitPreview]])
        if pressed then
            s.flags = bit32.band(s.flags, bit32.bnot(64 --[[ImGuiComboFlags.NoPreview]]))
        end

        -- Override default popup height
        pressed, s.flags = ImGui.CheckboxFlags("ImGuiComboFlags_HeightSmall", s.flags, 2 --[[ImGuiComboFlags.HeightSmall]])
        if pressed then
            s.flags = bit32.band(s.flags, bit32.bnot(bit32.band(30 --[[ImGuiComboFlags.HeightMask_]], bit32.bnot(2 --[[ImGuiComboFlags.HeightSmall]]))))
        end
        pressed, s.flags = ImGui.CheckboxFlags("ImGuiComboFlags_HeightRegular", s.flags, 4 --[[ImGuiComboFlags.HeightRegular]])
        if pressed then
            s.flags = bit32.band(s.flags, bit32.bnot(bit32.band(30 --[[ImGuiComboFlags.HeightMask_]], bit32.bnot(4 --[[ImGuiComboFlags.HeightRegular]]))))
        end
        pressed, s.flags = ImGui.CheckboxFlags("ImGuiComboFlags_HeightLargest", s.flags, 16 --[[ImGuiComboFlags.HeightLargest]])
        if pressed then
            s.flags = bit32.band(s.flags, bit32.bnot(bit32.band(30 --[[ImGuiComboFlags.HeightMask_]], bit32.bnot(16 --[[ImGuiComboFlags.HeightLargest]]))))
        end

        -- Using the generic BeginCombo() API, you have full control over how to display the combo contents.
        -- (your selection data could be an index, a pointer to the object, an id for the object, a flag intrusively
        -- stored in the object itself, etc.)
        local items = { "AAAA", "BBBB", "CCCC", "DDDD", "EEEE", "FFFF", "GGGG", "HHHH", "IIII", "JJJJ", "KKKK", "LLLLLLL", "MMMM", "OOOOOOO" }

        -- Pass in the preview value visible before opening the combo (it could technically be different contents or not pulled from items[])
        local combo_preview_value = items[s.item_selected_idx + 1]
        if ImGui.BeginCombo("combo 1", combo_preview_value, s.flags) then
            for n = 0, #items - 1 do
                local is_selected = (s.item_selected_idx == n)
                if ImGui.Selectable(items[n + 1], is_selected) then
                    s.item_selected_idx = n
                end

                -- Set the initial focus when opening the combo (scrolling + keyboard navigation focus)
                if is_selected then
                    ImGui.SetItemDefaultFocus()
                end
            end
            ImGui.EndCombo()
        end

        -- Show case embedding a filter using a simple trick: displaying the filter inside combo contents.
        -- See https://github.com/ocornut/imgui/issues/718 for advanced/esoteric alternatives.
        if ImGui.BeginCombo("combo 2 (w/ filter)", combo_preview_value, s.flags) then
            if s.filter == nil then s.filter = ImGuiTextFilter() end
            local filter = s.filter
            if ImGui.IsWindowAppearing() then
                ImGui.SetKeyboardFocusHere()
                filter:Clear()
            end
            ImGui.SetNextItemShortcut(bit32.bor(4096 --[[ImGuiMod_Ctrl]], 551 --[[ImGuiKey.F]]))
            ImGui.SetNextItemWidth(-1.1754943508223e-38 --[[FLT_MIN]])
            filter:DrawWithHint("##Filter", "Filter (incl -excl)")

            for n = 0, #items - 1 do
                local is_selected = (s.item_selected_idx == n)
                if filter:PassFilter(items[n + 1]) then
                    if ImGui.Selectable(items[n + 1], is_selected) then
                        s.item_selected_idx = n
                    end
                end
            end
            ImGui.EndCombo()
        end

        ImGui.Spacing()
        ImGui.SeparatorText("One-liner variants")
        HelpMarker("The Combo() function is not greatly useful apart from cases were you want to embed all options in a single strings.\nFlags above don't apply to this section.")

        -- Simplified one-liner Combo() API, using values packed in a single constant string
        -- This is a convenience for when the selection set is small and known at compile-time.
        s.item_current_2 = ImGui.Combo("combo 3 (one-liner)", s.item_current_2, "aaaa\0bbbb\0cccc\0dddd\0eeee\0\0")

        -- Simplified one-liner Combo() using an array of const char*
        -- This is not very useful (may obsolete): prefer using BeginCombo()/EndCombo() for full control.
        s.item_current_3 = ImGui.Combo("combo 4 (array)", s.item_current_3, items, #items)

        -- Simplified one-liner Combo() using an accessor function
        s.item_current_4 = ImGui.Combo("combo 5 (function)", s.item_current_4, function(data, n) return data[n + 1] end, items, #items)

        ImGui.TreePop()
    end
end

