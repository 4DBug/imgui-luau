--- @param name? string
function ImGui.SetWindowFocus(...)
    if select("#", ...) == 0 then
        ImGui.FocusWindow(GImGui.CurrentWindow)
        return
    end
    local name = ...
    if name then
        local window = ImGui.FindWindowByName(name)
        if window then
            ImGui.FocusWindow(window)
