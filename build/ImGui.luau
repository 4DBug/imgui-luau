-- [DEBUG] Display contents of ImDrawList
-- Note that both 'window' and 'viewport' may be nil here. Viewport is generally nil of destroyed popups which previously owned a viewport.
function ImGui.DebugNodeDrawList(window, viewport, draw_list, label)
    local g = ImGui.GetCurrentContext()
    local cfg = g.DebugMetricsConfig
    local cmd_count = draw_list.CmdBuffer.Size
    if cmd_count > 0 and draw_list.CmdBuffer.Data[cmd_count].ElemCount == 0 and draw_list.CmdBuffer.Data[cmd_count].UserCallback == nil then
        cmd_count = cmd_count - 1
    end
    local node_open = ImGui.TreeNode(tostring(draw_list), "%s: '%s' %d vtx, %d indices, %d cmds", label, draw_list._OwnerName or "", draw_list.VtxBuffer.Size, draw_list.IdxBuffer.Size, cmd_count)
    if draw_list == ImGui.GetWindowDrawList() then
        ImGui.SameLine()
        ImGui.TextColored(ImVec4(1.0, 0.4, 0.4, 1.0), "CURRENTLY APPENDING") -- Can't display stats for active draw list! (we don't have the data double-buffered)
        if node_open then ImGui.TreePop() end
        return
    end
    local fg_draw_list = viewport and ImGui.GetForegroundDrawList(viewport) or nil -- Render additional visuals into the top-most draw list
    if window and ImGui.IsItemHovered() and fg_draw_list then
        fg_draw_list:AddRect(window.Pos, window.Pos + window.Size, IM_COL32(255, 255, 0, 255))
    end
    if not node_open then return end
    if window and not window.WasActive then ImGui.TextDisabled("Warning: owning Window is inactive. This DrawList is not being rendered!") end

    for cmd_n = 1, cmd_count do repeat
        local pcmd = draw_list.CmdBuffer.Data[cmd_n]
        if pcmd.UserCallback then
            ImGui.BulletText("Callback %s, user_data %s", tostring(pcmd.UserCallback), tostring(pcmd.UserCallbackData))
            break -- [Port] continue
        end

        local texid_desc = FormatTextureRefForDebugDisplay(pcmd.TexRef)
        local cr = pcmd.ClipRect
        local buf = string.format("DrawCmd:%5d tris, Tex %s, ClipRect (%4.0f,%4.0f)-(%4.0f,%4.0f)",
            math.floor(pcmd.ElemCount / 3), texid_desc, cr.x, cr.y, cr.z, cr.w)
        local pcmd_node_open = ImGui.TreeNode(cmd_n - 1, "%s", buf)
        if ImGui.IsItemHovered() and (cfg.ShowDrawCmdMesh or cfg.ShowDrawCmdBoundingBoxes) and fg_draw_list then
            ImGui.DebugNodeDrawCmdShowMeshAndBoundingBox(fg_draw_list, draw_list, pcmd, cfg.ShowDrawCmdMesh, cfg.ShowDrawCmdBoundingBoxes)
        end
        if not pcmd_node_open then
            break -- [Port] continue
        end

        -- Calculate approximate coverage area (touched pixel count)
        -- This will be in pixels squared as long there's no post-scaling happening to the renderer output.
        -- [Luau] index values are 1-based vertex indices relative to VtxOffset (see ImDrawVtx_Pos())
        local idx_buffer = draw_list.IdxBuffer.Data
        local vtx_buffer = draw_list.VtxBuffer.Buf
        local total_area = 0.0
        local idx_n = pcmd.IdxOffset
        while idx_n < pcmd.IdxOffset + pcmd.ElemCount do
            local triangle = {}
            for n = 1, 3 do
                triangle[n] = ImVec2(ImDrawVtx_Pos(vtx_buffer, idx_buffer[idx_n + 1] + pcmd.VtxOffset))
                idx_n = idx_n + 1
            end
            total_area = total_area + ImTriangleArea(triangle[1], triangle[2], triangle[3])
        end

        -- Display vertex information summary. Hover to get all triangles drawn in wire-frame
        buf = string.format("Mesh: ElemCount: %d, VtxOffset: +%d, IdxOffset: +%d, Area: ~%0.f px", pcmd.ElemCount, pcmd.VtxOffset, pcmd.IdxOffset, total_area)
        ImGui.Selectable(buf)
        if ImGui.IsItemHovered() and fg_draw_list then
            ImGui.DebugNodeDrawCmdShowMeshAndBoundingBox(fg_draw_list, draw_list, pcmd, true, false)
        end

        -- Display individual triangles/vertices. Hover on to get the corresponding triangle highlighted.
        local clipper = ImGuiListClipper()
        clipper:Begin(math.floor(pcmd.ElemCount / 3)) -- Manually coarse clip our print out of individual vertices to save CPU, only items that may be visible.
        while clipper:Step() do
            local idx_i = pcmd.IdxOffset + clipper.DisplayStart * 3
            for prim = clipper.DisplayStart, clipper.DisplayEnd - 1 do
                local lines = {}
                local triangle = {}
                for n = 1, 3 do
                    local vi = idx_buffer[idx_i + 1] + pcmd.VtxOffset
                    local o = (vi - 1) * 36 --[[VTX_STRIDE]] -- [Luau] packed vertex: f64 pos.x, pos.y, uv.x, uv.y, u32 col
                    local px, py = ImDrawVtx_Pos(vtx_buffer, vi)
                    triangle[n] = ImVec2(px, py)
                    lines[n] = string.format("%s %04d: pos (%8.2f,%8.2f), uv (%.6f,%.6f), col %08X\n",
                        (n == 1) and "Vert:" or "     ", idx_i, px, py, buffer.readf64(vtx_buffer, o + 16), buffer.readf64(vtx_buffer, o + 24), ImDrawVtx_Col(vtx_buffer, vi))
                    idx_i = idx_i + 1
                end

                ImGui.Selectable(table.concat(lines), false)
                if fg_draw_list and ImGui.IsItemHovered() then
                    fg_draw_list:PushDrawFlag(8192 --[[ImDrawFlags.AALines]], false) -- Disable AA on triangle outlines is more readable for very large and thin triangles.
                    fg_draw_list:AddPolyline(triangle, 3, IM_COL32(255, 255, 0, 255), 1.0, 512 --[[ImDrawFlags.Closed]])
                    fg_draw_list:PopDrawFlag()
                end
            end
        end
        ImGui.TreePop()
    until true end
    ImGui.TreePop()
end

-- [DEBUG] Display mesh/aabb of a ImDrawCmd
--- @param out_draw_list ImDrawList
--- @param draw_list     ImDrawList
--- @param draw_cmd      ImDrawCmd
--- @param show_mesh     bool
--- @param show_aabb     bool
function ImGui.DebugNodeDrawCmdShowMeshAndBoundingBox(out_draw_list, draw_list, draw_cmd, show_mesh, show_aabb)
    assert(show_mesh or show_aabb)

    -- Draw wire-frame version of all triangles
    local cr = draw_cmd.ClipRect
    local clip_rect = ImRect(cr.x, cr.y, cr.z, cr.w)
    local vtxs_rect = ImRect(3.4028234663853e+38 --[[FLT_MAX]], 3.4028234663853e+38 --[[FLT_MAX]], -3.4028234663853e+38 --[[FLT_MAX]], -3.4028234663853e+38 --[[FLT_MAX]])
    out_draw_list:PushDrawFlag(8192 --[[ImDrawFlags.AALines]], false) -- Disable AA on triangle outlines is more readable for very large and thin triangles.
    local idx_n, idx_end = draw_cmd.IdxOffset, draw_cmd.IdxOffset + draw_cmd.ElemCount
    while idx_n < idx_end do
        local idx_buffer = draw_list.IdxBuffer.Data -- We don't hold on those pointers past iterations as ->AddPolyline() may invalidate them if out_draw_list==draw_list
        local vtx_buffer = draw_list.VtxBuffer.Buf

        local triangle = {}
        for n = 1, 3 do
            triangle[n] = ImVec2(ImDrawVtx_Pos(vtx_buffer, idx_buffer[idx_n + 1] + draw_cmd.VtxOffset))
            vtxs_rect:Add(triangle[n])
            idx_n = idx_n + 1
        end
        if show_mesh then
            out_draw_list:AddPolyline(triangle, 3, IM_COL32(255, 255, 0, 255), 1.0, 512 --[[ImDrawFlags.Closed]]) -- In yellow: mesh triangles
        end
    end
    -- Draw bounding boxes
    if show_aabb then
        out_draw_list:AddRect(ImTrunc(clip_rect.Min), ImTrunc(clip_rect.Max), IM_COL32(255, 0, 255, 255)) -- In pink: clipping rectangle submitted to GPU
        out_draw_list:AddRect(ImTrunc(vtxs_rect.Min), ImTrunc(vtxs_rect.Max), IM_COL32(0, 255, 255, 255)) -- In cyan: bounding box of triangles
    end
    out_draw_list:PopDrawFlag()
end

-- [DEBUG] Display contents of ImGuiTabBar
function ImGui.DebugNodeTabBar(tab_bar, label)
    -- Standalone tab bars (not associated to docking/windows functionality) currently hold no discernible strings.
    local g = ImGui.GetCurrentContext()
    local is_active = (tab_bar.PrevFrameVisible >= ImGui.GetFrameCount() - 2)
    local names = {}
    for tab_n = 1, math.min(tab_bar.Tabs.Size, 3) do
        local tab = tab_bar.Tabs.Data[tab_n]
        names[#names + 1] = "'" .. (ImGui.TabBarGetTabName and ImGui.TabBarGetTabName(tab_bar, tab) or "?") .. "'"
    end
    local buf = string.format("%s 0x%08X (%d tabs)%s  { %s%s", label, tab_bar.ID, tab_bar.Tabs.Size, is_active and "" or " *Inactive*", table.concat(names, ", "), (tab_bar.Tabs.Size > 3) and " ... }" or " } ")
    if not is_active then ImGui.PushStyleColor(0 --[[ImGuiCol.Text]], g.Style.Colors[1 --[[ImGuiCol.TextDisabled]]]) end
    local open = ImGui.TreeNode(label, "%s", buf)
    if not is_active then ImGui.PopStyleColor() end
    if is_active and ImGui.IsItemHovered() then
        local dl = FG(tab_bar.Window)
        dl:AddRect(tab_bar.BarRect.Min, tab_bar.BarRect.Max, IM_COL32(255, 255, 0, 255))
        dl:AddLineV(tab_bar.ScrollingRectMinX, tab_bar.BarRect.Min.y, tab_bar.BarRect.Max.y, IM_COL32(0, 255, 0, 255))
        dl:AddLineV(tab_bar.ScrollingRectMaxX, tab_bar.BarRect.Min.y, tab_bar.BarRect.Max.y, IM_COL32(0, 255, 0, 255))
    end
    if open then
        for tab_n, tab in tab_bar.Tabs:iter() do
            ImGui.PushID(tab_n)
            if ImGui.SmallButton("<") and ImGui.TabBarQueueReorder then ImGui.TabBarQueueReorder(tab_bar, tab, -1) end ImGui.SameLine(0, 2)
            if ImGui.SmallButton(">") and ImGui.TabBarQueueReorder then ImGui.TabBarQueueReorder(tab_bar, tab, 1) end ImGui.SameLine()
            ImGui.Text("%02d%s Tab 0x%08X '%s' Offset: %.2f, Width: %.2f/%.2f", tab_n - 1, (tab.ID == tab_bar.SelectedTabId) and "*" or " ", tab.ID,
                ImGui.TabBarGetTabName and ImGui.TabBarGetTabName(tab_bar, tab) or "?", tab.Offset, tab.Width, tab.ContentWidth)
            ImGui.PopID()
        end
        ImGui.TreePop()
    end
end

