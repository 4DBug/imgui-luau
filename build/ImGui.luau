                    if ImGui.IsItemFocused() then
                        -- FIXME-MULTISELECT: Dual List Box: Transfer focus
                        if ImGui.IsKeyPressed(525 --[[ImGuiKey.Enter]]) or ImGui.IsKeyPressed(627 --[[ImGuiKey.KeypadEnter]]) then
                            request_move_selected = side
