                child_visible = ImGui.BeginChild("0", ImVec2(-1.1754943508223e-38 --[[FLT_MIN]], ImGui.GetFontSize() * 20), bit32.bor(128 --[[ImGuiChildFlags.FrameStyle]], 8 --[[ImGuiChildFlags.ResizeY]]))
                child_height_0 = ImGui.GetWindowSize().y
