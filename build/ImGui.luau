            ImVec2_Copy(window.SetWindowPosVal, g.NextWindowData.PosVal)
            ImVec2_Copy(window.SetWindowPosPivot, g.NextWindowData.PosPivotVal)
            window.SetWindowPosAllowFlags = bit32.band(window.SetWindowPosAllowFlags, bit32.bnot(bit32.bor(2 --[[ImGuiCond.Once]], 4 --[[ImGuiCond.FirstUseEver]], 8 --[[ImGuiCond.Appearing]])))
        else
