S.DemoWindowWidgetsColorAndPickers = {
    color = ImVec4(114.0 / 255.0, 144.0 / 255.0, 154.0 / 255.0, 200.0 / 255.0),
    base_flags = ImGuiColorEditFlags.None,
    saved_palette_init = true,
    saved_palette = {}, -- [Port] 32 x ImVec4, 1-based
    backup_color = ImVec4(),
    no_border = false,
    ref_color = false,
    ref_color_v = ImVec4(1.0, 0.0, 1.0, 0.5),
    picker_mode = 0,
    display_mode = 0,
    color_picker_flags = ImGuiColorEditFlags.AlphaBar,
    color_hsv = ImVec4(0.23, 1.0, 1.0, 1.0), -- Stored as HSV!
}

function DemoWindowWidgetsColorAndPickers()
    local _
    if ImGui.TreeNode("Color/Picker Widgets") then
        local s = S.DemoWindowWidgetsColorAndPickers
        IMGUI_DEMO_MARKER("Widgets/Color")
        local color = s.color

        ImGui.SeparatorText("Options")
        _, s.base_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_NoAlpha", s.base_flags, 2 --[[ImGuiColorEditFlags.NoAlpha]])
        _, s.base_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_AlphaOpaque", s.base_flags, 4096 --[[ImGuiColorEditFlags.AlphaOpaque]])
        _, s.base_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_AlphaNoBg", s.base_flags, 8192 --[[ImGuiColorEditFlags.AlphaNoBg]])
        _, s.base_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_AlphaPreviewHalf", s.base_flags, 16384 --[[ImGuiColorEditFlags.AlphaPreviewHalf]])
        _, s.base_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_NoOptions", s.base_flags, 8 --[[ImGuiColorEditFlags.NoOptions]]); ImGui.SameLine(); HelpMarker("Right-click on the individual color widget to show options.")
        _, s.base_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_NoDragDrop", s.base_flags, 512 --[[ImGuiColorEditFlags.NoDragDrop]])
        _, s.base_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_NoColorMarkers", s.base_flags, 2048 --[[ImGuiColorEditFlags.NoColorMarkers]])
        _, s.base_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_HDR", s.base_flags, 524288 --[[ImGuiColorEditFlags.HDR]]); ImGui.SameLine(); HelpMarker("Currently all this does is to lift the 0..1 limits on dragging widgets.")
        local base_flags = s.base_flags

        IMGUI_DEMO_MARKER("Widgets/Color/ColorEdit")
        ImGui.SeparatorText("Inline color editor")
        ImGui.Text("Color widget:")
        ImGui.SameLine(); HelpMarker(
            "Click on the color square to open a color picker.\n" ..
            "Ctrl+Click on individual component to input value.\n")
        ImGui.ColorEdit3("MyColor##1", color, base_flags)

        IMGUI_DEMO_MARKER("Widgets/Color/ColorEdit (HSV, with Alpha)")
        ImGui.Text("Color widget HSV with Alpha:")
        ImGui.ColorEdit4("MyColor##2", color, bit32.bor(2097152 --[[ImGuiColorEditFlags.DisplayHSV]], base_flags))

        IMGUI_DEMO_MARKER("Widgets/Color/ColorEdit (float display)")
        ImGui.Text("Color widget with Float Display:")
        ImGui.ColorEdit4("MyColor##2f", color, bit32.bor(16777216 --[[ImGuiColorEditFlags.Float]], base_flags))

        IMGUI_DEMO_MARKER("Widgets/Color/ColorButton (with Picker)")
        ImGui.Text("Color button with Picker:")
        ImGui.SameLine(); HelpMarker(
            "With the ImGuiColorEditFlags_NoInputs flag you can hide all the slider/text inputs.\n" ..
            "With the ImGuiColorEditFlags_NoLabel flag you can pass a non-empty label which will only " ..
            "be used for the tooltip and picker popup.")
        ImGui.ColorEdit4("MyColor##3", color, bit32.bor(32 --[[ImGuiColorEditFlags.NoInputs]], 128 --[[ImGuiColorEditFlags.NoLabel]], base_flags))

        IMGUI_DEMO_MARKER("Widgets/Color/ColorButton (with custom Picker popup)")
        ImGui.Text("Color button with Custom Picker Popup:")

        -- Generate a default palette. The palette will persist and can be edited.
        local saved_palette = s.saved_palette
        if s.saved_palette_init then
            for n = 0, 32 - 1 do
                saved_palette[n + 1] = ImVec4()
                saved_palette[n + 1].x, saved_palette[n + 1].y, saved_palette[n + 1].z = ImGui.ColorConvertHSVtoRGB(n / 31.0, 0.8, 0.8)
                saved_palette[n + 1].w = 1.0 -- Alpha
            end
            s.saved_palette_init = false
        end

        local open_popup = ImGui.ColorButton("MyColor##3b", color, base_flags)
        ImGui.SameLine(0, ImGui.GetStyle().ItemInnerSpacing.x)
        open_popup = ImGui.Button("Palette") or open_popup
        if open_popup then
            ImGui.OpenPopup("mypicker")
            ImVec4_Copy(s.backup_color, color)
        end
        if ImGui.BeginPopup("mypicker") then
            ImGui.Text("MY CUSTOM COLOR PICKER WITH AN AMAZING PALETTE!")
            ImGui.Separator()
            ImGui.ColorPicker4("##picker", color, bit32.bor(base_flags, 256 --[[ImGuiColorEditFlags.NoSidePreview]], 16 --[[ImGuiColorEditFlags.NoSmallPreview]]))
            ImGui.SameLine()

            ImGui.BeginGroup() -- Lock X position
            ImGui.Text("Current")
            ImGui.ColorButton("##current", color, bit32.bor(4 --[[ImGuiColorEditFlags.NoPicker]], 16384 --[[ImGuiColorEditFlags.AlphaPreviewHalf]]), ImVec2(60, 40))
            ImGui.Text("Previous")
            if ImGui.ColorButton("##previous", s.backup_color, bit32.bor(4 --[[ImGuiColorEditFlags.NoPicker]], 16384 --[[ImGuiColorEditFlags.AlphaPreviewHalf]]), ImVec2(60, 40)) then
                ImVec4_Copy(color, s.backup_color)
            end
            ImGui.Separator()
            ImGui.Text("Palette")
            for n = 0, #saved_palette - 1 do
                ImGui.PushID(n)
                if (n % 8) ~= 0 then
                    ImGui.SameLine(0.0, ImGui.GetStyle().ItemSpacing.y)
                end

                local palette_button_flags = bit32.bor(2 --[[ImGuiColorEditFlags.NoAlpha]], 4 --[[ImGuiColorEditFlags.NoPicker]], 64 --[[ImGuiColorEditFlags.NoTooltip]])
                if ImGui.ColorButton("##palette", saved_palette[n + 1], palette_button_flags, ImVec2(20, 20)) then
                    color.x, color.y, color.z = saved_palette[n + 1].x, saved_palette[n + 1].y, saved_palette[n + 1].z -- Preserve alpha!
                end

                -- Allow user to drop colors into each palette entry. Note that ColorButton() is already a
                -- drag source by default, unless specifying the ImGuiColorEditFlags_NoDragDrop flag.
                if ImGui.BeginDragDropTarget() then
                    local payload = ImGui.AcceptDragDropPayload(IMGUI_PAYLOAD_TYPE_COLOR_3F)
                    if payload then
                        local d = payload.Data -- [Port] memcpy -> copy components (Data is a 1-based float array)
                        saved_palette[n + 1].x, saved_palette[n + 1].y, saved_palette[n + 1].z = d[1], d[2], d[3]
                    end
                    payload = ImGui.AcceptDragDropPayload(IMGUI_PAYLOAD_TYPE_COLOR_4F)
                    if payload then
                        local d = payload.Data -- [Port] memcpy -> copy components
                        saved_palette[n + 1].x, saved_palette[n + 1].y, saved_palette[n + 1].z, saved_palette[n + 1].w = d[1], d[2], d[3], d[4]
                    end
                    ImGui.EndDragDropTarget()
                end

                ImGui.PopID()
            end
            ImGui.EndGroup()
            ImGui.EndPopup()
        end

        IMGUI_DEMO_MARKER("Widgets/Color/ColorButton (simple)")
        ImGui.Text("Color button only:")
        _, s.no_border = ImGui.Checkbox("ImGuiColorEditFlags_NoBorder", s.no_border)
        ImGui.ColorButton("MyColor##3c", color, bit32.bor(base_flags, s.no_border and 1024 --[[ImGuiColorEditFlags.NoBorder]] or 0), ImVec2(80, 80))

        IMGUI_DEMO_MARKER("Widgets/Color/ColorPicker")
        ImGui.SeparatorText("Color picker")

        ImGui.PushID("Color picker")
        _, s.color_picker_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_NoAlpha", s.color_picker_flags, 2 --[[ImGuiColorEditFlags.NoAlpha]])
        _, s.color_picker_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_AlphaBar", s.color_picker_flags, 262144 --[[ImGuiColorEditFlags.AlphaBar]])
        _, s.color_picker_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_NoSidePreview", s.color_picker_flags, 256 --[[ImGuiColorEditFlags.NoSidePreview]])
        if bit32.band(s.color_picker_flags, 256 --[[ImGuiColorEditFlags.NoSidePreview]]) ~= 0 then
            ImGui.SameLine()
            _, s.ref_color = ImGui.Checkbox("With Ref Color", s.ref_color)
            if s.ref_color then
                ImGui.SameLine()
                ImGui.ColorEdit4("##RefColor", s.ref_color_v, bit32.bor(32 --[[ImGuiColorEditFlags.NoInputs]], base_flags))
            end
        end
        _, s.color_picker_flags = ImGui.CheckboxFlags("ImGuiColorEditFlags_PickerNoRotate", s.color_picker_flags, 134217728 --[[ImGuiColorEditFlags.PickerNoRotate]])

        s.picker_mode = ImGui.Combo("Picker Mode", s.picker_mode, "Auto/Current\0ImGuiColorEditFlags_PickerHueBar\0ImGuiColorEditFlags_PickerHueWheel\0")
        ImGui.SameLine(); HelpMarker("When not specified explicitly, user can right-click the picker to change mode.")

        s.display_mode = ImGui.Combo("Display Mode", s.display_mode, "Auto/Current\0ImGuiColorEditFlags_NoInputs\0ImGuiColorEditFlags_DisplayRGB\0ImGuiColorEditFlags_DisplayHSV\0ImGuiColorEditFlags_DisplayHex\0")
        ImGui.SameLine(); HelpMarker(
            "ColorEdit defaults to displaying RGB inputs if you don't specify a display mode, " ..
            "but the user can change it with a right-click on those inputs.\n\nColorPicker defaults to displaying RGB+HSV+Hex " ..
            "if you don't specify a display mode.\n\nYou can change the defaults using io.ConfigColorEditFlags.")

        local flags = bit32.bor(base_flags, s.color_picker_flags)
        if s.picker_mode == 1 then  flags = bit32.bor(flags, 33554432 --[[ImGuiColorEditFlags.PickerHueBar]]) end
        if s.picker_mode == 2 then  flags = bit32.bor(flags, 67108864 --[[ImGuiColorEditFlags.PickerHueWheel]]) end
        if s.display_mode == 1 then flags = bit32.bor(flags, 32 --[[ImGuiColorEditFlags.NoInputs]]) end       -- Disable all RGB/HSV/Hex displays
        if s.display_mode == 2 then flags = bit32.bor(flags, 1048576 --[[ImGuiColorEditFlags.DisplayRGB]]) end     -- Override display mode
        if s.display_mode == 3 then flags = bit32.bor(flags, 2097152 --[[ImGuiColorEditFlags.DisplayHSV]]) end
        if s.display_mode == 4 then flags = bit32.bor(flags, 4194304 --[[ImGuiColorEditFlags.DisplayHex]]) end
        ImGui.ColorPicker4("MyColor##4", color, flags, s.ref_color and s.ref_color_v or nil)

        ImGui.Text("Set defaults in code:")
        ImGui.SameLine(); HelpMarker(
            "io.ConfigColorEditFlags is designed to allow you to set boot-time default.\n" ..
            "We don't have Push/Pop functions because you can force options on a per-widget basis if needed, " ..
            "and the user can change non-forced ones with the options menu.\nWe don't have a getter to avoid " ..
            "encouraging you to persistently save values that aren't forward-compatible.")
        if ImGui.Button("Overwrite default: Uint8 + HSV + Hue Bar") then
            ImGui.GetIO().ConfigColorEditFlags = bit32.bor(8388608 --[[ImGuiColorEditFlags.Uint8]], 2097152 --[[ImGuiColorEditFlags.DisplayHSV]], 33554432 --[[ImGuiColorEditFlags.PickerHueBar]], 268435456 --[[ImGuiColorEditFlags.InputRGB]]) -- [Port] + InputRGB: without it ColorEdit4's InputMask_ power-of-two assert trips
        end
        if ImGui.Button("Overwrite default: Float + HDR + Hue Wheel") then
            ImGui.GetIO().ConfigColorEditFlags = bit32.bor(16777216 --[[ImGuiColorEditFlags.Float]], 524288 --[[ImGuiColorEditFlags.HDR]], 67108864 --[[ImGuiColorEditFlags.PickerHueWheel]], 1048576 --[[ImGuiColorEditFlags.DisplayRGB]], 268435456 --[[ImGuiColorEditFlags.InputRGB]]) -- [Port] + DisplayRGB + InputRGB: same asserts (DisplayMask_/InputMask_)
        end

        -- Always display a small version of both types of pickers
        -- (that's in order to make it more visible in the demo to people who are skimming quickly through it)
        ImGui.Text("Both types:")
        local w = (ImGui.GetContentRegionAvail().x - ImGui.GetStyle().ItemSpacing.y) * 0.40
        ImGui.SetNextItemWidth(w)
        ImGui.ColorPicker3("##MyColor##5", color, bit32.bor(33554432 --[[ImGuiColorEditFlags.PickerHueBar]], 256 --[[ImGuiColorEditFlags.NoSidePreview]], 32 --[[ImGuiColorEditFlags.NoInputs]], 2 --[[ImGuiColorEditFlags.NoAlpha]]))
        ImGui.SameLine()
        ImGui.SetNextItemWidth(w)
        ImGui.ColorPicker3("##MyColor##6", color, bit32.bor(67108864 --[[ImGuiColorEditFlags.PickerHueWheel]], 256 --[[ImGuiColorEditFlags.NoSidePreview]], 32 --[[ImGuiColorEditFlags.NoInputs]], 2 --[[ImGuiColorEditFlags.NoAlpha]]))
        ImGui.PopID()

        -- HSV encoded support (to avoid RGB<>HSV round trips and singularities when S==0 or V==0)
        local color_hsv = s.color_hsv -- Stored as HSV!
        ImGui.Spacing()
        ImGui.Text("HSV encoded colors")
        ImGui.SameLine(); HelpMarker(
            "By default, colors are given to ColorEdit and ColorPicker in RGB, but ImGuiColorEditFlags_InputHSV " ..
            "allows you to store colors as HSV and pass them to ColorEdit and ColorPicker as HSV. This comes with the " ..
            "added benefit that you can manipulate hue values with the picker even when saturation or value are zero.")
        ImGui.Text("Color widget with InputHSV:")
        ImGui.ColorEdit4("HSV shown as RGB##1", color_hsv, bit32.bor(1048576 --[[ImGuiColorEditFlags.DisplayRGB]], 536870912 --[[ImGuiColorEditFlags.InputHSV]], 16777216 --[[ImGuiColorEditFlags.Float]]))
        ImGui.ColorEdit4("HSV shown as HSV##1", color_hsv, bit32.bor(2097152 --[[ImGuiColorEditFlags.DisplayHSV]], 536870912 --[[ImGuiColorEditFlags.InputHSV]], 16777216 --[[ImGuiColorEditFlags.Float]]))
        ImGui.DragFloat4("Raw HSV values", color_hsv, 0.01, 0.0, 1.0)

        ImGui.TreePop()
    end
end

