        end
        window.WindowPadding = style.WindowPadding
        if not window.DockIsActive and (bit32.band(flags, 16777216 --[[ImGuiWindowFlags.ChildWindow]]) ~= 0) and (bit32.band(flags, 67108864 --[[ImGuiWindowFlags.Popup]]) == 0) and (bit32.band(window.ChildFlags, 2 --[[ImGuiChildFlags.AlwaysUseWindowPadding]]) == 0) and window.WindowBorderSize == 0.0 then
