-- Bias scoring rect ahead of scoring + update preferred pos (if missing) using source position
--- @param r                 ImRect
--- @param preferred_pos_rel ImVec2
--- @param move_dir          ImGuiDir
--- @param move_flags        ImGuiNavMoveFlags
function ImGui.NavBiasScoringRect(r, preferred_pos_rel, move_dir, move_flags)
    -- Bias initial rect
    local g = GImGui
    local rel_to_abs_offset = g.NavWindow.DC.CursorStartPos

    -- Initialize bias on departure if we don't have any. So mouse-click + arrow will record bias.
    -- - We default to L/U bias, so moving down from a large source item into several columns will land on left-most column.
    -- - But each successful move sets new bias on one axis, only cleared when using mouse.
    if bit32.band(move_flags, 128 --[[ImGuiNavMoveFlags.Forwarded]]) == 0 then
        if preferred_pos_rel.x == 3.4028234663853e+38 --[[FLT_MAX]] then
            preferred_pos_rel.x = ImMin(r.Min.x + 1.0, r.Max.x) - rel_to_abs_offset.x
        end
        if preferred_pos_rel.y == 3.4028234663853e+38 --[[FLT_MAX]] then
            preferred_pos_rel.y = r:GetCenter().y - rel_to_abs_offset.y
        end
    end

    -- Apply general bias on the other axis
    if (move_dir == 2 --[[ImGuiDir.Up]] or move_dir == 3 --[[ImGuiDir.Down]]) and preferred_pos_rel.x ~= 3.4028234663853e+38 --[[FLT_MAX]] then
        local new_x = preferred_pos_rel.x + rel_to_abs_offset.x
        r.Min.x = new_x; r.Max.x = new_x
    elseif (move_dir == 0 --[[ImGuiDir.Left]] or move_dir == 1 --[[ImGuiDir.Right]]) and preferred_pos_rel.y ~= 3.4028234663853e+38 --[[FLT_MAX]] then
        local new_y = preferred_pos_rel.y + rel_to_abs_offset.y
        r.Min.y = new_y; r.Max.y = new_y
    end
end

-- Handle PageUp/PageDown/Home/End keys
-- Called from NavUpdateCreateMoveRequest() which will use our output to create a move request
-- FIXME-NAV: This doesn't work properly with NavFlattened siblings as we use NavWindow rectangle for reference
-- FIXME-NAV: how to get Home/End to aim at the beginning/end of a 2D grid?
--- @return float
function ImGui.NavUpdatePageUpPageDown()
    local g = GImGui
    local window = g.NavWindow
    if bit32.band(window.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) ~= 0 or g.NavWindowingTarget ~= nil then
        return 0.0
    end

    local page_up_held = ImGui.IsKeyDown(517 --[[ImGuiKey.PageUp]], 4294967295 --[[ImGuiKeyOwner_NoOwner]])
    local page_down_held = ImGui.IsKeyDown(518 --[[ImGuiKey.PageDown]], 4294967295 --[[ImGuiKeyOwner_NoOwner]])
    local home_pressed = ImGui.IsKeyPressedEx(519 --[[ImGuiKey.Home]], 1 --[[ImGuiInputFlags.Repeat]], 4294967295 --[[ImGuiKeyOwner_NoOwner]])
    local end_pressed = ImGui.IsKeyPressedEx(520 --[[ImGuiKey.End]], 1 --[[ImGuiInputFlags.Repeat]], 4294967295 --[[ImGuiKeyOwner_NoOwner]])
    if page_up_held == page_down_held and home_pressed == end_pressed then -- Proceed if either (not both) are pressed, otherwise early out
        return 0.0
    end

    if g.NavLayer ~= 0 --[[ImGuiNavLayer.Main]] then
        ImGui.NavRestoreLayer(0 --[[ImGuiNavLayer.Main]])
    end

    if bit32.band(window.DC.NavLayersActiveMask, bit32.lshift(1, 0 --[[ImGuiNavLayer.Main]])) == 0 and window.DC.NavWindowHasScrollY then
        -- Fallback manual-scroll when window has no navigable item
        if ImGui.IsKeyPressedEx(517 --[[ImGuiKey.PageUp]], 1 --[[ImGuiInputFlags.Repeat]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) then
            ImGui.SetScrollY(window, window.Scroll.y - window.InnerRect:GetHeight())
        elseif ImGui.IsKeyPressedEx(518 --[[ImGuiKey.PageDown]], 1 --[[ImGuiInputFlags.Repeat]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) then
            ImGui.SetScrollY(window, window.Scroll.y + window.InnerRect:GetHeight())
        elseif home_pressed then
            ImGui.SetScrollY(window, 0.0)
        elseif end_pressed then
            ImGui.SetScrollY(window, window.ScrollMax.y)
        end
    else
        local nav_rect_rel = window.NavRectRel[g.NavLayer]
        local page_offset_y = ImMax(0.0, window.InnerRect:GetHeight() - window.FontRefSize * 1.0 + nav_rect_rel:GetHeight())
        local nav_scoring_rect_offset_y = 0.0
        if ImGui.IsKeyPressedEx(517 --[[ImGuiKey.PageUp]], 1 --[[ImGuiInputFlags.Repeat]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) then
            nav_scoring_rect_offset_y = -page_offset_y
            g.NavMoveDir = 3 --[[ImGuiDir.Down]] -- Because our scoring rect is offset up, we request the down direction (so we can always land on the last item)
            g.NavMoveClipDir = 2 --[[ImGuiDir.Up]]
            g.NavMoveFlags = bit32.bor(16 --[[ImGuiNavMoveFlags.AllowCurrentNavId]], 2048 --[[ImGuiNavMoveFlags.IsPageMove]]) -- ImGuiNavMoveFlags.AlsoScoreVisibleSet may be added later
        elseif ImGui.IsKeyPressedEx(518 --[[ImGuiKey.PageDown]], 1 --[[ImGuiInputFlags.Repeat]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) then
            nav_scoring_rect_offset_y = page_offset_y
            g.NavMoveDir = 2 --[[ImGuiDir.Up]] -- Because our scoring rect is offset down, we request the up direction (so we can always land on the last item)
            g.NavMoveClipDir = 3 --[[ImGuiDir.Down]]
            g.NavMoveFlags = bit32.bor(16 --[[ImGuiNavMoveFlags.AllowCurrentNavId]], 2048 --[[ImGuiNavMoveFlags.IsPageMove]]) -- ImGuiNavMoveFlags.AlsoScoreVisibleSet may be added later
        elseif home_pressed then
            -- FIXME-NAV: handling of Home/End is assuming that the top/bottom most item will be visible with Scroll.y == 0/ScrollMax.y
            -- Scrolling will be handled via the ImGuiNavMoveFlags.ScrollToEdgeY flag, we don't scroll immediately to avoid scrolling happening before nav result.
            -- Preserve current horizontal position if we have any.
            nav_rect_rel.Min.y = 0.0; nav_rect_rel.Max.y = 0.0
            if nav_rect_rel:IsInverted() then
                nav_rect_rel.Min.x = 0.0; nav_rect_rel.Max.x = 0.0
            end
            g.NavMoveDir = 3 --[[ImGuiDir.Down]]
            g.NavMoveFlags = bit32.bor(16 --[[ImGuiNavMoveFlags.AllowCurrentNavId]], 64 --[[ImGuiNavMoveFlags.ScrollToEdgeY]])
            -- FIXME-NAV: MoveClipDir left to _None, intentional?
        elseif end_pressed then
            nav_rect_rel.Min.y = window.ContentSize.y; nav_rect_rel.Max.y = window.ContentSize.y
            if nav_rect_rel:IsInverted() then
                nav_rect_rel.Min.x = 0.0; nav_rect_rel.Max.x = 0.0
            end
            g.NavMoveDir = 2 --[[ImGuiDir.Up]]
            g.NavMoveFlags = bit32.bor(16 --[[ImGuiNavMoveFlags.AllowCurrentNavId]], 64 --[[ImGuiNavMoveFlags.ScrollToEdgeY]])
            -- FIXME-NAV: MoveClipDir left to _None, intentional?
        end
        return nav_scoring_rect_offset_y
    end
    return 0.0
end

function ImGui.NavUpdateCreateMoveRequest()
    local g = GImGui
    local io = g.IO
    local window = g.NavWindow
    local nav_gamepad_active = bit32.band(io.ConfigFlags, 2 --[[ImGuiConfigFlags.NavEnableGamepad]]) ~= 0 and bit32.band(io.BackendFlags, 1 --[[ImGuiBackendFlags.HasGamepad]]) ~= 0
    local nav_keyboard_active = bit32.band(io.ConfigFlags, 1 --[[ImGuiConfigFlags.NavEnableKeyboard]]) ~= 0

    if g.NavMoveForwardToNextFrame and window ~= nil then
        -- Forwarding previous request (which has been modified, e.g. wrap around menus rewrite the requests with a starting rectangle at the other side of the window)
        -- (preserve most state, which were already set by the NavMoveRequestForward() function)
        assert(g.NavMoveDir ~= (-1) --[[ImGuiDir.None]] and g.NavMoveClipDir ~= (-1) --[[ImGuiDir.None]])
        assert(bit32.band(g.NavMoveFlags, 128 --[[ImGuiNavMoveFlags.Forwarded]]) ~= 0)
        -- [Port] IMGUI_DEBUG_LOG_NAV("[nav] NavMoveRequestForward %d\n", g.NavMoveDir)
    else
        -- Initiate directional inputs request
        g.NavMoveDir = (-1) --[[ImGuiDir.None]]
        g.NavMoveFlags = 0 --[[ImGuiNavMoveFlags.None]]
        g.NavMoveScrollFlags = 0 --[[ImGuiScrollFlags.None]]
        if window and not g.NavWindowingTarget and bit32.band(window.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) == 0 then
            local repeat_mode = bit32.bor(1 --[[ImGuiInputFlags.Repeat]], 4 --[[ImGuiInputFlags.RepeatRateNavMove]])
            if not ImGui.IsActiveIdUsingNavDir(0 --[[ImGuiDir.Left]])  and ((nav_gamepad_active and ImGui.IsKeyPressedEx(638 --[[ImGuiKey.GamepadDpadLeft]],  repeat_mode, 4294967295 --[[ImGuiKeyOwner_NoOwner]])) or (nav_keyboard_active and ImGui.IsKeyPressedEx(513 --[[ImGuiKey.LeftArrow]],  repeat_mode, 4294967295 --[[ImGuiKeyOwner_NoOwner]]))) then g.NavMoveDir = 0 --[[ImGuiDir.Left]] end
            if not ImGui.IsActiveIdUsingNavDir(1 --[[ImGuiDir.Right]]) and ((nav_gamepad_active and ImGui.IsKeyPressedEx(639 --[[ImGuiKey.GamepadDpadRight]], repeat_mode, 4294967295 --[[ImGuiKeyOwner_NoOwner]])) or (nav_keyboard_active and ImGui.IsKeyPressedEx(514 --[[ImGuiKey.RightArrow]], repeat_mode, 4294967295 --[[ImGuiKeyOwner_NoOwner]]))) then g.NavMoveDir = 1 --[[ImGuiDir.Right]] end
            if not ImGui.IsActiveIdUsingNavDir(2 --[[ImGuiDir.Up]])    and ((nav_gamepad_active and ImGui.IsKeyPressedEx(640 --[[ImGuiKey.GamepadDpadUp]],    repeat_mode, 4294967295 --[[ImGuiKeyOwner_NoOwner]])) or (nav_keyboard_active and ImGui.IsKeyPressedEx(515 --[[ImGuiKey.UpArrow]],    repeat_mode, 4294967295 --[[ImGuiKeyOwner_NoOwner]]))) then g.NavMoveDir = 2 --[[ImGuiDir.Up]] end
            if not ImGui.IsActiveIdUsingNavDir(3 --[[ImGuiDir.Down]])  and ((nav_gamepad_active and ImGui.IsKeyPressedEx(641 --[[ImGuiKey.GamepadDpadDown]],  repeat_mode, 4294967295 --[[ImGuiKeyOwner_NoOwner]])) or (nav_keyboard_active and ImGui.IsKeyPressedEx(516 --[[ImGuiKey.DownArrow]],  repeat_mode, 4294967295 --[[ImGuiKeyOwner_NoOwner]]))) then g.NavMoveDir = 3 --[[ImGuiDir.Down]] end
        end
        g.NavMoveClipDir = g.NavMoveDir
        ImRect_Copy(g.NavScoringNoClipRect, ImRect(3.4028234663853e+38 --[[FLT_MAX]], 3.4028234663853e+38 --[[FLT_MAX]], -3.4028234663853e+38 --[[FLT_MAX]], -3.4028234663853e+38 --[[FLT_MAX]]))
    end

    -- Update PageUp/PageDown/Home/End scroll
    -- FIXME-NAV: Consider enabling those keys even without the master ImGuiConfigFlags.NavEnableKeyboard flag?
    local scoring_page_offset_y = 0.0
    if window and g.NavMoveDir == (-1) --[[ImGuiDir.None]] and nav_keyboard_active then
        scoring_page_offset_y = ImGui.NavUpdatePageUpPageDown()
    end

    -- Submit
    g.NavMoveForwardToNextFrame = false
    if g.NavMoveDir ~= (-1) --[[ImGuiDir.None]] then
        ImGui.NavMoveRequestSubmit(g.NavMoveDir, g.NavMoveClipDir, g.NavMoveFlags, g.NavMoveScrollFlags)
    end

    -- Moving with no reference triggers an init request (will be used as a fallback if the direction fails to find a match)
    if g.NavMoveSubmitted and g.NavId == 0 then
        -- [Port] IMGUI_DEBUG_LOG_NAV("[nav] NavInitRequest: from move, window \"%s\", layer=%d\n", window ? window->Name : "<NULL>", g.NavLayer)
        g.NavInitRequest = true; g.NavInitRequestFromMove = true
        g.NavInitResult.ID = 0
        if g.IO.ConfigNavCursorVisibleAuto then -- NO check for _NoNavInputs here as we assume MoveRequests cannot be created.
            g.NavCursorVisible = true
        end
    end

    -- When using gamepad, we project the reference nav bounding box into window visible area.
    -- This is to allow resuming navigation inside the visible area after doing a large amount of scrolling,
    -- since with gamepad all movements are relative (can't focus a visible object like we can with the mouse).
    if g.NavMoveSubmitted and g.NavInputSource == 3 --[[ImGuiInputSource.Gamepad]] and g.NavLayer == 0 --[[ImGuiNavLayer.Main]] and window ~= nil then -- and (g.NavMoveFlags & ImGuiNavMoveFlags_Forwarded))
        local clamp_x = bit32.band(g.NavMoveFlags, bit32.bor(1 --[[ImGuiNavMoveFlags.LoopX]], 4 --[[ImGuiNavMoveFlags.WrapX]])) == 0
        local clamp_y = bit32.band(g.NavMoveFlags, bit32.bor(2 --[[ImGuiNavMoveFlags.LoopY]], 8 --[[ImGuiNavMoveFlags.WrapY]])) == 0
        local inner_rect_rel = ImGui.WindowRectAbsToRel(window, ImRect(ImVec2(window.InnerRect.Min.x - 1, window.InnerRect.Min.y - 1), ImVec2(window.InnerRect.Max.x + 1, window.InnerRect.Max.y + 1)))

        -- Take account of changing scroll to handle triggering a new move request on a scrolling frame. (#6171)
        -- Otherwise 'inner_rect_rel' would be off on the move result frame.
        local next_scroll = CalcNextScrollFromScrollTargetAndClamp(window)
        inner_rect_rel:Translate(ImVec2(next_scroll.x - window.Scroll.x, next_scroll.y - window.Scroll.y))

        if (clamp_x or clamp_y) and not inner_rect_rel:Contains(window.NavRectRel[g.NavLayer]) then
            -- [Port] IMGUI_DEBUG_LOG_NAV("[nav] NavMoveRequest: clamp NavRectRel for gamepad move\n")
            local pad_x = ImMin(inner_rect_rel:GetWidth(), window.FontRefSize * 0.5)
            local pad_y = ImMin(inner_rect_rel:GetHeight(), window.FontRefSize * 0.5) -- Terrible approximation for the intent of starting navigation from first fully visible item
            inner_rect_rel.Min.x = clamp_x and (inner_rect_rel.Min.x + pad_x) or -3.4028234663853e+38 --[[FLT_MAX]]
            inner_rect_rel.Max.x = clamp_x and (inner_rect_rel.Max.x - pad_x) or 3.4028234663853e+38 --[[FLT_MAX]]
            inner_rect_rel.Min.y = clamp_y and (inner_rect_rel.Min.y + pad_y) or -3.4028234663853e+38 --[[FLT_MAX]]
            inner_rect_rel.Max.y = clamp_y and (inner_rect_rel.Max.y - pad_y) or 3.4028234663853e+38 --[[FLT_MAX]]
            window.NavRectRel[g.NavLayer]:ClipWithFull(inner_rect_rel)
            g.NavId = 0
        end
    end

    -- Prepare scoring rectangle.
    -- For scoring we use a single segment on the left side our current item bounding box (not touching the edge to avoid box overlap with zero-spaced items)
    local scoring_rect = ImRect()
    if window ~= nil then
        local nav_rect_rel = ImRect()
        if not window.NavRectRel[g.NavLayer]:IsInverted() then
            ImRect_Copy(nav_rect_rel, window.NavRectRel[g.NavLayer])
        end
        scoring_rect = ImGui.WindowRectRelToAbs(window, nav_rect_rel)

        if bit32.band(g.NavMoveFlags, 2048 --[[ImGuiNavMoveFlags.IsPageMove]]) ~= 0 then
            -- When we start from a visible location, score visible items and prioritize this result.
            if window.InnerRect:Contains(scoring_rect) then
                g.NavMoveFlags = bit32.bor(g.NavMoveFlags, 32 --[[ImGuiNavMoveFlags.AlsoScoreVisibleSet]])
            end
            ImRect_Copy(g.NavScoringNoClipRect, scoring_rect)
            scoring_rect:TranslateY(scoring_page_offset_y)
            g.NavScoringNoClipRect:Add(scoring_rect)
        end

        -- ImGui.GetForegroundDrawList():AddRectFilled(scoring_rect.Min - ImVec2(1, 1), scoring_rect.Max + ImVec2(1, 1), IM_COL32(255, 100, 0, 80)) -- [DEBUG] Pre-bias
        if g.NavMoveSubmitted then
            ImGui.NavBiasScoringRect(scoring_rect, window.RootWindowForNav.NavPreferredScoringPosRel[g.NavLayer], g.NavMoveDir, g.NavMoveFlags)
        end
        assert(not scoring_rect:IsInverted()) -- Ensure we have a non-inverted bounding box here will allow us to remove extraneous ImFabs() calls in NavScoreItem().
        -- ImGui.GetForegroundDrawList():AddRectFilled(scoring_rect.Min - ImVec2(1, 1), scoring_rect.Max + ImVec2(1, 1), IM_COL32(255, 100, 0, 80)) -- [DEBUG] Post-bias
        -- if not g.NavScoringNoClipRect:IsInverted() then ImGui.GetForegroundDrawList():AddRectFilled(g.NavScoringNoClipRect.Min, g.NavScoringNoClipRect.Max, IM_COL32(100, 255, 0, 80)) end -- [DEBUG]
    end
    ImRect_Copy(g.NavScoringRect, scoring_rect)
    -- g.NavScoringNoClipRect:Add(scoring_rect)
end

function ImGui.NavUpdateCreateTabbingRequest()
    local g = GImGui
    local window = g.NavWindow
    assert(g.NavMoveDir == (-1) --[[ImGuiDir.None]])
    if window == nil or g.NavWindowingTarget ~= nil or bit32.band(window.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) ~= 0 or not g.ConfigNavEnableTabbing then
        return
    end

    local tab_pressed = ImGui.IsKeyPressedEx(512 --[[ImGuiKey.Tab]], 1 --[[ImGuiInputFlags.Repeat]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) and not g.IO.KeyCtrl and not g.IO.KeyAlt
    if not tab_pressed then
        return
    end

    -- Initiate tabbing request
    -- (this is ALWAYS ENABLED, regardless of ImGuiConfigFlags.NavEnableKeyboard flag!)
    -- See NavProcessItemForTabbingRequest() for a description of the various forward/backward tabbing cases with and without wrapping.
    local nav_keyboard_active = bit32.band(g.IO.ConfigFlags, 1 --[[ImGuiConfigFlags.NavEnableKeyboard]]) ~= 0
    if nav_keyboard_active then
        g.NavTabbingDir = g.IO.KeyShift and -1 or ((g.NavCursorVisible == false and g.ActiveId == 0) and 0 or 1)
    else
        g.NavTabbingDir = g.IO.KeyShift and -1 or ((g.ActiveId == 0) and 0 or 1)
    end
    local move_flags = bit32.bor(1024 --[[ImGuiNavMoveFlags.IsTabbing]], 4096 --[[ImGuiNavMoveFlags.Activate]])
    local scroll_flags = window.Appearing and bit32.bor(1 --[[ImGuiScrollFlags.KeepVisibleEdgeX]], 32 --[[ImGuiScrollFlags.AlwaysCenterY]]) or bit32.bor(1 --[[ImGuiScrollFlags.KeepVisibleEdgeX]], 2 --[[ImGuiScrollFlags.KeepVisibleEdgeY]])
    local clip_dir = (g.NavTabbingDir < 0) and 2 --[[ImGuiDir.Up]] or 3 --[[ImGuiDir.Down]]
    ImGui.NavMoveRequestSubmit((-1) --[[ImGuiDir.None]], clip_dir, move_flags, scroll_flags) -- FIXME-NAV: Once we refactor tabbing, add LegacyApi flag to not activate non-inputable.
    g.NavTabbingCounter = -1
end

function ImGui.NavUpdate()
    local g = GImGui
    local io = g.IO

    io.WantSetMousePos = false
    -- if g.NavScoringDebugCount > 0 then IMGUI_DEBUG_LOG_NAV("[nav] NavScoringDebugCount %d for '%s' layer %d (Init:%d, Move:%d)\n", g.NavScoringDebugCount, g.NavWindow ? g.NavWindow->Name : "NULL", g.NavLayer, g.NavInitRequest || g.NavInitResultId != 0, g.NavMoveRequest) end

    -- Set input source based on which keys are last pressed (as some features differs when used with Gamepad vs Keyboard)
    -- FIXME-NAV: Now that keys are separated maybe we can get rid of NavInputSource?
    local nav_gamepad_active = bit32.band(io.ConfigFlags, 2 --[[ImGuiConfigFlags.NavEnableGamepad]]) ~= 0 and bit32.band(io.BackendFlags, 1 --[[ImGuiBackendFlags.HasGamepad]]) ~= 0
    if nav_gamepad_active and g.NavInputSource ~= 3 --[[ImGuiInputSource.Gamepad]] then
        for _, key in ipairs(nav_gamepad_keys_to_change_source) do
            if ImGui.IsKeyDown(key) then
                g.NavInputSource = 3 --[[ImGuiInputSource.Gamepad]]
            end
        end
    end

    local nav_keyboard_active = bit32.band(io.ConfigFlags, 1 --[[ImGuiConfigFlags.NavEnableKeyboard]]) ~= 0
    if nav_keyboard_active and g.NavInputSource ~= 2 --[[ImGuiInputSource.Keyboard]] then
        for _, key in ipairs(nav_keyboard_keys_to_change_source) do
            if ImGui.IsKeyDown(key) then
                g.NavInputSource = 2 --[[ImGuiInputSource.Keyboard]]
            end
        end
    end

    -- Process navigation init request (select first/default focus)
    g.NavJustMovedToId = 0
    g.NavJustMovedToFocusScopeId = 0
    g.NavJustMovedFromFocusScopeId = 0
    if g.NavInitResult.ID ~= 0 then
        ImGui.NavInitRequestApplyResult()
    end
    g.NavInitRequest = false
    g.NavInitRequestFromMove = false
    g.NavInitResult.ID = 0

    -- Process navigation move request
    if g.NavMoveSubmitted then
        ImGui.NavMoveRequestApplyResult()
    end
    g.NavTabbingCounter = 0
    g.NavMoveSubmitted = false
    g.NavMoveScoringItems = false
    if g.NavCursorHideFrames > 0 then
        g.NavCursorHideFrames = g.NavCursorHideFrames - 1
        if g.NavCursorHideFrames == 0 then
            g.NavCursorVisible = true
        end
    end

    -- Schedule mouse position update (will be done at the bottom of this function, after 1) processing all move requests and 2) updating scrolling)
    local set_mouse_pos = false
    if g.NavMousePosDirty and g.NavIdIsAlive then
        if g.NavCursorVisible and g.NavHighlightItemUnderNav and g.NavWindow then
            set_mouse_pos = true
        end
    end
    g.NavMousePosDirty = false
    assert(g.NavLayer == 0 --[[ImGuiNavLayer.Main]] or g.NavLayer == 1 --[[ImGuiNavLayer.Menu]])

    -- Store our return window (for returning from Menu Layer to Main Layer) and clear it as soon as we step back in our own Layer 0
    if g.NavWindow then
        ImGui.NavSaveLastChildNavWindowIntoParent(g.NavWindow)
    end
    if g.NavWindow and g.NavWindow.NavLastChildNavWindow ~= nil and g.NavLayer == 0 --[[ImGuiNavLayer.Main]] then
        g.NavWindow.NavLastChildNavWindow = nil
    end

    -- Update Ctrl+Tab and Windowing features (hold Square to move/resize/etc.)
    ImGui.NavUpdateWindowing()

    -- Set output flags for user application
    io.NavActive = (nav_keyboard_active or nav_gamepad_active) and g.NavWindow and bit32.band(g.NavWindow.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) == 0
    io.NavVisible = (io.NavActive and g.NavId ~= 0 and g.NavCursorVisible) or (g.NavWindowingTarget ~= nil)

    -- Process NavCancel input (to close a popup, get back to parent, clear focus)
    ImGui.NavUpdateCancelRequest()
    ImGui.NavUpdateContextMenuRequest()

    -- Process manual activation request
    g.NavActivateId = 0
    g.NavActivateDownId = 0
    g.NavActivatePressedId = 0
    g.NavActivateFlags = 0 --[[ImGuiActivateFlags.None]]

    if g.NavId ~= 0 and g.NavCursorVisible and not g.NavWindowingTarget and g.NavWindow and bit32.band(g.NavWindow.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) == 0 then
        local activate_down = (nav_keyboard_active and ImGui.IsKeyDown(524 --[[ImGuiKey.Space]], 4294967295 --[[ImGuiKeyOwner_NoOwner]])) or (nav_gamepad_active and ImGui.IsKeyDown(ImGuiKey.NavGamepadActivate, 4294967295 --[[ImGuiKeyOwner_NoOwner]]))
        local activate_pressed = activate_down and ((nav_keyboard_active and ImGui.IsKeyPressedEx(524 --[[ImGuiKey.Space]], 0 --[[ImGuiInputFlags.None]], 4294967295 --[[ImGuiKeyOwner_NoOwner]])) or (nav_gamepad_active and ImGui.IsKeyPressedEx(ImGuiKey.NavGamepadActivate, 0 --[[ImGuiInputFlags.None]], 4294967295 --[[ImGuiKeyOwner_NoOwner]])))
        local input_pressed_keyboard = nav_keyboard_active and (ImGui.IsKeyPressedEx(525 --[[ImGuiKey.Enter]], 0 --[[ImGuiInputFlags.None]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]) or ImGui.IsKeyPressedEx(627 --[[ImGuiKey.KeypadEnter]], 0 --[[ImGuiInputFlags.None]], 4294967295 --[[ImGuiKeyOwner_NoOwner]]))
        local input_pressed_gamepad = false
        if activate_down and nav_gamepad_active and ImGui.IsKeyDown(ImGuiKey.NavGamepadActivate, 4294967295 --[[ImGuiKeyOwner_NoOwner]]) and bit32.band(g.NavIdItemFlags, 1048576 --[[ImGuiItemFlags.Inputable]]) ~= 0 then -- requires ImGuiItemFlags.Inputable to avoid retriggering regular buttons.
            if ImGui.GetKeyData(g, ImGuiKey.NavGamepadActivate).DownDurationPrev < 0.6 --[[NAV_ACTIVATE_INPUT_WITH_GAMEPAD_DELAY]] and ImGui.GetKeyData(g, ImGuiKey.NavGamepadActivate).DownDuration >= 0.6 --[[NAV_ACTIVATE_INPUT_WITH_GAMEPAD_DELAY]] then
                input_pressed_gamepad = true
            end
        end

        if g.ActiveId == 0 and activate_pressed then
            g.NavActivateId = g.NavId
            g.NavActivateFlags = 2 --[[ImGuiActivateFlags.PreferTweak]]
        end
        if (g.ActiveId == 0 or g.ActiveId == g.NavId) and (input_pressed_keyboard or input_pressed_gamepad) then
            g.NavActivateId = g.NavId
            g.NavActivateFlags = 1 --[[ImGuiActivateFlags.PreferInput]]
        end
        if (g.ActiveId == 0 or g.ActiveId == g.NavId) and (activate_down or input_pressed_keyboard or input_pressed_gamepad) then -- FIXME-NAV: Unsure why input_pressed_xxx (migrated from input_down which was already dubious)
            g.NavActivateDownId = g.NavId
        end
        if (g.ActiveId == 0 or g.ActiveId == g.NavId) and (activate_pressed or input_pressed_keyboard or input_pressed_gamepad) then
            g.NavActivatePressedId = g.NavId
            ImGui.NavHighlightActivated(g.NavId)
        end
    end
    if g.NavWindow and bit32.band(g.NavWindow.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) ~= 0 then
        g.NavCursorVisible = false
    elseif g.IO.ConfigNavCursorVisibleAlways and g.NavCursorHideFrames == 0 then
        g.NavCursorVisible = true
    end
    if g.NavActivateId ~= 0 then
        assert(g.NavActivateDownId == g.NavActivateId)
    end

    -- Highlight
    if g.NavHighlightActivatedTimer > 0.0 then
        g.NavHighlightActivatedTimer = ImMax(0.0, g.NavHighlightActivatedTimer - io.DeltaTime)
    end
    if g.NavHighlightActivatedTimer == 0.0 then
        g.NavHighlightActivatedId = 0
    end

    -- Process programmatic activation request
    -- FIXME-NAV: Those should eventually be queued (unlike focus they don't cancel each others)
    if g.NavNextActivateId ~= 0 then
        g.NavActivateId = g.NavNextActivateId
        g.NavActivateDownId = g.NavNextActivateId
        g.NavActivatePressedId = g.NavNextActivateId
        g.NavActivateFlags = g.NavNextActivateFlags
    end
    g.NavNextActivateId = 0

    -- Process move requests
    ImGui.NavUpdateCreateMoveRequest()
    if g.NavMoveDir == (-1) --[[ImGuiDir.None]] then
        ImGui.NavUpdateCreateTabbingRequest()
    end
    ImGui.NavUpdateAnyRequestFlag()
    g.NavIdIsAlive = false

    -- Scrolling
    if g.NavWindow and bit32.band(g.NavWindow.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) == 0 and not g.NavWindowingTarget then
        -- *Fallback* manual-scroll with Nav directional keys when window has no navigable item
        local window = g.NavWindow
        local scroll_speed = IM_ROUND(window.FontRefSize * 100 * io.DeltaTime) -- We need round the scrolling speed because sub-pixel scroll isn't reliably supported.
        local move_dir = g.NavMoveDir
        if window.DC.NavLayersActiveMask == 0x00 and window.DC.NavWindowHasScrollY and move_dir ~= (-1) --[[ImGuiDir.None]] then
            if move_dir == 0 --[[ImGuiDir.Left]] or move_dir == 1 --[[ImGuiDir.Right]] then
                local delta = (move_dir == 0 --[[ImGuiDir.Left]]) and -1.0 or 1.0
                ImGui.SetScrollX(window, ImTrunc(window.Scroll.x + delta * scroll_speed))
            end
            if move_dir == 2 --[[ImGuiDir.Up]] or move_dir == 3 --[[ImGuiDir.Down]] then
                local delta = (move_dir == 2 --[[ImGuiDir.Up]]) and -1.0 or 1.0
                ImGui.SetScrollY(window, ImTrunc(window.Scroll.y + delta * scroll_speed))
            end
        end

        -- *Normal* Manual scroll with LStick
        -- Next movement request will clamp the NavId reference rectangle to the visible area, so navigation will resume within those bounds.
        if nav_gamepad_active then
            local scroll_dir = ImGui.GetKeyMagnitude2d(648 --[[ImGuiKey.GamepadLStickLeft]], 649 --[[ImGuiKey.GamepadLStickRight]], 650 --[[ImGuiKey.GamepadLStickUp]], 651 --[[ImGuiKey.GamepadLStickDown]])
            local tweak_factor = 1.0
            if ImGui.IsKeyDown(642 --[[ImGuiKey.NavGamepadTweakSlow]]) then
                tweak_factor = 1.0 / 10.0
            elseif ImGui.IsKeyDown(643 --[[ImGuiKey.NavGamepadTweakFast]]) then
                tweak_factor = 10.0
            end
            if scroll_dir.x ~= 0.0 and window.ScrollbarX then
                ImGui.SetScrollX(window, ImTrunc(window.Scroll.x + scroll_dir.x * scroll_speed * tweak_factor))
            end
            if scroll_dir.y ~= 0.0 then
                ImGui.SetScrollY(window, ImTrunc(window.Scroll.y + scroll_dir.y * scroll_speed * tweak_factor))
            end
        end
    end

    -- Always prioritize mouse highlight if navigation is disabled
    if not nav_keyboard_active and not nav_gamepad_active then
        g.NavCursorVisible = false
        g.NavHighlightItemUnderNav = false
        set_mouse_pos = false
    end

    -- Update mouse position if requested
    -- (This will take into account the possibility that a Scroll was queued in the window to offset our absolute mouse position before scroll has been applied)
    if set_mouse_pos and io.ConfigNavMoveSetMousePos and bit32.band(io.BackendFlags, 4 --[[ImGuiBackendFlags.HasSetMousePos]]) ~= 0 then
        ImGui.TeleportMousePos(ImGui.NavCalcPreferredRefPos(67108864 --[[ImGuiWindowFlags.Popup]]))
    end

    -- [DEBUG]
    g.NavScoringDebugCount = 0
end

end

-- Process Escape/NavCancel input (to close a popup, get back to parent, clear focus)
-- FIXME: In order to support e.g. Escape to clear a selection we'll need:
-- - either to store the equivalent of ActiveIdUsingKeyInputMask for a FocusScope and test for it.
-- - either to move most/all of those tests to the epilogue/end functions of the scope they are dealing with (e.g. exit child window in EndChild()) or in EndFrame(), to allow an earlier intercept
function ImGui.NavUpdateCancelRequest()
    local g = GImGui
    local nav_gamepad_active = bit32.band(g.IO.ConfigFlags, 2 --[[ImGuiConfigFlags.NavEnableGamepad]]) ~= 0 and bit32.band(g.IO.BackendFlags, 1 --[[ImGuiBackendFlags.HasGamepad]]) ~= 0
    local nav_keyboard_active = bit32.band(g.IO.ConfigFlags, 1 --[[ImGuiConfigFlags.NavEnableKeyboard]]) ~= 0
    if not (nav_keyboard_active and ImGui.IsKeyPressedEx(526 --[[ImGuiKey.Escape]], 0, 4294967295 --[[ImGuiKeyOwner_NoOwner]])) and not (nav_gamepad_active and ImGui.IsKeyPressedEx(ImGuiKey.NavGamepadCancel, 0, 4294967295 --[[ImGuiKeyOwner_NoOwner]])) then
        return
    end

    -- IMGUI_DEBUG_LOG_NAV("[nav] NavUpdateCancelRequest()")
    if g.ActiveId ~= 0 then
        ImGui.ClearActiveID()
    elseif g.NavLayer ~= 0 --[[ImGuiNavLayer.Main]] then
        -- Leave the "menu" layer
        ImGui.NavRestoreLayer(0 --[[ImGuiNavLayer.Main]])
        ImGui.SetNavCursorVisibleAfterMove()
    elseif g.NavWindow and g.NavWindow ~= g.NavWindow.RootWindow and bit32.band(g.NavWindow.RootWindowForNav.Flags, 67108864 --[[ImGuiWindowFlags.Popup]]) == 0 and g.NavWindow.RootWindowForNav.ParentWindow then
        -- Exit child window
        local child_window = g.NavWindow.RootWindowForNav
        local parent_window = child_window.ParentWindow
        assert(child_window.ChildId ~= 0)
        ImGui.FocusWindow(parent_window)
        ImGui.SetNavID(child_window.ChildId, 0 --[[ImGuiNavLayer.Main]], 0, ImGui.WindowRectAbsToRel(parent_window, child_window:Rect()))
        ImGui.SetNavCursorVisibleAfterMove()
    elseif g.OpenPopupStack.Size > 0 and g.OpenPopupStack:back().Window ~= nil and bit32.band(g.OpenPopupStack:back().Window.Flags, 134217728 --[[ImGuiWindowFlags.Modal]]) == 0 then
        -- Close open popup/menu
        ImGui.ClosePopupToLevel(g.OpenPopupStack.Size - 1, true)
    else
        -- Clear NavLastId for popups but keep it for regular child window so we can leave one and come back where we were
        -- FIXME-NAV: This should happen on window appearing.
        if g.IO.ConfigNavEscapeClearFocusItem or g.IO.ConfigNavEscapeClearFocusWindow then
            if g.NavWindow and bit32.band(g.NavWindow.Flags, 67108864 --[[ImGuiWindowFlags.Popup]]) ~= 0 then -- or not (g.NavWindow.Flags & ImGuiWindowFlags.ChildWindow)
                g.NavWindow.NavLastIds[0] = 0
            end
        end

        -- Clear nav focus
        if g.IO.ConfigNavEscapeClearFocusItem or g.IO.ConfigNavEscapeClearFocusWindow then
            g.NavId = 0
        end
        if g.IO.ConfigNavEscapeClearFocusWindow then
            ImGui.FocusWindow(nil)
        end
    end
end

function ImGui.NavMoveRequestButNoResultYet()
    local g = GImGui
    return g.NavMoveScoringItems and g.NavMoveResultLocal.ID == 0 and g.NavMoveResultOther.ID == 0
end

local function ImGetDirQuadrantFromDelta(dx, dy)
    if ImFabs(dx) > ImFabs(dy) then
        return (dx > 0.0) and 1 --[[ImGuiDir.Right]] or 0 --[[ImGuiDir.Left]]
    end
    return (dy > 0.0) and 3 --[[ImGuiDir.Down]] or 2 --[[ImGuiDir.Up]]
end

local function NavScoreItemDistInterval(cand_min, cand_max, curr_min, curr_max)
    if cand_max < curr_min then
        return cand_max - curr_min
    end
    if curr_max < cand_min then
        return cand_min - curr_max
    end
    return 0.0
end

-- Scoring function for keyboard/gamepad directional navigation. Based on https://gist.github.com/rygorous/6981057
--- @param result ImGuiNavItemData
--- @param nav_bb ImRect
--- @return bool
function ImGui.NavScoreItem(result, nav_bb)
    local g = GImGui
    local window = g.CurrentWindow
    if g.NavLayer ~= window.DC.NavLayerCurrent then
        return false
    end

    -- FIXME: Those are not good variables names
    local cand = ImRect()
    ImRect_Copy(cand, nav_bb)       -- Current item nav rectangle
    local curr = g.NavScoringRect   -- Current modified source rect (NB: we've applied Max.x = Min.x in NavUpdate() to inhibit the effect of having varied item width)
    g.NavScoringDebugCount = g.NavScoringDebugCount + 1

    -- When entering through a NavFlattened border, we consider child window items as fully clipped for scoring
    if window.ParentWindow == g.NavWindow then
        assert(bit32.band(bit32.bor(window.ChildFlags, g.NavWindow.ChildFlags), 256 --[[ImGuiChildFlags.NavFlattened]]) ~= 0)
        if not window.ClipRect:Overlaps(cand) then
            return false
        end
        cand:ClipWithFull(window.ClipRect) -- This allows the scored item to not overlap other candidates in the parent window
    end

    -- Compute distance between boxes
    -- FIXME-NAV: Introducing biases for vertical navigation, needs to be removed.
    local dbx = NavScoreItemDistInterval(cand.Min.x, cand.Max.x, curr.Min.x, curr.Max.x)
    local dby = NavScoreItemDistInterval(ImLerp(cand.Min.y, cand.Max.y, 0.2), ImLerp(cand.Min.y, cand.Max.y, 0.8), ImLerp(curr.Min.y, curr.Max.y, 0.2), ImLerp(curr.Min.y, curr.Max.y, 0.8)) -- Scale down on Y to keep using box-distance for vertically touching items
    if dby ~= 0.0 and dbx ~= 0.0 then
        dbx = (dbx / 1000.0) + ((dbx > 0.0) and 1.0 or -1.0)
    end
    local dist_box = ImFabs(dbx) + ImFabs(dby)

    -- Compute distance between centers (this is off by a factor of 2, but we only compare center distances with each other so it doesn't matter)
    local dcx = (cand.Min.x + cand.Max.x) - (curr.Min.x + curr.Max.x)
    local dcy = (cand.Min.y + cand.Max.y) - (curr.Min.y + curr.Max.y)
    local dist_center = ImFabs(dcx) + ImFabs(dcy) -- L1 metric (need this for our connectedness guarantee)

    -- Determine which quadrant of 'curr' our candidate item 'cand' lies in based on distance
    local quadrant
    local dax = 0.0
    local day = 0.0
    local dist_axial = 0.0
    if dbx ~= 0.0 or dby ~= 0.0 then
        -- For non-overlapping boxes, use distance between boxes
        -- FIXME-NAV: Quadrant may be incorrect because of (1) dbx bias and (2) curr.Max.y bias applied by NavBiasScoringRect() where typically curr.Max.y==curr.Min.y
        -- One typical case where this happens, with style.WindowMenuButtonPosition == ImGuiDir.Right, pressing Left to navigate from Close to Collapse tends to fail.
        -- Also see #6344. Calling ImGetDirQuadrantFromDelta() with unbiased values may be good but side-effects are plenty.
        dax = dbx
        day = dby
        dist_axial = dist_box
        quadrant = ImGetDirQuadrantFromDelta(dbx, dby)
    elseif dcx ~= 0.0 or dcy ~= 0.0 then
        -- For overlapping boxes with different centers, use distance between centers
        dax = dcx
        day = dcy
        dist_axial = dist_center
        quadrant = ImGetDirQuadrantFromDelta(dcx, dcy)
    else
        -- Degenerate case: two overlapping buttons with same center, break ties arbitrarily (note that LastItemId here is really the _previous_ item order, but it doesn't matter)
        quadrant = (g.LastItemData.ID < g.NavId) and 0 --[[ImGuiDir.Left]] or 1 --[[ImGuiDir.Right]]
    end

    local move_dir = g.NavMoveDir

    -- Is it in the quadrant we're interested in moving to?
    local new_best = false
    if quadrant == move_dir then
        -- Does it beat the current best candidate?
        if dist_box < result.DistBox then
            result.DistBox = dist_box
            result.DistCenter = dist_center
            return true
        end
        if dist_box == result.DistBox then
            -- Try using distance between center points to break ties
            if dist_center < result.DistCenter then
                result.DistCenter = dist_center
                new_best = true
            elseif dist_center == result.DistCenter then
                -- Still tied! we need to be extra-careful to make sure everything gets linked properly. We consistently break ties by symbolically moving "later" items
                -- (with higher index) to the right/downwards by an infinitesimal amount since we the current "best" button already (so it must have a lower index),
                -- this is fairly easy. This rule ensures that all buttons with dx==dy==0 will end up being linked in order of appearance along the x axis.
                if (((move_dir == 2 --[[ImGuiDir.Up]] or move_dir == 3 --[[ImGuiDir.Down]]) and dby) or dbx) < 0.0 then -- moving bj to the right/down decreases distance
                    new_best = true
                end
            end
        end
    end

    -- Axial check: if 'curr' has no link at all in some direction and 'cand' lies roughly in that direction, add a tentative link. This will only be kept if no "real" matches
    -- are found, so it only augments the graph produced by the above method using extra links. (important, since it doesn't guarantee strong connectedness)
    -- This is just to avoid buttons having no links in a particular direction when there's a suitable neighbor. you get good graphs without this too.
    -- 2017/09/29: FIXME: This now currently only enabled inside menu bars, ideally we'd disable it everywhere. Menus in particular need to catch failure. For general navigation it feels awkward.
    -- Disabling it may lead to disconnected graphs when nodes are very spaced out on different axis. Perhaps consider offering this as an option?
    if result.DistBox == 3.4028234663853e+38 --[[FLT_MAX]] and dist_axial < result.DistAxial then -- Check axial match
        if g.NavLayer == 1 --[[ImGuiNavLayer.Menu]] and bit32.band(g.NavWindow.Flags, 268435456 --[[ImGuiWindowFlags.ChildMenu]]) == 0 then
            if (move_dir == 0 --[[ImGuiDir.Left]] and dax < 0.0) or (move_dir == 1 --[[ImGuiDir.Right]] and dax > 0.0) or (move_dir == 2 --[[ImGuiDir.Up]] and day < 0.0) or (move_dir == 3 --[[ImGuiDir.Down]] and day > 0.0) then
                result.DistAxial = dist_axial
                new_best = true
            end
        end
    end

    return new_best
end

--- @param result ImGuiNavItemData
function ImGui.NavApplyItemToResult(result)
    local g = GImGui
    local window = g.CurrentWindow
    result.Window = window
    result.ID = g.LastItemData.ID
    result.FocusScopeId = g.CurrentFocusScopeId
    result.ItemFlags = g.LastItemData.ItemFlags
    ImRect_Copy(result.RectRel, ImGui.WindowRectAbsToRel(window, g.LastItemData.NavRect))
    if bit32.band(result.ItemFlags, 2097152 --[[ImGuiItemFlags.HasSelectionUserData]]) ~= 0 then
        assert(g.NextItemData.SelectionUserData ~= (-1) --[[ImGuiSelectionUserData_Invalid]])
        result.SelectionUserData = g.NextItemData.SelectionUserData -- INTENTIONAL: At this point this field is not cleared in NextItemData. Avoid unnecessary copy to LastItemData.
    end
end

--- @param result ImGuiNavItemData
function ImGui.NavMoveRequestResolveWithLastItem(result)
    local g = GImGui
    g.NavMoveScoringItems = false -- Ensure request doesn't need more processing
    ImGui.NavApplyItemToResult(result)
    ImGui.NavUpdateAnyRequestFlag()
end

-- Handle "scoring" of an item for a tabbing/focusing request initiated by NavUpdateCreateTabbingRequest().
-- Note that SetKeyboardFocusHere() API calls are considered tabbing requests!
-- - Case 1: no nav/active id:    set result to first eligible item, stop storing.
-- - Case 2: tab forward:         on ref id set counter, on counter elapse store result
-- - Case 3: tab forward wrap:    set result to first eligible item (preemptively), on ref id set counter, on next frame if counter hasn't elapsed store result. -- FIXME-TABBING: Could be done as a next-frame forwarded request
-- - Case 4: tab backward:        store all results, on ref id pick prev, stop storing
-- - Case 5: tab backward wrap:   store all results, on ref id if no result keep storing until last -- FIXME-TABBING: Could be done as next-frame forwarded requested
--- @param id         ImGuiID
--- @param item_flags ImGuiItemFlags
--- @param move_flags ImGuiNavMoveFlags
function ImGui.NavProcessItemForTabbingRequest(id, item_flags, move_flags)
    local g = GImGui

    if bit32.band(move_flags, 512 --[[ImGuiNavMoveFlags.FocusApi]]) == 0 then
        if g.NavLayer ~= g.CurrentWindow.DC.NavLayerCurrent then
            return
        end
        if g.NavFocusScopeId ~= g.CurrentFocusScopeId then
            return
        end
    end

    -- - Can always land on an item when using API call.
    -- - Tabbing with _NavEnableKeyboard (space/enter/arrows): goes through every item.
    -- - Tabbing without _NavEnableKeyboard: goes through inputable items only.
    local can_stop
    if bit32.band(move_flags, 512 --[[ImGuiNavMoveFlags.FocusApi]]) ~= 0 then
        can_stop = true
    else
        can_stop = bit32.band(item_flags, 1 --[[ImGuiItemFlags.NoTabStop]]) == 0 and (bit32.band(g.IO.ConfigFlags, 1 --[[ImGuiConfigFlags.NavEnableKeyboard]]) ~= 0 or bit32.band(item_flags, 1048576 --[[ImGuiItemFlags.Inputable]]) ~= 0)
    end

    -- Always store in NavMoveResultLocal (unlike directional request which uses NavMoveResultOther on sibling/flattened windows)
    local result = g.NavMoveResultLocal
    if g.NavTabbingDir == 1 then
        -- Tab Forward or SetKeyboardFocusHere() with >= 0
        if can_stop and g.NavTabbingResultFirst.ID == 0 then
            ImGui.NavApplyItemToResult(g.NavTabbingResultFirst)
        end
        if can_stop and g.NavTabbingCounter > 0 then
            g.NavTabbingCounter = g.NavTabbingCounter - 1
            if g.NavTabbingCounter == 0 then
                ImGui.NavMoveRequestResolveWithLastItem(result)
            end
        elseif g.NavId == id then
            g.NavTabbingCounter = 1
        end
    elseif g.NavTabbingDir == -1 then
        -- Tab Backward
        if g.NavId == id then
            if result.ID ~= 0 then
                g.NavMoveScoringItems = false
                ImGui.NavUpdateAnyRequestFlag()
            end
        elseif can_stop then
            -- Keep applying until reaching NavId
            ImGui.NavApplyItemToResult(result)
        end
    elseif g.NavTabbingDir == 0 then
        if can_stop and g.NavId == id then
            ImGui.NavMoveRequestResolveWithLastItem(result)
        end
        if can_stop and g.NavTabbingResultFirst.ID == 0 then -- Tab init
            ImGui.NavApplyItemToResult(g.NavTabbingResultFirst)
        end
    end
end

-- We get there when either NavId == id, or when g.NavAnyRequest is set (which is updated by NavUpdateAnyRequestFlag above)
-- This is called after LastItemData is set, but NextItemData is also still valid.
function ImGui.NavProcessItem()
    local g = GImGui
    local window = g.CurrentWindow
    local id = g.LastItemData.ID
    local item_flags = g.LastItemData.ItemFlags

    -- When inside a container that isn't scrollable with Left<>Right, clip NavRect accordingly (#2221, #8816, #7994)
    local nav_bb = ImRect()
    ImRect_Copy(nav_bb, g.LastItemData.NavRect)
    if window.DC.NavIsScrollPushableX == false then
        nav_bb.Min.x = ImClamp(nav_bb.Min.x, window.ClipRect.Min.x, window.ClipRect.Max.x)
        nav_bb.Max.x = ImClamp(nav_bb.Max.x, window.ClipRect.Min.x, window.ClipRect.Max.x)
    end

    -- Process Init Request
    if g.NavInitRequest and g.NavLayer == window.DC.NavLayerCurrent and bit32.band(item_flags, 64 --[[ImGuiItemFlags.Disabled]]) == 0 then
        -- Even if 'ImGuiItemFlags.NoNavDefaultFocus' is on (typically collapse/close button) we record the first ResultId so they can be used as a fallback
        local candidate_for_nav_default_focus = bit32.band(item_flags, 4 --[[ImGuiItemFlags.NoNavDefaultFocus]]) == 0
        if candidate_for_nav_default_focus or g.NavInitResult.ID == 0 then
            ImGui.NavApplyItemToResult(g.NavInitResult)
        end
        if candidate_for_nav_default_focus then
            g.NavInitRequest = false -- Found a match, clear request
            ImGui.NavUpdateAnyRequestFlag()
        end
    end

    -- Process Move Request (scoring for navigation)
    -- FIXME-NAV: Consider policy for double scoring (scoring from NavScoringRect + scoring from a rect wrapped according to current wrapping policy)
    if g.NavMoveScoringItems and bit32.band(item_flags, 64 --[[ImGuiItemFlags.Disabled]]) == 0 then
        if bit32.band(g.NavMoveFlags, 512 --[[ImGuiNavMoveFlags.FocusApi]]) ~= 0 or bit32.band(window.Flags, 65536 --[[ImGuiWindowFlags.NoNavInputs]]) == 0 then
            local is_tabbing = bit32.band(g.NavMoveFlags, 1024 --[[ImGuiNavMoveFlags.IsTabbing]]) ~= 0
            if is_tabbing then
                ImGui.NavProcessItemForTabbingRequest(id, item_flags, g.NavMoveFlags)
            elseif g.NavId ~= id or bit32.band(g.NavMoveFlags, 16 --[[ImGuiNavMoveFlags.AllowCurrentNavId]]) ~= 0 then
                local result = (window == g.NavWindow) and g.NavMoveResultLocal or g.NavMoveResultOther
                if ImGui.NavScoreItem(result, nav_bb) then
                    ImGui.NavApplyItemToResult(result)
                end

                -- Features like PageUp/PageDown need to maintain a separate score for the visible set of items.
                local VISIBLE_RATIO = 0.70
                if bit32.band(g.NavMoveFlags, 32 --[[ImGuiNavMoveFlags.AlsoScoreVisibleSet]]) ~= 0 then
                    local r = window.InnerRect -- window.ClipRect
                    if r:Overlaps(nav_bb) then
                        if ImClamp(nav_bb.Max.y, r.Min.y, r.Max.y) - ImClamp(nav_bb.Min.y, r.Min.y, r.Max.y) >= (nav_bb.Max.y - nav_bb.Min.y) * VISIBLE_RATIO then
                            if ImGui.NavScoreItem(g.NavMoveResultLocalVisible, nav_bb) then
                                ImGui.NavApplyItemToResult(g.NavMoveResultLocalVisible)
                            end
                        end
                    end
                end
            end
        end
    end

    -- Update information for currently focused/navigated item
    if g.NavId == id then
        if g.NavWindow ~= window then
            ImGui.SetNavWindow(window) -- Always refresh g.NavWindow, because some operations such as FocusItem() may not have a window.
        end
        g.NavLayer = window.DC.NavLayerCurrent
        ImGui.SetNavFocusScope(g.CurrentFocusScopeId) -- Will set g.NavFocusScopeId AND store g.NavFocusScopePath
        g.NavFocusScopeId = g.CurrentFocusScopeId
        g.NavIdIsAlive = true
        g.NavIdItemFlags = item_flags
        if bit32.band(g.LastItemData.ItemFlags, 2097152 --[[ImGuiItemFlags.HasSelectionUserData]]) ~= 0 then
            assert(g.NextItemData.SelectionUserData ~= (-1) --[[ImGuiSelectionUserData_Invalid]])
            g.NavLastValidSelectionUserData = g.NextItemData.SelectionUserData -- INTENTIONAL: At this point this field is not cleared in NextItemData. Avoid unnecessary copy to LastItemData.
        end
        window.NavRectRel[window.DC.NavLayerCurrent] = ImGui.WindowRectAbsToRel(window, nav_bb) -- Store item bounding box (relative to window position)
    end
end

function ImGui.NavInitRequestApplyResult()
    -- In very rare cases g.NavWindow may be null (e.g. clearing focus after requesting an init request, which does happen when releasing Alt while clicking on void)
    local g = GImGui
    if not g.NavWindow then
        return
    end

    local result = g.NavInitResult
    if g.NavId ~= result.ID then
        g.NavJustMovedFromFocusScopeId = g.NavFocusScopeId
        g.NavJustMovedToId = result.ID
        g.NavJustMovedToFocusScopeId = result.FocusScopeId
        g.NavJustMovedToKeyMods = 0
        g.NavJustMovedToIsTabbing = false
        g.NavJustMovedToIsInit = true
        g.NavJustMovedToHasSelectionData = bit32.band(result.ItemFlags, 2097152 --[[ImGuiItemFlags.HasSelectionUserData]]) ~= 0
    end

    -- Apply result from previous navigation init request (will typically select the first item, unless SetItemDefaultFocus() has been called)
    -- FIXME-NAV: On _NavFlattened windows, g.NavWindow will only be updated during subsequent frame. Not a problem currently.
    -- [Port] IMGUI_DEBUG_LOG_NAV("[nav] NavInitRequest: ApplyResult: NavID 0x%08X in Layer %d Window \"%s\"\n", result->ID, g.NavLayer, g.NavWindow->Name)
    ImGui.SetNavID(result.ID, g.NavLayer, result.FocusScopeId, result.RectRel)
    g.NavIdIsAlive = true -- Mark as alive from previous frame as we got a result
    if result.SelectionUserData ~= (-1) --[[ImGuiSelectionUserData_Invalid]] then
        g.NavLastValidSelectionUserData = result.SelectionUserData
    end
    if g.NavInitRequestFromMove then
        ImGui.SetNavCursorVisibleAfterMove()
    end
end

-- Apply result from previous frame navigation directional move request. Always called from NavUpdate()
function ImGui.NavMoveRequestApplyResult()
    local g = GImGui

    -- Select which result to use
    local result
    if g.NavMoveResultLocal.ID ~= 0 then
        result = g.NavMoveResultLocal
    elseif g.NavMoveResultOther.ID ~= 0 then
        result = g.NavMoveResultOther
    else
        result = nil
    end

    -- Tabbing forward wrap
    if bit32.band(g.NavMoveFlags, 1024 --[[ImGuiNavMoveFlags.IsTabbing]]) ~= 0 and result == nil then
        if (g.NavTabbingCounter == 1 or g.NavTabbingDir == 0) and g.NavTabbingResultFirst.ID ~= 0 then
            result = g.NavTabbingResultFirst
        end
    end

    -- In a situation when there are no results but NavId != 0, re-enable the Navigation highlight (because g.NavId is not considered as a possible result)
    local axis = (g.NavMoveDir == 2 --[[ImGuiDir.Up]] or g.NavMoveDir == 3 --[[ImGuiDir.Down]]) and 2 --[[ImGuiAxis.Y]] or 1 --[[ImGuiAxis.X]]
    if result == nil then
        if bit32.band(g.NavMoveFlags, 1024 --[[ImGuiNavMoveFlags.IsTabbing]]) ~= 0 then
            g.NavMoveFlags = bit32.bor(g.NavMoveFlags, 16384 --[[ImGuiNavMoveFlags.NoSetNavCursorVisible]])
        end
        if g.NavId ~= 0 and bit32.band(g.NavMoveFlags, 16384 --[[ImGuiNavMoveFlags.NoSetNavCursorVisible]]) == 0 then
            ImGui.SetNavCursorVisibleAfterMove()
        end
        ImGui.NavClearPreferredPosForAxis(axis) -- On a failed move, clear preferred pos for this axis.
        -- [Port] IMGUI_DEBUG_LOG_NAV("[nav] NavMoveSubmitted but not led to a result!\n")
        return
    end

    -- PageUp/PageDown behavior first jumps to the bottom/top mostly visible item, _otherwise_ use the result from the previous/next page.
    if bit32.band(g.NavMoveFlags, 32 --[[ImGuiNavMoveFlags.AlsoScoreVisibleSet]]) ~= 0
        and g.NavMoveResultLocalVisible.ID ~= 0 and g.NavMoveResultLocalVisible.ID ~= g.NavId then
        result = g.NavMoveResultLocalVisible
    end

    -- Maybe entering a flattened child from the outside? In this case solve the tie using the regular scoring rules.
    if result ~= g.NavMoveResultOther and g.NavMoveResultOther.ID ~= 0 and g.NavMoveResultOther.Window.ParentWindow == g.NavWindow then
        if g.NavMoveResultOther.DistBox < result.DistBox
            or (g.NavMoveResultOther.DistBox == result.DistBox and g.NavMoveResultOther.DistCenter < result.DistCenter) then
            result = g.NavMoveResultOther
        end
    end
    assert(g.NavWindow and result.Window)

    -- Scroll to keep newly navigated item fully into view.
    if g.NavLayer == 0 --[[ImGuiNavLayer.Main]] then
        local rect_abs = ImGui.WindowRectRelToAbs(result.Window, result.RectRel)
        ImGui.ScrollToRectEx(result.Window, rect_abs, g.NavMoveScrollFlags)

        if bit32.band(g.NavMoveFlags, 64 --[[ImGuiNavMoveFlags.ScrollToEdgeY]]) ~= 0 then
            -- FIXME: Should remove this? Or make more precise: use ScrollToRectEx() with edge?
            local scroll_target = (g.NavMoveDir == 2 --[[ImGuiDir.Up]]) and result.Window.ScrollMax.y or 0.0
            ImGui.SetScrollY(result.Window, scroll_target)
        end
    end

    if g.NavWindow ~= result.Window then
        -- [Port] IMGUI_DEBUG_LOG_FOCUS("[focus] NavMoveRequest: SetNavWindow(\"%s\")\n", result->Window->Name)
        g.NavWindow = result.Window
        g.NavLastValidSelectionUserData = (-1) --[[ImGuiSelectionUserData_Invalid]]
    end

    -- Clear active id unless requested not to
    -- FIXME: ImGuiNavMoveFlags.NoClearActiveId is currently unused as we don't have a clear strategy to preserve active id after interaction,
    -- so this is mostly provided as a gateway for further experiments (see #1418, #2890)
    if g.ActiveId ~= result.ID and bit32.band(g.NavMoveFlags, 32768 --[[ImGuiNavMoveFlags.NoClearActiveId]]) == 0 then
        ImGui.ClearActiveID()
    end

    -- Don't set NavJustMovedToId if just landed on the same spot (which may happen with ImGuiNavMoveFlags.AllowCurrentNavId)
    -- PageUp/PageDown however sets always set NavJustMovedTo (vs Home/End which doesn't) mimicking Windows behavior.
    if (g.NavId ~= result.ID or bit32.band(g.NavMoveFlags, 2048 --[[ImGuiNavMoveFlags.IsPageMove]]) ~= 0)
        and bit32.band(g.NavMoveFlags, 8192 --[[ImGuiNavMoveFlags.NoSelect]]) == 0 then
        g.NavJustMovedFromFocusScopeId = g.NavFocusScopeId
        g.NavJustMovedToId = result.ID
        g.NavJustMovedToFocusScopeId = result.FocusScopeId
        g.NavJustMovedToKeyMods = g.NavMoveKeyMods
        g.NavJustMovedToIsTabbing = bit32.band(g.NavMoveFlags, 1024 --[[ImGuiNavMoveFlags.IsTabbing]]) ~= 0
        g.NavJustMovedToIsInit = false
        g.NavJustMovedToHasSelectionData = bit32.band(result.ItemFlags, 2097152 --[[ImGuiItemFlags.HasSelectionUserData]]) ~= 0
        -- IMGUI_DEBUG_LOG_NAV("[nav] NavJustMovedFromFocusScopeId = 0x%08X, NavJustMovedToFocusScopeId = 0x%08X\n", g.NavJustMovedFromFocusScopeId, g.NavJustMovedToFocusScopeId)
    end

    -- Apply new NavID/Focus
    -- [Port] IMGUI_DEBUG_LOG_NAV("[nav] NavMoveRequest: result NavID 0x%08X in Layer %d Window \"%s\"\n", result->ID, g.NavLayer, g.NavWindow->Name)
    local root_for_nav = g.NavWindow.RootWindowForNav
    local preferred_scoring_pos_rel = ImVec2()
    ImVec2_Copy(preferred_scoring_pos_rel, root_for_nav.NavPreferredScoringPosRel[g.NavLayer])
    ImGui.SetNavID(result.ID, g.NavLayer, result.FocusScopeId, result.RectRel)
    if result.SelectionUserData ~= (-1) --[[ImGuiSelectionUserData_Invalid]] then
        g.NavLastValidSelectionUserData = result.SelectionUserData
    end

    -- Restore last preferred position for current axis
    -- (storing in RootWindowForNav-> as the info is desirable at the beginning of a Move Request. In theory all storage should use RootWindowForNav..)
    if bit32.band(g.NavMoveFlags, 1024 --[[ImGuiNavMoveFlags.IsTabbing]]) == 0 then
        preferred_scoring_pos_rel[axis] = result.RectRel:GetCenter()[axis]
        ImVec2_Copy(root_for_nav.NavPreferredScoringPosRel[g.NavLayer], preferred_scoring_pos_rel)
    end

    -- Tabbing: Activates Inputable, otherwise only Focus
    if bit32.band(g.NavMoveFlags, 1024 --[[ImGuiNavMoveFlags.IsTabbing]]) ~= 0
        and bit32.band(result.ItemFlags, 1048576 --[[ImGuiItemFlags.Inputable]]) == 0 then
        g.NavMoveFlags = bit32.band(g.NavMoveFlags, bit32.bnot(4096 --[[ImGuiNavMoveFlags.Activate]]))
    end

    -- Activate
    if bit32.band(g.NavMoveFlags, 4096 --[[ImGuiNavMoveFlags.Activate]]) ~= 0 then
        g.NavNextActivateId = result.ID
        g.NavNextActivateFlags = 0 --[[ImGuiActivateFlags.None]]
        if bit32.band(g.NavMoveFlags, 512 --[[ImGuiNavMoveFlags.FocusApi]]) ~= 0 then
            g.NavNextActivateFlags = bit32.bor(g.NavNextActivateFlags, 32 --[[ImGuiActivateFlags.FromFocusApi]])
        end
        if bit32.band(g.NavMoveFlags, 1024 --[[ImGuiNavMoveFlags.IsTabbing]]) ~= 0 then
            g.NavNextActivateFlags = bit32.bor(g.NavNextActivateFlags, 1 --[[ImGuiActivateFlags.PreferInput]], 4 --[[ImGuiActivateFlags.TryToPreserveState]], 8 --[[ImGuiActivateFlags.FromTabbing]])
        end
    end

    -- Make nav cursor visible
    if bit32.band(g.NavMoveFlags, 16384 --[[ImGuiNavMoveFlags.NoSetNavCursorVisible]]) == 0 then
        ImGui.SetNavCursorVisibleAfterMove()
    end
end

-- True when current work location may be scrolled horizontally when moving left / right.
-- This is generally always true UNLESS within a column. We don't have a vertical equivalent.
function ImGui.NavUpdateCurrentWindowIsScrollPushableX()
    local g = GImGui
    local window = g.CurrentWindow
    window.DC.NavIsScrollPushableX = (g.CurrentTable == nil and window.DC.CurrentColumns == nil)
end

-- Called by TreePop() to implement ImGuiTreeNodeFlags.NavLeftJumpsToParent
--- @param result         ImGuiNavItemData
--- @param tree_node_data ImGuiTreeNodeStackData
function ImGui.NavMoveRequestResolveWithPastTreeNode(result, tree_node_data)
    local g = GImGui
    g.NavMoveScoringItems = false
    g.LastItemData.ID = tree_node_data.ID
    g.LastItemData.ItemFlags = bit32.band(tree_node_data.ItemFlags, bit32.bnot(2097152 --[[ImGuiItemFlags.HasSelectionUserData]])) -- Losing SelectionUserData, recovered next-frame (cheaper).
    ImRect_Copy(g.LastItemData.NavRect, tree_node_data.NavRect)
    ImGui.NavApplyItemToResult(result) -- Result this instead of implementing a NavApplyPastTreeNodeToResult()
    ImGui.NavClearPreferredPosForAxis(2 --[[ImGuiAxis.Y]])
    ImGui.NavUpdateAnyRequestFlag()
end

function ImGui.NavMoveRequestCancel()
    local g = GImGui
    g.NavMoveSubmitted = false
    g.NavMoveScoringItems = false
    ImGui.NavUpdateAnyRequestFlag()
end

-- Forward will reuse the move request again on the next frame (generally with modifications done to it)
--- @param move_dir     ImGuiDir
--- @param clip_dir     ImGuiDir
--- @param move_flags   ImGuiNavMoveFlags
--- @param scroll_flags ImGuiScrollFlags
function ImGui.NavMoveRequestForward(move_dir, clip_dir, move_flags, scroll_flags)
    local g = GImGui
    assert(g.NavMoveForwardToNextFrame == false)
    ImGui.NavMoveRequestCancel()
    g.NavMoveForwardToNextFrame = true
    g.NavMoveDir = move_dir
    g.NavMoveClipDir = clip_dir
    g.NavMoveFlags = bit32.bor(move_flags, 128 --[[ImGuiNavMoveFlags.Forwarded]])
    g.NavMoveScrollFlags = scroll_flags
end

-- Navigation wrap-around logic is delayed to the end of the frame because this operation is only valid after entire
-- popup is assembled and in case of appended popups it is not clear which EndPopup() call is final.
--- @param window     ImGuiWindow
--- @param wrap_flags ImGuiNavMoveFlags
function ImGui.NavMoveRequestTryWrapping(window, wrap_flags)
    local g = GImGui
    assert(bit32.band(wrap_flags, 15 --[[ImGuiNavMoveFlags.WrapMask_]]) ~= 0 and bit32.band(wrap_flags, bit32.bnot(15 --[[ImGuiNavMoveFlags.WrapMask_]])) == 0) -- Call with _WrapX, _WrapY, _LoopX, _LoopY

    -- In theory we should test for NavMoveRequestButNoResultYet() but there's no point doing it:
    -- as NavEndFrame() will do the same test. It will end up calling NavUpdateCreateWrappingRequest().
    if g.NavWindow == window and g.NavMoveScoringItems and g.NavLayer == window.DC.NavLayerCurrent then
        g.NavMoveFlags = bit32.bor(bit32.band(g.NavMoveFlags, bit32.bnot(15 --[[ImGuiNavMoveFlags.WrapMask_]])), wrap_flags)
    end
end

