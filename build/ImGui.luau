    z.fdy = (dxdy ~= 0.0) and (1.0 / dxdy) or 0.0
    z.fx = e.x0 + dxdy * (start_point - e.y0)
    z.fx = z.fx - off_x
    z.direction = (e.invert) and 1.0 or -1.0
    z.sy = e.y0
    z.ey = e.y1
    z.next = nil

    return z
end

--- @class stbtt__bitmap
--- @field w      int
