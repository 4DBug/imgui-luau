function ImGui.VSliderScalar(label, size, data_type, data, min, max, format, flags)
    if flags == nil then flags = 0 end
    local window = ImGui.GetCurrentWindow()
    if window.SkipItems then
        return data, false
    end

    local g = GImGui
    local style = g.Style
    local id = window:GetID(label)

    local label_end = ImGui.FindRenderedTextEnd(label)
    local label_size = ImGui.CalcTextSize(label, label_end, false)
    local frame_bb = ImRect(window.DC.CursorPos, window.DC.CursorPos + size)
    local bb = ImRect(frame_bb.Min, ImVec2(frame_bb.Max.x + (label_size.x > 0.0 and (style.ItemInnerSpacing.x + label_size.x) or 0.0), frame_bb.Max.y))

    ImGui.ItemSize(bb, style.FramePadding.y)
    if not ImGui.ItemAdd(frame_bb, id) then
        return data, false
    end

    -- Default format string when passing NULL
    if format == nil then
        format = ImGui.DataTypeGetInfo(data_type).PrintFmt
    end

    local hovered = ImGui.ItemHoverable(frame_bb, id, g.LastItemData.ItemFlags)
    local clicked = hovered and ImGui.IsMouseClickedEx(0, 0 --[[ImGuiInputFlags.None]], id)
    if clicked or g.NavActivateId == id then
        if clicked then
            ImGui.SetKeyOwner(656 --[[ImGuiKey.MouseLeft]], id)
        end
        ImGui.SetActiveID(id, window)
        ImGui.SetFocusID(id, window)
        ImGui.FocusWindow(window)
        g.ActiveIdUsingNavDirMask = bit32.bor(g.ActiveIdUsingNavDirMask, bit32.lshift(1, 2 --[[ImGuiDir.Up]]), bit32.lshift(1, 3 --[[ImGuiDir.Down]]))
    end

    -- Draw frame
    local frame_col = ImGui.GetColorU32((g.ActiveId == id) and 9 --[[ImGuiCol.FrameBgActive]] or (hovered and 8 --[[ImGuiCol.FrameBgHovered]] or 7 --[[ImGuiCol.FrameBg]]))
    ImGui.RenderNavCursor(frame_bb, id)
    ImGui.RenderFrame(frame_bb.Min, frame_bb.Max, frame_col, true, g.Style.FrameRounding)

    -- Slider behavior
    local grab_bb = ImRect()
    local value_changed
    data, value_changed = ImGui.SliderBehavior(frame_bb, id, data_type, data, min, max, format, bit32.bor(flags or 0, 1048576 --[[ImGuiSliderFlags.Vertical]]), grab_bb)
    if value_changed then
        ImGui.MarkItemEdited(id)
    end

    -- Render grab
    if grab_bb.Max.y > grab_bb.Min.y then
        window.DrawList:AddRectFilled(grab_bb.Min, grab_bb.Max, ImGui.GetColorU32((g.ActiveId == id) and 21 --[[ImGuiCol.SliderGrabActive]] or 20 --[[ImGuiCol.SliderGrab]]), style.GrabRounding)
    end

    -- Display value using user-provided display format so user can add prefix/suffix/decorations to the value.
    -- For the vertical slider we allow centered text to overlap the frame padding
    local is_mixed = bit32.band(g.LastItemData.ItemFlags, 4096 --[[ImGuiItemFlags.MixedValue]]) ~= 0
    local value_buf = DataTypeFormatStringCached(data_type, data, (is_mixed and g.MixedValueLabel ~= nil) and g.MixedValueLabel or format)
