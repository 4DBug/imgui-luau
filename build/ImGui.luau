            if ImGui.BeginTable("split2", 3, bit32.bor(1 --[[ImGuiTableFlags.Resizable]], 16 --[[ImGuiTableFlags.NoSavedSettings]], 1920 --[[ImGuiTableFlags.Borders]])) then
