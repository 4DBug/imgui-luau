        TableAngledHeadersTextAlign = ImVec2(0.5, 0.0), -- Alignment of angled headers within the cell

        DragDropTargetRounding = 0.0, -- Radius of the drag and drop target frame.
        DragDropTargetBorderSize = 2.0, -- Thickness of the drag and drop target border.
        DragDropTargetPadding = 3.0, -- Size to expand the drag and drop target from actual target item size.

        HoverFlagsForTooltipMouse = bitOr(8192 --[[ImGuiHoveredFlags.Stationary]], 32768 --[[ImGuiHoveredFlags.DelayShort]], 1024 --[[ImGuiHoveredFlags.AllowWhenDisabled]]), -- Default flags when using IsItemHovered(ImGuiHoveredFlags.ForTooltip) or BeginItemTooltip()/SetItemTooltip() while using mouse.
        HoverFlagsForTooltipNav = bitOr(131072 --[[ImGuiHoveredFlags.NoSharedDelay]], 65536 --[[ImGuiHoveredFlags.DelayNormal]], 1024 --[[ImGuiHoveredFlags.AllowWhenDisabled]]), -- Default flags when using IsItemHovered(ImGuiHoveredFlags.ForTooltip) or BeginItemTooltip()/SetItemTooltip() while using keyboard/gamepad.

