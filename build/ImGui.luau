        ImGui.SameLine()
        ImGui.Text("(%d root nodes)", #root_node.Childs)
        ImGui.SetNextItemWidth(-1.1754943508223e-38 --[[FLT_MIN]])
        ImGui.SetNextItemShortcut(bit32.bor(4096 --[[ImGuiMod_Ctrl]], 551 --[[ImGuiKey.F]]), 262144 --[[ImGuiInputFlags.Tooltip]])
        if ImGui.InputTextWithHint("##Filter", "incl -excl", self.Filter.InputBuf, 256, 128 --[[ImGuiInputTextFlags.EscapeClearsAll]]) then
            self.Filter:Build()
        end
        ImGui.PopItemFlag()

        if ImGui.BeginTable("##list", 1, 64 --[[ImGuiTableFlags.RowBg]]) then
            if self.UseClipper then
                self:DrawClippedTree(root_node)
            else
                self:DrawTree(root_node)
            end
            ImGui.EndTable()
        end
    end
    ImGui.EndChild()

    -- Right side: draw properties
    ImGui.SameLine()

    ImGui.BeginGroup() -- Lock X position
    local node = self.SelectedNode
    if node then
        ImGui.Text("%s", node.Name)
        ImGui.TextDisabled("UID: 0x%08X", node.UID)
        ImGui.Separator()
        if ImGui.BeginTable("##properties", 2, bit32.bor(1 --[[ImGuiTableFlags.Resizable]], 33554432 --[[ImGuiTableFlags.ScrollY]])) then
            -- Push object ID after we entered the table, so table is shared for all objects
            ImGui.PushID(node.UID)
            ImGui.TableSetupColumn("", 16 --[[ImGuiTableColumnFlags.WidthFixed]])
            ImGui.TableSetupColumn("", 8 --[[ImGuiTableColumnFlags.WidthStretch]], 2.0) -- Default twice larger
            if node.HasData then
                -- In a typical application, the structure description would be derived from a data-driven system.
                -- - We try to mimic this with our ExampleMemberInfo structure and the ExampleTreeNodeMemberInfos[] array.
                -- - Limits and some details are hard-coded to simplify the demo.
                for _, field_desc in ipairs(ExampleTreeNodeMemberInfos) do
                    ImGui.TableNextRow()
                    ImGui.PushID(field_desc.Name)
                    ImGui.TableNextColumn()
                    ImGui.AlignTextToFramePadding()
                    ImGui.TextUnformatted(field_desc.Name)
                    ImGui.TableNextColumn()
                    local field_ptr = field_desc.Offset -- [Port] Offset is the field name inside ExampleTreeNode
                    if field_desc.DataType == 10 --[[ImGuiDataType.Bool]] then
                        assert(field_desc.DataCount == 1)
                        _, node[field_ptr] = ImGui.Checkbox("##Editor", node[field_ptr])
                    elseif field_desc.DataType == 4 --[[ImGuiDataType.S32]] then
                        local v_min, v_max = (-2147483648) --[[INT_MIN]], 2147483647 --[[INT_MAX]]
                        ImGui.SetNextItemWidth(-1.1754943508223e-38 --[[FLT_MIN]])
                        if field_desc.DataCount == 1 then -- [Port] scalar fields are plain Lua values: DragScalar() returns the new value
                            node[field_ptr] = ImGui.DragScalar("##Editor", field_desc.DataType, node[field_ptr], 1.0, v_min, v_max)
                        else
                            ImGui.DragScalarN("##Editor", field_desc.DataType, node[field_ptr], field_desc.DataCount, 1.0, v_min, v_max)
                        end
                    elseif field_desc.DataType == 8 --[[ImGuiDataType.Float]] then
                        local v_min, v_max = 0.0, 1.0
                        ImGui.SetNextItemWidth(-1.1754943508223e-38 --[[FLT_MIN]])
                        ImGui.SliderScalarN("##Editor", field_desc.DataType, node[field_ptr], field_desc.DataCount, v_min, v_max)
                    elseif field_desc.DataType == 11 --[[ImGuiDataType.String]] then
                        local buf = self.StringBufs[node] -- [Port] edit the Lua string through a 28-byte buffer
                        if buf == nil then buf = ImGui.NewTextBuffer(node[field_ptr], 28); self.StringBufs[node] = buf end
                        if ImGui.InputText("##Editor", buf, 28) then node[field_ptr] = ImGui.TextBufferToString(buf) end
                    end
