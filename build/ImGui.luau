        local s8_zero,  s8_one,  s8_fifty,  s8_min,  s8_max  = 0, 1, 50, -128, 127
        local u8_zero,  u8_one,  u8_fifty,  u8_min,  u8_max  = 0, 1, 50, 0, 255
